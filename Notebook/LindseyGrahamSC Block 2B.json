                "post_type": "post",
                "quote_count": 44,
                "quoted_status_id": null,
                "quoted_status_profile_id": null,
                "quoted_status_profile_username": null,
                "reply_count": 719,
                "retweet_count": 96,
                "source": "Twitter for iPhone",
                "text": "I am very pleased the House voted to reopen the federal government. The stage is now set for a long overdue debate on healthcare. \n\nI will oppose the extension of Obamacare subsidies that are a windfall for insurance companies. President Obama promised that premiums would go down - Obamacare premiums have increased by over 100%. I will be working with @POTUS , my Republican colleagues and hopefully some Democrats to take the billions of dollars going to insurance companies and instead give the money to consumers to buy better healthcare at a lower price.",
                "text_lang": "en",
                "text_tagged_users": null,
                "text_tagged_users_ids": null,
                "text_tags": null,
                "timestamp": 1763001651,
                "view_count": 87833
            },
            {
                "attached_links_expanded_url": null,
                "attached_links_url": null,
                "attached_medias_preview_url": null,
                "attached_medias_url": null,
