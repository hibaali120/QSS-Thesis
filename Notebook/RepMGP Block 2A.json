                "quoted_status_profile_username": null,
                "reply_count": 1,
                "retweet_count": 5,
                "source": "Twitter Web App",
                "text": "Corrections officers are core to upholding our system of laws, but they often don't receive the respect merited by their difficult work.\n\nI held a roundtable at the Lewis County Jail with officers and healthcare staff to hear what resources they need to do their jobs safely and reduce recidivism \u2013 and protecting Medicaid is an important part of making treatment possible.",
                "text_lang": "en",
                "text_tagged_users": null,
                "text_tagged_users_ids": null,
                "text_tags": null,
                "timestamp": 1747755979,
                "view_count": 5852
