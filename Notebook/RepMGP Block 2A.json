                "quoted_status_profile_username": null,
                "reply_count": 6,
                "retweet_count": 8,
                "source": "Twitter Web App",
                "text": "I refuse to defend bureaucratic inefficiency \u2013 which is why I voted against a funding bill in committee that defunds our federal auditing watchdog by half.\n\nThe Government Accountability Office claws back $92B in savings a year \u2013 and it identified $41.6B in improper Medicaid and SNAP payments in FY24.\n\nOur government needs to be aggressively rooting out waste, fraud, and abuse \u2013 not kneecapping the folks investigating it.",
                "text_lang": "en",
                "text_tagged_users": null,
