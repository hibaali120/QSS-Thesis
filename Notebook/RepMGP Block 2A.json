                "attached_videos": null,
                "author_id": "1603127874512453632",
                "author_username": "RepMGP",
                "community_notes": null,
                "conversation_id": "1940465185992622187",
                "created_time": "2025-07-02T17:38:47",
                "favorite_count": 25,
                "geo_lat": null,
                "geo_lon": null,
                "id": "1940465185992622187",
                "in_reply_to_post_id": null,
                "in_reply_to_profile_id": null,
                "in_reply_to_profile_username": null,
                "place_country_code": null,
                "place_country_name": null,
                "place_full_name": null,
                "place_type": null,
                "poll": null,
                "post_type": "post",
                "quote_count": 0,
                "quoted_status_id": null,
                "quoted_status_profile_id": null,
                "quoted_status_profile_username": null,
                "reply_count": 4,
                "retweet_count": 3,
                "source": "Twitter Web App",
                "text": "I consider it a privilege that so many communities of all sizes and types have opened their doors to me and shared candidly what their priorities are.\n\nAt the Rainier Senior Center, I heard concerns about Medicaid cuts, discussed how I can best support seniors living on fixed incomes, and shared how my team can assist with veterans and Social Security benefits.",
                "text_lang": "en",
                "text_tagged_users": null,
                "text_tagged_users_ids": null,
                "text_tags": null,
                "timestamp": 1751477927,
                "view_count": 2016
            },
            {
                "attached_links_expanded_url": null,
                "attached_links_url": null,
                "attached_medias_preview_url": [
                    "https://pbs.twimg.com/media/Gu9yJBfWkAA3EXP.jpg?name=small"
                ],
                "attached_medias_url": [
                    "https://pbs.twimg.com/media/Gu9yJBfWkAA3EXP.jpg"
