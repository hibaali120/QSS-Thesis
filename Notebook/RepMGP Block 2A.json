                "favorite_count": 25,
                "geo_lat": null,
                "geo_lon": null,
                "id": "1938618204978401698",
                "in_reply_to_post_id": null,
                "in_reply_to_profile_id": null,
                "in_reply_to_profile_username": null,
                "place_country_code": null,
                "place_country_name": null,
                "place_full_name": null,
                "place_type": null,
                "poll": null,
                "post_type": "quote",
                "quote_count": 0,
                "quoted_status_id": "1932845243180663274",
                "quoted_status_profile_id": "1603127874512453632",
                "quoted_status_profile_username": "RepMGP",
                "reply_count": 3,
                "retweet_count": 2,
                "source": "Twitter Web App",
                "text": "Great news \u2014 I voted this week with my bipartisan colleagues to pass this legislation in the House!\n\nIt includes increased veterans\u2019 healthcare funding, including care for toxic exposure and support for families.\n\nI look forward to the Senate continuing to improve this bill to ensure we get the best deal for our heroes.",
                "text_lang": "en",
                "text_tagged_users": null,
                "text_tagged_users_ids": null,
                "text_tags": null,
                "timestamp": 1751037572,
                "view_count": 3340
            },
            {
                "attached_links_expanded_url": null,
                "attached_links_url": null,
                "attached_medias_preview_url": [
                    "https://pbs.twimg.com/media/GutHIbsXgAYBBvZ.jpg?name=small"
                ],
                "attached_medias_url": [
                    "https://pbs.twimg.com/media/GutHIbsXgAYBBvZ.jpg"
                ],
                "attached_videos": null,
                "author_id": "1603127874512453632",
                "author_username": "RepMGP",
                "community_notes": null,
                "conversation_id": "1939722582153986310",
                "created_time": "2025-06-30T16:27:56",
                "favorite_count": 47,
                "geo_lat": null,
                "geo_lon": null,
                "id": "1939722582153986310",
                "in_reply_to_post_id": null,
                "in_reply_to_profile_id": null,
                "in_reply_to_profile_username": null,
                "place_country_code": null,
                "place_country_name": null,
                "place_full_name": null,
                "place_type": null,
                "poll": null,
                "post_type": "post",
                "quote_count": 0,
                "quoted_status_id": null,
                "quoted_status_profile_id": null,
                "quoted_status_profile_username": null,
                "reply_count": 11,
                "retweet_count": 8,
                "source": "Twitter Web App",
                "text": "I voted against a partisan bill that could strip more than 28,000 folks across #WA03 of their healthcare to pay for handouts to the wealthiest Americans.\n\nI recently visited @SeaMarCHC to speak with dedicated care providers at the front lines of our mental health and fentanyl crises \u2013 and I heard in the starkest terms who will suffer in our community as a result of these reckless cuts to Medicaid.",
                "text_lang": "en",
                "text_tagged_users": [
                    "SeaMarCHC"
                ],
                "text_tagged_users_ids": [
                    "1631425476"
                ],
                "text_tags": [
                    "wa03"
                ],
                "timestamp": 1751300876,
                "view_count": 2954
            },
            {
                "attached_links_expanded_url": null,
                "attached_links_url": null,
                "attached_medias_preview_url": null,
                "attached_medias_url": null,
                "attached_videos": null,
                "author_id": "1603127874512453632",
                "author_username": "RepMGP",
                "community_notes": null,
                "conversation_id": "1940193959080509470",
                "created_time": "2025-07-01T23:41:02",
                "favorite_count": 17,
                "geo_lat": null,
                "geo_lon": null,
                "id": "1940193963916312824",
                "in_reply_to_post_id": "1940193962033389981",
                "in_reply_to_profile_id": "1603127874512453632",
                "in_reply_to_profile_username": "RepMGP",
                "place_country_code": null,
                "place_country_name": null,
                "place_full_name": null,
                "place_type": null,
                "poll": null,
                "post_type": "reply",
                "quote_count": 1,
                "quoted_status_id": null,
                "quoted_status_profile_id": null,
                "quoted_status_profile_username": null,
                "reply_count": 1,
                "retweet_count": 2,
                "source": "Twitter Web App",
                "text": "It strips even more Americans of healthcare coverage, by gutting Medicaid and suffocating hardworking families with even more red tape.\n\n328,695 people in our state stand to lose healthcare, and rural hospitals across #WA03 would lose tens of millions of dollars \u2013 which could put these vital lifelines at risk for collapse.\n\nNot to mention, the bill still drives up costs for energy and healthcare premiums. \u2b07\ufe0f",
                "text_lang": "en",
                "text_tagged_users": null,
                "text_tagged_users_ids": null,
                "text_tags": [
                    "wa03"
                ],
                "timestamp": 1751413262,
                "view_count": 679
            },
            {
                "attached_links_expanded_url": null,
                "attached_links_url": null,
                "attached_medias_preview_url": [
                    "https://pbs.twimg.com/media/Gu3qy0tW0AAVngF.jpg?name=small"
                ],
                "attached_medias_url": [
                    "https://pbs.twimg.com/media/Gu3qy0tW0AAVngF.jpg"
