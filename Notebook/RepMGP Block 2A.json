                "quoted_status_profile_id": null,
                "quoted_status_profile_username": null,
                "reply_count": 18,
                "retweet_count": 9,
                "source": "Twitter for iPhone",
                "text": "One of Congress\u2019s most important responsibilities is supporting the brave men and women serving in our military.\n\nI just voted to advance a bill out of committee which:\n\n\ud83c\uddfa\ud83c\uddf8 Gives servicemembers a 3.8% raise\n\n\ud83c\uddfa\ud83c\uddf8 Includes $40B for military healthcare\n\n\ud83c\uddfa\ud83c\uddf8 Provides $1B to fight drug trafficking\n\n\ud83c\uddfa\ud83c\uddf8 Doesn\u2019t increase overall defense spending, while extending robust support for our Armed Forces",
                "text_lang": "en",
                "text_tagged_users": null,
                "text_tagged_users_ids": null,
                "text_tags": null,
                "timestamp": 1749773946,
                "view_count": 12019
            },
            {
                "attached_links_expanded_url": null,
                "attached_links_url": null,
                "attached_medias_preview_url": null,
                "attached_medias_url": null,
                "attached_videos": null,
                "author_id": "1603127874512453632",
                "author_username": "RepMGP",
                "community_notes": null,
                "conversation_id": "1938618204978401698",
