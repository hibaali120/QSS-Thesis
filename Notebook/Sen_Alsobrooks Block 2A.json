                "poll": null,
                "post_type": "quote",
                "quote_count": 1,
                "quoted_status_id": "1933215246405017846",
                "quoted_status_profile_id": "8861752",
                "quoted_status_profile_username": "baltimoresun",
                "reply_count": 8,
                "retweet_count": 119,
                "source": "Twitter Web App",
                "text": "I introduced the Medicare and Medicaid Dental, Vision, and Hearing Benefit Act.\n\nThis legislation is personal to me. 18 years ago, a young Marylander named Deamonte Driver died of complications from a tooth infection because his family was kicked off of Medicaid.",
                "text_lang": "en",
                "text_tagged_users": null,
                "text_tagged_users_ids": null,
                "text_tags": null,
                "timestamp": 1749822907,
                "view_count": 5804
            },
            {
                "attached_links_expanded_url": null,
                "attached_links_url": null,
                "attached_medias_preview_url": null,
                "attached_medias_url": null,
                "attached_videos": null,
                "author_id": "1878848847717208065",
                "author_username": "Sen_Alsobrooks",
                "community_notes": null,
                "conversation_id": "1933523530169073956",
                "created_time": "2025-06-13T13:55:08",
                "favorite_count": 14,
                "geo_lat": null,
                "geo_lon": null,
                "id": "1933523535047053653",
                "in_reply_to_post_id": "1933523532824404310",
                "in_reply_to_profile_id": "1878848847717208065",
                "in_reply_to_profile_username": "Sen_Alsobrooks",
                "place_country_code": null,
                "place_country_name": null,
                "place_full_name": null,
                "place_type": null,
