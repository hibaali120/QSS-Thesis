                "quoted_status_profile_id": null,
                "quoted_status_profile_username": null,
                "reply_count": 0,
                "retweet_count": 2,
                "source": "Twitter Web App",
                "text": "While Republicans seem hellbent on kicking as many people off their health insurance as possible, we will fight tooth and nail to expand coverage and to ensure that every American, every child in particular, has access to the care they need.",
                "text_lang": "en",
                "text_tagged_users": null,
                "text_tagged_users_ids": null,
                "text_tags": null,
                "timestamp": 1749822908,
                "view_count": 644
            },
            {
