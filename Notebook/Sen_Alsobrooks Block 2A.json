                "quoted_status_profile_username": null,
                "reply_count": 18,
                "retweet_count": 41,
                "source": "Twitter Web App",
                "text": "I'm in the sandwich generation. As I'm raising my daughter, I'm also helping care for my aging parents.\n\nThat\u2019s why I'll always fight for our seniors - like those I met in Baltimore. I won\u2019t stand for Republican cuts to Medicare. It's so callous. I will always govern with love. https://t.co/ez97hdIQvW",
                "text_lang": "en",
                "text_tagged_users": null,
                "text_tagged_users_ids": null,
