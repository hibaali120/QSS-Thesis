                "quoted_status_id": "1932009777900445784",
                "quoted_status_profile_id": "8861752",
                "quoted_status_profile_username": "baltimoresun",
                "reply_count": 61,
                "retweet_count": 34,
                "source": "Twitter Web App",
                "text": "In Western Maryland: \n\n1 in 7 adults relies on Medicaid. \n\n1 in 3 children relies on the Children\u2019s Health Insurance Program (CHIP).\n\nRepublicans want to cut these lifesaving programs to pay for billionaire tax cuts. It's disgraceful.",
                "text_lang": "en",
                "text_tagged_users": null,
                "text_tagged_users_ids": null,
                "text_tags": null,
                "timestamp": 1749489364,
                "view_count": 18676
