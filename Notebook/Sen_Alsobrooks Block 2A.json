                "attached_links_url": null,
                "attached_medias_preview_url": null,
                "attached_medias_url": null,
                "attached_videos": null,
                "author_id": "1878848847717208065",
                "author_username": "Sen_Alsobrooks",
                "community_notes": null,
                "conversation_id": "1935008062428819522",
                "created_time": "2025-06-17T16:14:07",
                "favorite_count": 401,
                "geo_lat": null,
                "geo_lon": null,
                "id": "1935008062428819522",
                "in_reply_to_post_id": null,
                "in_reply_to_profile_id": null,
                "in_reply_to_profile_username": null,
                "place_country_code": null,
                "place_country_name": null,
                "place_full_name": null,
                "place_type": null,
                "poll": null,
                "post_type": "post",
                "quote_count": 4,
                "quoted_status_id": null,
                "quoted_status_profile_id": null,
                "quoted_status_profile_username": null,
                "reply_count": 46,
                "retweet_count": 159,
                "source": "Twitter Web App",
                "text": "We all thought the House Republican bill was bad.\n\nBut now Senate Republicans want to slash Medicaid even MORE??\n\nWhy do Republicans insist on kicking Americans off their health insurance to pay for tax cuts for billionaires?\n\nIt is callous and cruel.",
                "text_lang": "en",
