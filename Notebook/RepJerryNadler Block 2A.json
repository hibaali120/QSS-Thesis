                "in_reply_to_post_id": null,
                "in_reply_to_profile_id": null,
                "in_reply_to_profile_username": null,
                "place_country_code": null,
                "place_country_name": null,
                "place_full_name": null,
                "place_type": null,
                "poll": null,
                "post_type": "quote",
                "quote_count": 1,
                "quoted_status_id": "1940126779282506101",
                "quoted_status_profile_id": "40302336",
                "quoted_status_profile_username": "RepJerryNadler",
                "reply_count": 30,
                "retweet_count": 24,
                "source": "Twitter for iPhone",
                "text": "Yesterday, a community hospital in southwest Nebraska announced it will close a clinic, citing the looming Medicaid cuts in this bill. Sadly, if it becomes law, that closure will be just the beginning.\n\nAs Dean of the New York Congressional Delegation, I am once again urging my Republican colleagues from New York to reject this bill before it devastates our state\u2019s health care system and rips coverage away from 1.5 million New Yorkers.",
                "text_lang": "en",
                "text_tagged_users": null,
                "text_tagged_users_ids": null,
                "text_tags": null,
                "timestamp": 1751561504,
                "view_count": 6220
            },
            {
                "attached_links_expanded_url": null,
                "attached_links_url": null,
                "attached_medias_preview_url": null,
                "attached_medias_url": null,
                "attached_videos": null,
                "author_id": "40302336",
