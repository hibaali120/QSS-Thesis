                "quoted_status_profile_username": "PeterSullivan4",
                "reply_count": 22,
                "retweet_count": 31,
                "source": "Twitter for iPhone",
                "text": "Let\u2019s be honest: Once this bill passes, Republicans are not going to reverse or delay these cruel Medicaid cuts. \n\nIf you have a chance to protect your constituents from losing their health care coverage, the time to act is now.",
                "text_lang": "en",
                "text_tagged_users": null,
                "text_tagged_users_ids": null,
                "text_tags": null,
                "timestamp": 1751481239,
                "view_count": 6062
