                "post_type": "post",
                "quote_count": 1,
                "quoted_status_id": null,
                "quoted_status_profile_id": null,
                "quoted_status_profile_username": null,
                "reply_count": 6,
                "retweet_count": 5,
                "source": "Twitter for iPhone",
                "text": "On the 60th Anniversary of Medicare and Medicaid, I\u2019m thinking of the millions of Americans whose health care is being taken away because Republicans wanted tax cuts for the ultra-wealthy.\n\nRepublicans betrayed the American people when they passed the Big, Ugly Bill. I will not stop fighting until we repeal this reckless law, protect our hospitals, and ensure every American can get the care they need.",
                "text_lang": "en",
                "text_tagged_users": null,
                "text_tagged_users_ids": null,
                "text_tags": null,
                "timestamp": 1753905452,
                "view_count": 2039
            },
