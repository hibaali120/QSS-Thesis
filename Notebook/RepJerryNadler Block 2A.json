                "place_type": null,
                "poll": null,
                "post_type": "quote",
                "quote_count": 1,
                "quoted_status_id": "1940018306485748067",
                "quoted_status_profile_id": "1542228578",
                "quoted_status_profile_username": "JDVance",
                "reply_count": 71,
                "retweet_count": 147,
                "source": "Twitter for iPhone",
                "text": "First, Vice President Vance heartlessly called kicking millions of Americans off their health care \u201cimmaterial.\u201d Now he\u2019s blatantly lying to the American people.\n\nFederal law bars undocumented immigrants from receiving full or partial Medicaid benefits. The only way they can get benefits is if a state creates its own program and pays for it entirely with state funds.\n\nOnly 29% of Americans support this cruel bill. The public has completely rejected it, and no amount of lies will change that.",
                "text_lang": "en",
                "text_tagged_users": null,
                "text_tagged_users_ids": null,
                "text_tags": null,
                "timestamp": 1751378669,
                "view_count": 15660
            },
            {
