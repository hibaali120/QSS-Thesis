                "poll": null,
                "post_type": "quote",
                "quote_count": 15,
                "quoted_status_id": "1939017407672045606",
                "quoted_status_profile_id": "19847765",
                "quoted_status_profile_username": "sahilkapur",
                "reply_count": 85,
                "retweet_count": 384,
                "source": "Twitter for iPhone",
                "text": "Senator Hawley just admitted that Trump\u2019s dangerous bill will \u201ctake away healthcare from working people.\u201d And he\u2019s right: millions of working Americans stand to lose their coverage, all to hand out another tax break to billionaires.\n\nBut here\u2019s the truth, @HawleyMO: if you actually wanted to protect working families, you\u2019d vote no. Anything less is just empty talk.",
                "text_lang": "en",
                "text_tagged_users": [
                    "HawleyMO"
                ],
                "text_tagged_users_ids": [
                    "2352629311"
                ],
                "text_tags": null,
                "timestamp": 1751134681,
                "view_count": 25063
