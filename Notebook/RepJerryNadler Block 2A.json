                "place_type": null,
                "poll": null,
                "post_type": "quote",
                "quote_count": 3,
                "quoted_status_id": "1945171783222456766",
                "quoted_status_profile_id": "19847765",
                "quoted_status_profile_username": "sahilkapur",
                "reply_count": 14,
                "retweet_count": 90,
                "source": "Twitter for iPhone",
                "text": "A Republican Senator just introduced a bill to repeal parts of the reconciliation package he voted for two weeks ago\u2014and, with zero shame, named it the Protect Medicaid and Rural Hospitals Act.\n\nDespite their lies, Republicans knew exactly what they were doing when they voted to slash $1 trillion from Medicaid. They knew it would strip coverage from millions and devastate hospitals, nursing homes, and community health centers.\n\nSorry, @SenHawleyPress\u2014the time to act was two weeks ago, when you rubber-stamped this cruelty into law.",
                "text_lang": "en",
                "text_tagged_users": null,
                "text_tagged_users_ids": null,
                "text_tags": null,
                "timestamp": 1752605819,
                "view_count": 8359
            },
            {
