                "favorite_count": 105,
                "geo_lat": null,
                "geo_lon": null,
                "id": "1938338908321853455",
                "in_reply_to_post_id": null,
                "in_reply_to_profile_id": null,
                "in_reply_to_profile_username": null,
                "place_country_code": null,
                "place_country_name": null,
                "place_full_name": null,
                "place_type": null,
                "poll": null,
                "post_type": "quote",
                "quote_count": 6,
                "quoted_status_id": "1938290650346062261",
                "quoted_status_profile_id": "23648179",
                "quoted_status_profile_username": "NCJW",
                "reply_count": 209,
                "retweet_count": 52,
                "source": "Twitter Web App",
                "text": "This morning, the Supreme Court ruled that Medicaid patients cannot sue to see their qualified provider of choice, even though Congress guaranteed that right nearly 60 years ago.\n\nLet\u2019s be clear: this is an attack on reproductive freedom. 6 Supreme Court Justices, half of whom were appointed by Donald Trump, are attempting to dismantle Planned Parenthood from the bench, just as congressional Republicans are attempting to defund it through legislation.\n\nThis decision will harm millions of patients who rely on Planned Parenthood for routine care. Medicaid helps low-income Americans pay for cancer screenings, STI testing, and wellness exams.\n\nEveryone should have the freedom to decide who provides their medical care.",
                "text_lang": "en",
                "text_tagged_users": null,
                "text_tagged_users_ids": null,
                "text_tags": null,
                "timestamp": 1750970982,
                "view_count": 16831
            },
            {
                "attached_links_expanded_url": null,
