                "quoted_status_profile_username": null,
                "reply_count": 4,
                "retweet_count": 4,
                "source": "Twitter Web Client",
                "text": "As we celebrate this 60-year milestone of Medicare and Medicaid, let's renew our promise: Medicare and Medicaid are not relics of the past\u2014they are essential lifelines we rely on today.\n\nI remain dedicated to protecting and strengthening access to affordable healthcare for every American\u2014no matter your age or income.",
                "text_lang": "en",
