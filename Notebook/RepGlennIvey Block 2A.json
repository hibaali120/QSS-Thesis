                "reply_count": 3,
                "retweet_count": 6,
                "source": "Twitter Web Client",
                "text": "We are working with our state and local partners to counteract these Medicare Cuts on the 60th Anniversary of this life saving program.  We held a town hall in Greenbelt, Maryland with Delegate Ashanti Martinez and healthcare providers to discuss:\nH.R. 1, Republican's Big Ugly Bill:\n\u2022 331,000 Marylanders will be affected by cuts to Medicaid\n\u2022 175,000 Marylanders will lose health care\n\u2022 60,000 legal migrants in Maryland will lose health care\n\u2022 350 DACA recipients will lose health care\n\u2022 The state of Maryland will lose $2.7 billion in federal funding annually.",
                "text_lang": "en",
                "text_tagged_users": null,
                "text_tagged_users_ids": null,
                "text_tags": null,
                "timestamp": 1753912801,
                "view_count": 449
            },
