                "quoted_status_profile_username": null,
                "reply_count": 3,
                "retweet_count": 2,
                "source": "Twitter Web App",
                "text": "Republicans are waging the biggest attack on healthcare in our nation\u2019s history. In Maryland alone, over 247,000 people with ACA coverage will see their premiums jump by an average of 17% if subsidies expire.\nAt a time when costs are already crushing households, this is unacceptable. \n\nRepublicans in Congress must extend these life-saving tax credits now\u2014or own the healthcare crisis they\u2019re creating.",
                "text_lang": "en",
                "text_tagged_users": null,
