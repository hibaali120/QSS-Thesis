                "quoted_status_profile_username": null,
                "reply_count": 2,
                "retweet_count": 3,
                "source": "Twitter Web App",
                "text": "The nursing workforce shortage is at a critical point and must be addressed immediately. That\u2019s why I introduced an amendment today to increase funding for the Health Workforce Account by $10 million in the Labor, Health and Human Services, Education, and Related Agencies Appropriation bill. My amendment, which is completely paid for by off-sets, will provide additional funding for Nurse Corps Programs. By expanding scholarship and loan repayment opportunities for nurses working in facilities facing shortages, we can help increase the number of health care providers in underserved communities, particularly in rural America. I am happy my amendment passed unanimously in the House and that it will be included in the final version of the bill.",
                "text_lang": "en",
                "text_tagged_users": null,
                "text_tagged_users_ids": null,
                "text_tags": null,
                "timestamp": 1699989504,
                "view_count": 553
