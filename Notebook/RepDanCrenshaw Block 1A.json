                "quoted_status_profile_username": "RapidResponse47",
                "reply_count": 9,
                "retweet_count": 3,
                "source": "Twitter Web App",
                "text": "The One Big Beautiful Bill includes many great policies to expand access to Health Savings Accounts so that patients can save for their health care needs.\n\nNotably, it includes a policy I have been fighting for since I came to Congress in 2019 \u2014 allowing HSA dollars to go towards direct primary care. This is a common sense policy that gives Americans access to great primary care for an affordable monthly fee. It\u2019s basically Netflix for primary care, and it\u2019s poised to help solve our primary care access problem.",
                "text_lang": "en",
                "text_tagged_users": null,
                "text_tagged_users_ids": null,
                "text_tags": null,
                "timestamp": 1749482898,
                "view_count": 21764
