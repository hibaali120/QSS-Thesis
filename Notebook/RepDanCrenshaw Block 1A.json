                "quoted_status_profile_username": null,
                "reply_count": 1,
                "retweet_count": 0,
                "source": "Twitter Web App",
                "text": "Also, let\u2019s stop pretending that losing coverage equals certain death. That\u2019s absurd. A gold-standard Medicaid study found no measurable health gains in the short term from gaining coverage. The Yale-Penn letter ignores that reality completely.\n\nhttps://t.co/fMypdZCnrr",
                "text_lang": "en",
                "text_tagged_users": null,
