                "quoted_status_profile_username": null,
                "reply_count": 85,
                "retweet_count": 5,
                "source": "Twitter Web App",
                "text": "Millions of Americans\u2014like my constituent Siena\u2014are already facing a cost of living crisis. They can't afford to have their health insurance premiums increase 300% like Siena\u2019s did, on top of soaring prices for basic necessities.\n\nCongress must act to extend the ACA tax credits. https://t.co/dudPfIVYCz",
                "text_lang": "en",
                "text_tagged_users": null,
                "text_tagged_users_ids": null,
                "text_tags": null,
                "timestamp": 1762448129,
                "view_count": 3603
