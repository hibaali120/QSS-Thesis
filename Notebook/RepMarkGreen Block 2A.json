                "quote_count": 0,
                "quoted_status_id": null,
                "quoted_status_profile_id": null,
                "quoted_status_profile_username": null,
                "reply_count": 6,
                "retweet_count": 3,
                "source": "Twitter Web Client",
                "text": "As a survivor of colorectal and thyroid cancer, and as co-chair of the Colorectal Cancer Caucus in the House, I find it inexcusable that millions of Americans, thousands of whom live in my home state, will not have adequate access to quality healthcare. Read more in my op-ed below: \n\nhttps://t.co/axDHcWL3Jo",
                "text_lang": "en",
                "text_tagged_users": null,
                "text_tagged_users_ids": null,
                "text_tags": null,
                "timestamp": 1743768002,
                "view_count": 986
