                "retweet_count": 5,
                "source": "Twitter Web App",
                "text": "My Reducing Medically Unnecessary Delays in Care Act would reform the practice of prior authorization in Medicare and Medicare Advantage by requiring that board-certified physicians in the same specialty are the ones making these important decisions. Here\u2019s what they\u2019re saying\u2026\n\nThank you to @AmerMedicalAssn, @ACPIMPhysicians, @AOIA_AOA, @ACOFP, and @infusioncenter!\n\nhttps://t.co/ZhgWR2BES1",
                "text_lang": "en",
                "text_tagged_users": null,
                "text_tagged_users_ids": null,
                "text_tags": null,
                "timestamp": 1743178935,
                "view_count": 1174
