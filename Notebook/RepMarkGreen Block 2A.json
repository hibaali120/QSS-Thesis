            {
                "attached_links_expanded_url": [
                    "https://markgreen.house.gov/press-releases?id=70098D48-FA8C-49F2-B6F8-85F8E60704ED"
                ],
                "attached_links_url": [
                    "https://t.co/Qz5FNhL1yT"
                ],
                "attached_medias_preview_url": null,
                "attached_medias_url": null,
                "attached_videos": null,
                "author_id": "1080477288955826176",
                "author_username": "RepMarkGreen",
                "community_notes": null,
                "conversation_id": "1907402644701749730",
                "created_time": "2025-04-02T12:00:02",
                "favorite_count": 75,
                "geo_lat": null,
                "geo_lon": null,
                "id": "1907402644701749730",
                "in_reply_to_post_id": null,
                "in_reply_to_profile_id": null,
                "in_reply_to_profile_username": null,
                "place_country_code": null,
                "place_country_name": null,
                "place_full_name": null,
                "place_type": null,
                "poll": null,
                "post_type": "post",
                "quote_count": 0,
                "quoted_status_id": null,
                "quoted_status_profile_id": null,
                "quoted_status_profile_username": null,
                "reply_count": 9,
                "retweet_count": 21,
                "source": "Twitter Web Client",
                "text": "For me, this is personal. I was diagnosed with colon cancer in 2015. After a colonoscopy, my diagnosis was confirmed thanks to the swift action of my doctor. That procedure paved the way for my treatment. If insurance companies are going to hold these procedures hostage, I am concerned others won\u2019t be so fortunate. Read more about how my bill will get rid of the bureaucratic red tape and put physicians first.\n\nhttps://t.co/Qz5FNhL1yT",
                "text_lang": "en",
                "text_tagged_users": null,
                "text_tagged_users_ids": null,
                "text_tags": null,
                "timestamp": 1743595202,
                "view_count": 1804
            },
