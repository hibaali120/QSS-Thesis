                "quoted_status_profile_username": null,
                "reply_count": 10,
                "retweet_count": 3,
                "source": "Twitter Web App",
                "text": "I believe that if an insurance company is telling a physician that they can\u2019t consider several solutions to a patient\u2019s problem, that is a medical decision. Meanwhile an AI algorithm or someone looking at a sheet of paper at an insurance company is making these decisions. That\u2019s just wrong. More with @DanMandisShow this morning:",
                "text_lang": "en",
                "text_tagged_users": null,
                "text_tagged_users_ids": null,
