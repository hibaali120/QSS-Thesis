                "quoted_status_profile_username": "thehill",
                "reply_count": 7,
                "retweet_count": 2,
                "source": "Twitter Web App",
                "text": "True peer-to-peer deliberations will help to reduce stress and frustration in the prior authorization process\u2014and that\u2019s why I\u2019m introducing the Medically Unnecessary Delays in Care Act of 2025.\n\nThis bill will smooth the way for Medicare and Medicare Advantage recipients to get the healthcare they need.\n\nRead more about the bill I led alongside @RepGregMurphy and @RepKimSchrier from @AshleighFields_ at @theHill.\n\n@RepJohnJoyce, @RepMcCormick, \u200b\u200b@RepAndyHarrisMD, @timburchett, @RepBrianBabin, @RepMMM, @RepMikeKennedy",
                "text_lang": "en",
                "text_tagged_users": null,
                "text_tagged_users_ids": null,
                "text_tags": null,
