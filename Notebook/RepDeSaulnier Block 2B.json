                "quoted_status_profile_username": null,
                "reply_count": 2,
                "retweet_count": 0,
                "source": "Twitter Web App",
                "text": "President Trump is threatening to fire thousands of federal workers around the nation if Democrats won\u2019t go along with Republicans\u2019 funding bill that decimates the health care coverage of millions. House Democrats stand with working Americans AND the ability of every person to get affordable, quality care. With Republicans in charge of the White House, Senate, and House, the American people know who will bear responsibility for a government shutdown.\nhttps://t.co/JNcQe8PMiN",
                "text_lang": "en",
                "text_tagged_users": null,
                "text_tagged_users_ids": null,
