                "place_type": null,
                "poll": null,
                "post_type": "post",
                "quote_count": 0,
                "quoted_status_id": null,
                "quoted_status_profile_id": null,
                "quoted_status_profile_username": null,
                "reply_count": 2,
                "retweet_count": 1,
                "source": "Twitter Web App",
                "text": "With millions of Americans poised to lose health care coverage as ACA subsidies expire and with steep hikes in health insurance premiums imminent for nearly all Americans, House Republicans chose to ram through a short-term funding bill that does nothing to address these looming dual health crises that will result in costs going up and quality of care going down. Congressional Republicans\u2019 refusal to work with Democrats on reasonable, commonsense solutions to keep the government open and protect health care is yet another example of putting their partisan allegiance to President Trump over the needs of the American people. I was proud to vote against this betrayal.",
                "text_lang": "en",
                "text_tagged_users": null,
                "text_tagged_users_ids": null,
                "text_tags": null,
                "timestamp": 1758300265,
                "view_count": 303
            },
