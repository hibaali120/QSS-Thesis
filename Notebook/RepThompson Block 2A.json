                "quoted_status_profile_username": null,
                "reply_count": 6,
                "retweet_count": 2,
                "source": "Buffer",
                "text": "Middle-class families across California are being priced out of the care they need. One family in our district is now facing an $800 monthly increase in their health insurance premium \u2014 forcing them to choose between paying bills and keeping their family covered. No hardworking family should ever have to make that choice.",
                "text_lang": "en",
                "text_tagged_users": null,
