                "quoted_status_profile_username": null,
                "reply_count": 7,
                "retweet_count": 4,
                "source": "Buffer",
                "text": "Californians are getting notices from their insurers that their healthcare premiums are set to double and even triple due to the expiration of healthcare tax credits. We\u2019re watching a trainwreck and Republican leadership is doing nothing about it. Speaker Johnson, bring back the House so we can do our job.",
                "text_lang": "en",
                "text_tagged_users": null,
