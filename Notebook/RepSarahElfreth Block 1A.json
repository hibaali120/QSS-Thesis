                "quoted_status_profile_username": null,
                "reply_count": 10,
                "retweet_count": 1,
                "source": "Twitter for iPhone",
                "text": "With the holidays around the corner, Americans are feeling the effects of the Administration\u2019s reckless economic policies, which are driving up the cost of groceries, utilities, health care, housing, and more. Hardworking Americans deserve more than to just get by, they should be able to get ahead. It\u2019s time for Congress to come together and work towards passing legislation \u2013 like the extension of the ACA tax credits \u2013 to actually address the affordability crisis too many of our neighbors are experiencing.\n\nhttps://t.co/2EZqGnfaLg",
                "text_lang": "en",
                "text_tagged_users": null,
                "text_tagged_users_ids": null,
                "text_tags": null,
