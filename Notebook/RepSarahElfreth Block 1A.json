                "quoted_status_profile_username": null,
                "reply_count": 1,
                "retweet_count": 0,
                "source": "Twitter for iPhone",
                "text": "Some good news: President Trump\u2019s unlawful reductions in force during the government shutdown have officially been reversed. This means more than 3,600 federal employees \u2013 serving in agencies from the Department of Health and Human Services to Homeland Security and the IRS \u2013 can continue providing crucial services to the American people. But the fight is not over yet. With more than 45,000 federal workers in #MD03, I\u2019m committed to ensuring all those summarily fired by DOGE or harmed by this Administration get the protections they deserve.\n\nhttps://t.co/4k9SxC4m5B",
                "text_lang": "en",
                "text_tagged_users": null,
                "text_tagged_users_ids": null,
                "text_tags": null,
                "timestamp": 1764097484,
                "view_count": 183
            },
