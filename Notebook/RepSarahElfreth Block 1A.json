                "quoted_status_profile_username": null,
                "reply_count": 2,
                "retweet_count": 2,
                "source": "Twitter for iPhone",
                "text": "Make no mistake, the fight for your health care is not over. While Senate Republicans made a handshake deal to vote on extending the ACA tax credits, Speaker Johnson has made no such agreement in the House. That\u2019s why I signed onto a discharge petition to bring this vote to the House so that millions of Americans won't see their premiums skyrocket on January 1st.\n\nhttps://t.co/KJh0HN19AC",
                "text_lang": "en",
                "text_tagged_users": null,
                "text_tagged_users_ids": null,
                "text_tags": null,
