                "reply_count": 23,
                "retweet_count": 3,
                "source": "Twitter Web App",
                "text": "This week, I met with Biden Administration officials on the failed implementation of the No Surprises Act, violating the law as written by Congress and signed by President Trump.\n\nIt's vital we protect patients from unexpected medical bills and ensure that Agency officials implement the law as Congress intended. Thank you @RepJasonSmith for hosting the roundtable on this important issue.",
                "text_lang": "en",
                "text_tagged_users": null,
                "text_tagged_users_ids": null,
                "text_tags": null,
