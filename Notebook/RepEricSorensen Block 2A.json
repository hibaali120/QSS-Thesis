                "quoted_status_profile_username": null,
                "reply_count": 10,
                "retweet_count": 4,
                "source": "Twitter Web App",
                "text": "The Senate passed the worst legislation for working families in a generation.\n\n\ud83c\udfe5Kicking 17 MILLION Americans off their health insurance\n\ud83e\udd6bTaking $300 BILLION worth of food from hungry people\n\ud83d\udcb0Jacking up the debt by $4 TRILLION\n\nWhy? \u2192 Trillion dollar tax breaks for the rich.\n\nRight now, I\u2019m on the plane to Washington to vote HELL NO when this bill gets to the House. I\u2019m doing everything I can to protect every one of our neighbors.",
                "text_lang": "en",
                "text_tagged_users": null,
                "text_tagged_users_ids": null,
                "text_tags": null,
