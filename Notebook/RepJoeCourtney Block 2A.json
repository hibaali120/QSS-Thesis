                "quoted_status_profile_id": null,
                "quoted_status_profile_username": null,
                "reply_count": 7,
                "retweet_count": 5,
                "source": "Twitter Web App",
                "text": "Medicaid and Medicare turn 60 years old today, when Lyndon Johnson and Congress dramatically expanded health care access for seniors and patients in need. President Trump promised to \"love and cherish\" these programs. However, those words ring hollow after he signed into law the largest Medicaid cut in U.S. history in a bill that will also trigger Medicare cuts by $500 billion. It will eliminate coverage for over 10 million Americans and put hospitals\u2019 finances at serious risk. It is a violation of the promise that was made 60 years ago that I will fight to restore.",
                "text_lang": "en",
                "text_tagged_users": null,
                "text_tagged_users_ids": null,
                "text_tags": null,
                "timestamp": 1753896796,
                "view_count": 519
            },
