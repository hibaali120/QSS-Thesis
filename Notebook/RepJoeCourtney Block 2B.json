                "quoted_status_profile_id": null,
                "quoted_status_profile_username": null,
                "reply_count": 11,
                "retweet_count": 5,
                "source": "Twitter Web App",
                "text": "The Senate just passed a 900-page megabill that will kick millions off their health care and force the hospitals we all rely on to close. \n\nAll to pay for a permanent tax break for the top 1% AND still blow up the deficit by TRILLIONS. \n\nThe fight now moves to the House to stop this bill. I will join the vast majority of Americans who detest this measure and vote NO.",
                "text_lang": "en",
                "text_tagged_users": null,
                "text_tagged_users_ids": null,
                "text_tags": null,
                "timestamp": 1751388583,
                "view_count": 937
            },
