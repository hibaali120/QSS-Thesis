                "quoted_status_profile_username": null,
                "reply_count": 2,
                "retweet_count": 3,
                "source": "Twitter Web App",
                "text": "Big crowd at the Colchester Senior Center to observe the 90th anniversary of Social Security. We also discussed the real-life consequences of President Trump\u2019s Medicaid and Medicare cuts in the \u201cBig Beautiful Bill\u201d for hospitals and patients.\n\nThere was strong agreement that Congress should protect Social Security from huge staff cuts at the Social Security Administration. These are bedrock programs that all Americans care about and rely on. Indiscriminately cutting them is a broken promise to Americans.",
                "text_lang": "en",
                "text_tagged_users": null,
                "text_tagged_users_ids": null,
                "text_tags": null,
                "timestamp": 1754924204,
                "view_count": 524
            },
