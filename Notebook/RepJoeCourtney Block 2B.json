                "quoted_status_profile_username": null,
                "reply_count": 3,
                "retweet_count": 3,
                "source": "Twitter Web App",
                "text": "The health care cuts in the \"Big Beautiful Bill\" are so massive that hospitals across Connecticut will be forced to scale back services for all patients.\n\nI heard that from L+M Hospital in New London on the shoreline and now from Johnson Memorial Hospital in Stafford near the Massachusetts border. The story is the same \u2013 tens of thousands will lose their health coverage and we all will pay. This is the wrong direction for our country. We have to stop this bill.",
                "text_lang": "en",
                "text_tagged_users": null,
                "text_tagged_users_ids": null,
                "text_tags": null,
                "timestamp": 1751373339,
                "view_count": 720
            },
