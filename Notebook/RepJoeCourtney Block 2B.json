                "quoted_status_profile_id": null,
                "quoted_status_profile_username": null,
                "reply_count": 5,
                "retweet_count": 3,
                "source": "Twitter Web App",
                "text": "President Trump promised to \u201clove and cherish\u201d Medicaid. Well, he just signed into law the largest Medicaid cut in U.S. history \u2013 nearly $1 trillion. \n\nNot a lot of \"love\" for hospitals, seniors, and kids who will take the hit with loss of coverage. https://t.co/VH8Y9aMKjE",
                "text_lang": "en",
                "text_tagged_users": null,
                "text_tagged_users_ids": null,
                "text_tags": null,
                "timestamp": 1752862540,
                "view_count": 490
            },
            {
                "attached_links_expanded_url": null,
                "attached_links_url": null,
                "attached_medias_preview_url": [
                    "https://pbs.twimg.com/media/GxH2DJ6XEAEH_he.jpg?name=small"
