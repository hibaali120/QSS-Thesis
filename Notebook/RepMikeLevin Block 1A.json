                "in_reply_to_post_id": null,
                "in_reply_to_profile_id": null,
                "in_reply_to_profile_username": null,
                "place_country_code": null,
                "place_country_name": null,
                "place_full_name": null,
                "place_type": null,
                "poll": null,
                "post_type": "post",
                "quote_count": 4,
                "quoted_status_id": null,
                "quoted_status_profile_id": null,
                "quoted_status_profile_username": null,
                "reply_count": 47,
                "retweet_count": 11,
                "source": "Twitter for iPhone",
                "text": "The Administration is once again hurting our veterans who get care at the VA. After getting rid of 30,000 positions this year, they\u2019re intentionally leaving 35,000 more health care jobs \u2013 including doctors and nurses \u2013 unfilled. That\u2019s 65,000 fewer people who are meant to be caring for our vets.\n\u00a0\nIn San Diego alone, they\u2019re eliminating 322 positions for doctors, nurses, and other staff that need to be hired. That includes DOZENS of positions in the mental health section. This is all while up to 24 veterans take their own lives each day. We need more mental health professionals for our vets, not fewer.\n\u00a0\nEveryone knows our country faces a crisis-level shortage of health care workers. Instead of solving it, the Trump VA has decided vets won\u2019t be getting the care they\u2019ve earned. It\u2019s a travesty and I\u2019ll be fighting this decision.\n\nhttps://t.co/wQ9vjU9sPj",
                "text_lang": "en",
                "text_tagged_users": null,
                "text_tagged_users_ids": null,
                "text_tags": null,
                "timestamp": 1765639624,
                "view_count": 1576
