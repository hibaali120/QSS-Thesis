                "place_type": null,
                "poll": null,
                "post_type": "post",
                "quote_count": 5,
                "quoted_status_id": null,
                "quoted_status_profile_id": null,
                "quoted_status_profile_username": null,
                "reply_count": 71,
                "retweet_count": 11,
                "source": "Twitter Web App",
                "text": "I want to thank the Republicans who stepped up and signed our discharge petition to extend Affordable Care Act tax credits for three more years.\n\nFor months, we\u2019ve tried to work across party lines to craft a responsible, bipartisan solution to address the looming health care crisis. Mike Johnson has completely refused, having blocked every compromise.\n\nLet\u2019s be clear about the stakes. If these tax credits expire, millions of Americans will see their premiums spike, and many will lose coverage altogether.\n\nJohnson has lost control of the House, but the House has not lost its responsibility. We will move this bipartisan extension without him. We will pass it in the House and send it to the Senate, where we must demand that they pass it to protect people\u2019s healthcare. Americans should not lose their insurance because of partisan obstruction.",
                "text_lang": "en",
                "text_tagged_users": null,
                "text_tagged_users_ids": null,
                "text_tags": null,
                "timestamp": 1765984975,
                "view_count": 1674
