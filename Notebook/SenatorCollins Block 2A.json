                "quoted_status_profile_username": null,
                "reply_count": 31,
                "retweet_count": 6,
                "source": "Twitter for iPhone",
                "text": "The Medicaid program has been an important health care safety net for nearly 60 years that has helped people in difficult financial circumstances, including people with disabilities, children, seniors, and low-income families. Approximately 400,000 Mainers \u2013 nearly a third of the state's population \u2013 depend on this program.",
                "text_lang": "en",
                "text_tagged_users": null,
                "text_tagged_users_ids": null,
                "text_tags": null,
                "timestamp": 1751386988,
                "view_count": 5862
            },
