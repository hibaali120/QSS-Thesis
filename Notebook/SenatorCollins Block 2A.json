                "quoted_status_profile_username": null,
                "reply_count": 119,
                "retweet_count": 12,
                "source": "Twitter for iPhone",
                "text": "While Labor Day marks the end of summer for many and an opportunity to get together with family and friends, let us not forget those who are working hard on this holiday: our healthcare providers and others keeping our hospitals open, our hospitality workers staffing our restaurants and hotels, our public safety officials keeping us safe, the employees in our grocery stores and those responsible for transporting vacationers, among many others. We salute all who work hard on this holiday and throughout the year.",
                "text_lang": "en",
                "text_tagged_users": null,
