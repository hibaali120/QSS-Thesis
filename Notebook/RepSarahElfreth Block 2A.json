                "quote_count": 1,
                "quoted_status_id": null,
                "quoted_status_profile_id": null,
                "quoted_status_profile_username": null,
                "reply_count": 7,
                "retweet_count": 1,
                "source": "Twitter for iPhone",
                "text": "The attacks on fundamental rights and health care in the President\u2019s so-called \u201cBig Beautiful Bill\u201d can\u2019t be overstated. In addition to slashing Medicaid funding broadly, the Senate\u2019s bill includes language to block Planned Parenthood from receiving Medicaid funding, which would be devastating to hundreds of clincis across the nation. After the attack on Planned Parenthood by the Supreme Court last week, it\u2019s more crucial now than ever to stand up to abortion access and quality health care \u2013 I will be voting no.",
                "text_lang": "en",
                "text_tagged_users": null,
