                "quoted_status_profile_username": null,
                "reply_count": 5,
                "retweet_count": 0,
                "source": "Twitter for iPhone",
                "text": "60 years ago today, President Johnson signed the Social Security Amendments of 1965, establishing Medicaid and Medicare. When these health care programs were first established, they had overwhelming bipartisan support to provide health care for our most vulnerable Americans \u2014 including millions of children and seniors. Now, through President Trump\u2019s Big Ugly Law, Republicans are ripping away this critical health coverage.",
                "text_lang": "en",
                "text_tagged_users": null,
                "text_tagged_users_ids": null,
                "text_tags": null,
                "timestamp": 1753898387,
                "view_count": 347
            },
            {
