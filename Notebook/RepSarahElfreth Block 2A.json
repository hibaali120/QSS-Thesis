                "quoted_status_profile_username": null,
                "reply_count": 8,
                "retweet_count": 0,
                "source": "Twitter for iPhone",
                "text": "Last week, House Republicans voted to kick 17 million people off their health care \u2013 including seniors with diabetes, Americans with pre-existing conditions, and millions of children. These cuts to Medicaid also directly threaten the care that our nation\u2019s rural hospitals provide. We will not stand by as Republicans strip away health care. The fight for quality, affordable care across the\u00a0 country continues.",
                "text_lang": "en",
                "text_tagged_users": null,
                "text_tagged_users_ids": null,
                "text_tags": null,
                "timestamp": 1752179767,
                "view_count": 267
