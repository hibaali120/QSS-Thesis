                "quote_count": 0,
                "quoted_status_id": null,
                "quoted_status_profile_id": null,
                "quoted_status_profile_username": null,
                "reply_count": 1,
                "retweet_count": 2,
                "source": "Twitter for iPhone",
                "text": "By far one of the most damaging outcomes of President Trump\u2019s Big, Ugly Law was blocking Medicaid funding for Planned Parenthood. Planned Parenthood provides more than just reproductive resources; they provide lifesaving cancer screenings, STI testing, and are often some of the only health care Americans in medically underserved communities receive in a year. But now, nearly 200 facilities are at risk of closure. I\u2019ve joined more than 130 of my colleagues across the House and Senate to introduce legislation to repeal these provisions that would threaten access to lifesaving resources for millions across the country.",
                "text_lang": "en",
                "text_tagged_users": null,
                "text_tagged_users_ids": null,
                "text_tags": null,
                "timestamp": 1755266240,
                "view_count": 311
