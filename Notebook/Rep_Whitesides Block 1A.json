                "quoted_status_profile_username": null,
                "reply_count": 1,
                "retweet_count": 0,
                "source": "Twitter for iPhone",
                "text": "\ud83e\uddf5Medicare open enrollment begins today in California and health insurance costs have already gone up.\n\nHere\u2019s how the expiration of ACA tax credits and the widespread attacks on affordable health care are affecting people across our district:",
                "text_lang": "en",
                "text_tagged_users": null,
                "text_tagged_users_ids": null,
                "text_tags": null,
                "timestamp": 1760576392,
                "view_count": 175
            },
            {
                "attached_links_expanded_url": null,
                "attached_links_url": null,
                "attached_medias_preview_url": null,
                "attached_medias_url": null,
                "attached_videos": null,
                "author_id": "1872709283634397185",
