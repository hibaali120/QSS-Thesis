                "quoted_status_profile_username": null,
                "reply_count": 0,
                "retweet_count": 0,
                "source": "Twitter Web Client",
                "text": "Proud to celebrate 70 years of care and innovation with the Antelope Valley Medical Center @avmedicalcenter.\n\nFor seven decades, AVMC has been at the heart of our community caring for families, advancing medical excellence, and saving lives. Thank you to the doctors, nurses, staff, and supporters who make that mission possible every day.\n\nI will work hard to ensure that AV Hospital has the resources it needs for the next 70 years of excellence.",
                "text_lang": "en",
                "text_tagged_users": [
                    "avmedicalcenter"
                ],
                "text_tagged_users_ids": [
                    "23457192"
                ],
                "text_tags": null,
