                "quoted_status_profile_username": null,
                "reply_count": 0,
                "retweet_count": 0,
                "source": "Twitter Web App",
                "text": "I visited the Samuel Dixon Family Health Center in Newhall to hear about the ways they will be impacted by the GOP\u2019s harmful budget bill. I opposed the bill in July because cuts to Medicaid and the ACA could hurt local patients and clinics like this one.\n\nInstead of continuing down this path of raising costs on working families and hurting local health centers, Congress should be working together to lower health care costs and strengthen community clinics.",
                "text_lang": "en",
                "text_tagged_users": null,
                "text_tagged_users_ids": null,
                "text_tags": null,
                "timestamp": 1759182149,
                "view_count": 203
            },
