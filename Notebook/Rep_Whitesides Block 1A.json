                "quoted_status_profile_username": null,
                "reply_count": 0,
                "retweet_count": 1,
                "source": "Twitter for iPhone",
                "text": "25,000 people in our district will pay more for health care if the majority allows ACA tax credits to expire.\u00a0\n\nThat\u2019s why I\u2019m pushing for the Protecting Healthcare and Lowering Costs Act \u2014 to make these tax credits permanent, protect Medicaid, and ensure families can access affordable care.",
                "text_lang": "en",
                "text_tagged_users": null,
                "text_tagged_users_ids": null,
                "text_tags": null,
                "timestamp": 1759004413,
                "view_count": 710
