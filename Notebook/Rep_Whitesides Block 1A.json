                "quoted_status_profile_id": null,
                "quoted_status_profile_username": null,
                "reply_count": 1,
                "retweet_count": 0,
                "source": "Twitter for iPhone",
                "text": "Latino families make up more than half of all ACA enrollees in our district and are being hit the hardest by rising costs and threats to ACA funding.\n\nMany work in health care, education, construction, and service jobs without employer coverage. Medi-Cal and ACA tax credits help them afford care for their families. \n\nWithout these protections, over 100,000 Latinos across the Antelope and Santa Clarita Valleys could lose access to affordable health coverage.",
                "text_lang": "en",
                "text_tagged_users": null,
                "text_tagged_users_ids": null,
                "text_tags": null,
                "timestamp": 1760576394,
                "view_count": 11
            },
            {
                "attached_links_expanded_url": null,
                "attached_links_url": null,
                "attached_medias_preview_url": null,
                "attached_medias_url": null,
                "attached_videos": null,
                "author_id": "1872709283634397185",
                "author_username": "Rep_Whitesides",
                "community_notes": null,
                "conversation_id": "1978626916014801325",
                "created_time": "2025-10-16T00:59:56",
                "favorite_count": 0,
                "geo_lat": null,
                "geo_lon": null,
                "id": "1978626932095750625",
                "in_reply_to_post_id": "1978626929105285275",
                "in_reply_to_profile_id": "1872709283634397185",
                "in_reply_to_profile_username": "Rep_Whitesides",
                "place_country_code": null,
                "place_country_name": null,
