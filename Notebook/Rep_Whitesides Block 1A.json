                "quoted_status_profile_username": null,
                "reply_count": 0,
                "retweet_count": 0,
                "source": "Twitter for iPhone",
                "text": "Health care costs are climbing, and working families in our district are paying the price.\n\nMy colleagues need to return to Washington, end the shutdown, and reverse these premium hikes \u2014 so every family in our district can access affordable, reliable care.",
                "text_lang": "en",
                "text_tagged_users": null,
                "text_tagged_users_ids": null,
                "text_tags": null,
                "timestamp": 1760576396,
                "view_count": 121
            },
