                "quoted_status_profile_username": null,
                "reply_count": 0,
                "retweet_count": 7,
                "source": "Twitter for iPhone",
                "text": "I\u2019m back in D.C. ready to work with anyone to reverse the GOP\u2019s extreme health care cuts and pass a budget that lowers costs for American families. \n\nRepublican leadership \u2014 who currently control the House, the Senate, and the White House \u2014 have refused to negotiate with us, so I wanted to share exactly what these health care cuts will mean for our district.",
                "text_lang": "en",
                "text_tagged_users": null,
                "text_tagged_users_ids": null,
                "text_tags": null,
                "timestamp": 1759193003,
                "view_count": 1119
            },
