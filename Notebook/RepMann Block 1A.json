                "quoted_status_profile_username": null,
                "reply_count": 4,
                "retweet_count": 0,
                "source": "Twitter Web Client",
                "text": "House and Senate Republicans voted for a CR that keeps the government\u2019s lights on and allows Congress to return to regular order.\n\nDemocrats demanded that Congress force taxpayers to pay for free health care for illegal immigrants and add $1.5 trillion in new spending on COVID-era health care policies that are completely unrelated to government funding.\n\nKansans can see through Democrats\u2019 political games. It\u2019s time to pass our clean, non-partisan CR and reopen the government.",
                "text_lang": "en",
                "text_tagged_users": null,
                "text_tagged_users_ids": null,
                "text_tags": null,
                "timestamp": 1759948380,
                "view_count": 256
