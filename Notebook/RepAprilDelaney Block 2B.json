                "quote_count": 0,
                "quoted_status_id": null,
                "quoted_status_profile_id": null,
                "quoted_status_profile_username": null,
                "reply_count": 0,
                "retweet_count": 0,
                "source": "Twitter for iPhone",
                "text": "Before I was a Maryland Congresswoman, I was an Idaho farmer\u2019s daughter. The Affordable Care Act open enrollment has kicked off in Idaho \u2014 a disturbing preview of how this partisan attack on health care will raise costs for Americans.\u00a0\n\nOur rural hospitals, clinics, and mental-health/addiction care in Idaho, Western Maryland, and beyond are at risk. Congress must reconvene, reopen the government, and protect rural health care access for millions.\n\nhttps://t.co/tcGvYlUk4P",
                "text_lang": "en",
                "text_tagged_users": null,
                "text_tagged_users_ids": null,
                "text_tags": null,
                "timestamp": 1760726066,
                "view_count": 175
            },
            {
