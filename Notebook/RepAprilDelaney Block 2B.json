                "quoted_status_profile_id": "1437478379511500801",
                "quoted_status_profile_username": "BaltimoreBanner",
                "reply_count": 1,
                "retweet_count": 1,
                "source": "Twitter Web App",
                "text": "I\u2019ve been hearing from so many people across the aisle in my district\u2014working parents, veterans, retirees\u2014worried they\u2019re about to lose their health coverage. And they\u2019re right to be concerned. More than 175,000 Marylanders are at risk of being dropped from Medicaid under the new federal rollback.\n\nMaryland deserves better. We all do.",
                "text_lang": "en",
                "text_tagged_users": null,
                "text_tagged_users_ids": null,
