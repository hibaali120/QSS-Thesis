                ],
                "attached_videos": null,
                "author_id": "1874580463752196096",
                "author_username": "RepAprilDelaney",
                "community_notes": null,
                "conversation_id": "1973840601457307725",
                "created_time": "2025-10-02T20:00:46",
                "favorite_count": 3,
                "geo_lat": null,
                "geo_lon": null,
                "id": "1973840601457307725",
                "in_reply_to_post_id": null,
                "in_reply_to_profile_id": null,
                "in_reply_to_profile_username": null,
                "place_country_code": null,
                "place_country_name": null,
                "place_full_name": null,
                "place_type": null,
                "poll": null,
                "post_type": "post",
                "quote_count": 0,
                "quoted_status_id": null,
                "quoted_status_profile_id": null,
                "quoted_status_profile_username": null,
                "reply_count": 2,
                "retweet_count": 2,
                "source": "Twitter for iPhone",
                "text": "No one wants a shutdown, but our country\u2019s values and health are at stake. This week I met Tony Gonzales, a father diagnosed with cancer and now undergoing chemo. If current ACA tax credits are not included in this CR, he won\u2019t be able to afford premiums, which are projected to nearly double. I remember my devastation when my dad passed from cancer. Health care costs are not just numbers, but impact real people with families and community. \n\nTony\u2019s story echoes the strength of so many in need of life-saving services \u2014 their healthcare is at stake in this critical moment, and this shutdown must be a turning point for Americans and for our values.  If we love America, we need to value and care for our fellow Americans.",
                "text_lang": "en",
                "text_tagged_users": null,
                "text_tagged_users_ids": null,
                "text_tags": null,
                "timestamp": 1759435246,
                "view_count": 439
            },
