                "place_full_name": null,
                "place_type": null,
                "poll": null,
                "post_type": "post",
                "quote_count": 0,
                "quoted_status_id": null,
                "quoted_status_profile_id": null,
                "quoted_status_profile_username": null,
                "reply_count": 0,
                "retweet_count": 2,
                "source": "Twitter for iPhone",
                "text": "If ACA tax credits aren\u2019t extended in this CR, Marylanders could see their health premiums jump from $621 to $1,711 a month \u2014 a $1,089 hike for the same plan. Our families can\u2019t afford this spike in costs.\n\nDemocrats are working nonstop to pass a CR that does right by the American people, it\u2019s time for our Republican colleagues to put their constituents first and protect health care affordability.",
                "text_lang": "en",
                "text_tagged_users": null,
                "text_tagged_users_ids": null,
                "text_tags": null,
                "timestamp": 1760195633,
                "view_count": 237
