                "quoted_status_profile_username": null,
                "reply_count": 0,
                "retweet_count": 0,
                "source": "Twitter for iPhone",
                "text": "I was delighted \u2014 but not surprised \u2014 to hear that Garrett Regional Medical Center was named one of the 386 cleanest hospitals in the country according to Becker\u2019s Hospital Review. It\u2019s always a pleasure to visit CEO Mark Boucot and GRMC \u2014 the only Maryland hospital to earn this distinction. I could not be more proud of the dedicated health care workers and hospital staff that keep GRMC running, congratulations to all!\n\nhttps://t.co/8fz7xrcYXD",
                "text_lang": "en",
                "text_tagged_users": null,
                "text_tagged_users_ids": null,
                "text_tags": null,
                "timestamp": 1760535930,
