                "quoted_status_profile_username": null,
                "reply_count": 2,
                "retweet_count": 0,
                "source": "Twitter Web App",
                "text": "Today, I met with Rafael Holdings, a clinical-stage biotechnology company headquartered in New Jersey. Rafael is working to develop new treatments for patients with rare and difficult-to-treat diseases. \n\nWe discussed rare pediatric priority review vouchers, an incentive for companies developing cures for rare pediatric diseases. I have supported this important incentive in the Give Kids a Chance Act.\n\nI appreciate the work Rafael Holdings is doing here in NJ to push the boundaries of medical innovation and to bring forward new treatments for rare pediatric diseases.",
                "text_lang": "en",
                "text_tagged_users": null,
                "text_tagged_users_ids": null,
                "text_tags": null,
                "timestamp": 1758056492,
                "view_count": 338
            },
