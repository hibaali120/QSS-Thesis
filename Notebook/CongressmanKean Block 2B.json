                "quoted_status_profile_username": null,
                "reply_count": 3,
                "retweet_count": 2,
                "source": "Twitter Web App",
                "text": "Today, I met with leaders from Bristol Myers Squibb (BMS), a U.S.-based global biopharmaceutical company dedicated to discovering, developing, and delivering innovative medicines that help patients overcome serious diseases.\n\nWe discussed BMS\u2019s U.S. footprint, the value of innovation in developing life-changing treatments, and ways to advance healthcare and support scientific progress right here in New Jersey.",
                "text_lang": "en",
                "text_tagged_users": null,
                "text_tagged_users_ids": null,
                "text_tags": null,
                "timestamp": 1757456423,
                "view_count": 507
            },
