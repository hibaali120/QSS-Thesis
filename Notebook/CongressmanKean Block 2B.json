                "quoted_status_profile_username": null,
                "reply_count": 3,
                "retweet_count": 0,
                "source": "Twitter Web App",
                "text": "It was great to sit down with Paul Di Maio, President and CEO of Delta Dental of New Jersey, to discuss the state of the dental industry and ways to better serve patients across the Garden State.\n\nWe spoke about legislation to expand access to dental insurance, the more than $26 million their Foundation has invested in care for the underinsured and uninsured, and their support for dental education programs in New Jersey.",
                "text_lang": "en",
                "text_tagged_users": null,
                "text_tagged_users_ids": null,
                "text_tags": null,
                "timestamp": 1757004031,
                "view_count": 508
