                "quoted_status_profile_username": null,
                "reply_count": 7,
                "retweet_count": 1,
                "source": "Twitter Web App",
                "text": "Millions of Americans depend on premium tax credits to afford health coverage. Since 2021, these credits have made private insurance more accessible. \n\nI joined a bipartisan group to extend them for another year, preventing steep premium hikes while we work on long-term solutions to lower costs.",
                "text_lang": "en",
                "text_tagged_users": null,
                "text_tagged_users_ids": null,
                "text_tags": null,
                "timestamp": 1757088926,
                "view_count": 365
            },
