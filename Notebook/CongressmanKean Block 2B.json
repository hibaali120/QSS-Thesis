                "poll": null,
                "post_type": "quote",
                "quote_count": 1,
                "quoted_status_id": "1974201705949786340",
                "quoted_status_profile_id": "2968451607",
                "quoted_status_profile_username": "RepBonnie",
                "reply_count": 12,
                "retweet_count": 4,
                "source": "Twitter for iPhone",
                "text": "I supported the bipartisan bill to keep our government open, you opposed it.\n\nI support the bipartisan bill that prevents healthcare premiums from spiking, you oppose it.\n\nI hope you will, very soon, work up the courage to drop your senseless political games and support these kind of bills that are in your constituents\u2019 best interests.",
                "text_lang": "en",
                "text_tagged_users": null,
                "text_tagged_users_ids": null,
                "text_tags": null,
                "timestamp": 1759522189,
