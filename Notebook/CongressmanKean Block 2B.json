                "reply_count": 3,
                "retweet_count": 0,
                "source": "Twitter Web App",
                "text": "This afternoon, I sat down with members of the American Physical Therapy Association, including Spiridoula Riley of Kessler Rehabilitation Centers located in Bridgewater. \n\nWe discussed ways to make it easier for patients to get the care they need, and how to cut through red tape that\u2019s making it harder for physical therapy clinics to do their job, especially here in NJ.\n\nI will keep pushing for commonsense reforms that support our local clinics and the people they serve in NJ and across the country.",
                "text_lang": "en",
                "text_tagged_users": null,
                "text_tagged_users_ids": null,
                "text_tags": null,
