                "quoted_status_profile_username": null,
                "reply_count": 3,
                "retweet_count": 1,
                "source": "Twitter for iPhone",
                "text": "Insmed is a global biopharmaceutical company developing life-changing therapies for patients with serious and rare diseases.\u00a0\n\u00a0\nYesterday, I had the opportunity to tour their global headquarters right here in Bridgewater. Their team demonstrated how they are working to improve health outcomes and expand access to care for those who need it most.\n\nThank you, @Insmed, for the informative tour!",
                "text_lang": "en",
