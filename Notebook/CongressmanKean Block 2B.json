                "quoted_status_profile_username": null,
                "reply_count": 3,
                "retweet_count": 3,
                "source": "Twitter for iPhone",
                "text": "I visited Kindred Hospital in Rahway today, a long-term acute care facility that provides specialized treatment for patients with serious and complex medical conditions. I had the opportunity to hear directly from physicians and staff about their comprehensive approach to care and rehabilitation.\n\u00a0\nTheir dedicated team showed how they work every day to support and empower patients on their road to recovery.\nThank you, Kindred, for inviting me and for the incredible work you are doing to improve lives.",
                "text_lang": "en",
                "text_tagged_users": null,
                "text_tagged_users_ids": null,
                "text_tags": null,
