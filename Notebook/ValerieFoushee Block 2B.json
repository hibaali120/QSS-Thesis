                "quoted_status_profile_username": null,
                "reply_count": 3,
                "retweet_count": 0,
                "source": "Twitter Web App",
                "text": "Every person has the right to choose their health providers without interference.\n\nI\u2019m proud to join 237 of my colleagues in filing a bicameral amicus brief to defend the rights of millions of Medicaid patients who depend on Planned Parenthood for essential health services and care.\n\nOur amicus brief \u2935\ufe0f\nhttps://t.co/88xOGZsdQF",
                "text_lang": "en",
                "text_tagged_users": null,
