                "quote_count": 0,
                "quoted_status_id": "1986486651279769895",
                "quoted_status_profile_id": "28785486",
                "quoted_status_profile_username": "ABC",
                "reply_count": 0,
                "retweet_count": 0,
                "source": "Twitter for iPhone",
                "text": "In a classic Donald Trump move, he\u2019s taking credit for the hard work of others. The Medicare Drug Price Negotiation Program that Democrats authored made possible the lower GLP-1 drug prices announced today.",
                "text_lang": "en",
                "text_tagged_users": null,
