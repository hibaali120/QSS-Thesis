                "quoted_status_profile_username": "nycemergencymgt",
                "reply_count": 5,
                "retweet_count": 0,
                "source": "Twitter for iPhone",
                "text": "My constituents are worried they\u2019ll face many delays traveling for the holidays\u2014from wraparound lines at airport security to waiting on the runway. \n\nIt\u2019s all because Republicans shut down the government, DOUBLING your health insurance premium, and are making it harder to enjoy the holiday you\u2019re traveling to celebrate.",
                "text_lang": "en",
                "text_tagged_users": null,
