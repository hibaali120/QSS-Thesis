                "geo_lat": null,
                "geo_lon": null,
                "id": "1986203860717703210",
                "in_reply_to_post_id": "1986203858159178191",
                "in_reply_to_profile_id": "1610323296360210433",
                "in_reply_to_profile_username": "RepDonDavis",
                "place_country_code": null,
                "place_country_name": null,
                "place_full_name": null,
                "place_type": null,
                "poll": null,
                "post_type": "reply",
                "quote_count": 0,
                "quoted_status_id": null,
                "quoted_status_profile_id": null,
                "quoted_status_profile_username": null,
                "reply_count": 1,
                "retweet_count": 0,
                "source": "Twitter for iPhone",
                "text": "Overwhelmingly, constituents believed they had to have health insurance and expressed that they were being affected emotionally, including feelings of stress and depression. One mother said, \u201cI feel like crying.\u201d There were strong feelings of mistrust toward Washington, D.C. politicians, who many felt had left them behind and made them feel unheard. A constituent said, \u201cThis is not the America I have known,\u201d and another expressed that \u201cthey have no idea what this has done to our lives.\u201d",
                "text_lang": "en",
                "text_tagged_users": null,
                "text_tagged_users_ids": null,
                "text_tags": null,
                "timestamp": 1762382876,
                "view_count": 22
