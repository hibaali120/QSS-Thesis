                "quoted_status_profile_username": null,
                "reply_count": 0,
                "retweet_count": 0,
                "source": "Twitter for iPhone",
                "text": "Our community health centers play a vital role in delivering healthcare to communities across eastern NC. Healthcare professionals emphasized the importance of reopening the government and prioritizing the Community Health Center Fund, as well as other federal funds that support many of our hard-working families.",
                "text_lang": "en",
                "text_tagged_users": null,
                "text_tagged_users_ids": null,
