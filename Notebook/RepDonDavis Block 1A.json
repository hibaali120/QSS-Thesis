                "quoted_status_profile_username": null,
                "reply_count": 1,
                "retweet_count": 3,
                "source": "Twitter for iPhone",
                "text": "If Congress does not act to extend the Community Health Center Fund and deliver crucial federal support, community health centers across the country will be forced to take on more uncompensated care and cut vital services. https://t.co/Ff1yDrLFmc",
                "text_lang": "en",
                "text_tagged_users": null,
                "text_tagged_users_ids": null,
