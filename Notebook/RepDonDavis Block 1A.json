                "quoted_status_profile_username": null,
                "reply_count": 2,
                "retweet_count": 0,
                "source": "Twitter for iPhone",
                "text": "Many individuals who may not be feeling their best or have limited resources visit the Kinston Community Health Center for essential care. A skilled and dedicated team of healthcare providers meets them with compassion, which I have seen firsthand. Vital services are made possible because the Community Health Center Fund, which expired on October 1, and Congress should act promptly to extend it.",
                "text_lang": "en",
                "text_tagged_users": null,
                "text_tagged_users_ids": null,
