                "quoted_status_profile_username": null,
                "reply_count": 2,
                "retweet_count": 0,
                "source": "Buffer",
                "text": "The Republican health care crisis and government shutdown are hurting the American people. Health care premiums have more than doubled, essential services are being delayed, and public servants, including my own hardworking staff, have gone more than a month without pay. \n\nThat\u2019s why I've had my pay withheld because Members of Congress should not be treated differently.  \n\nAlongside my Democratic colleagues, I\u2019m working to reach a bipartisan agreement that reopens the government, ensures SNAP benefits are delivered, and lowers health care costs for Valley families.",
                "text_lang": "en",
                "text_tagged_users": null,
                "text_tagged_users_ids": null,
                "text_tags": null,
                "timestamp": 1762200025,
                "view_count": 233
