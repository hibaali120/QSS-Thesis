                "quoted_status_profile_username": null,
                "reply_count": 9,
                "retweet_count": 6,
                "source": "Twitter Web App",
                "text": "Americans who gained Medicaid coverage through the ACA expansion were 21% less likely to die. The expansion saved nearly 27,000 lives, and now Republicans want to take it away.\n\nWe have to do more to protect our constituents.",
                "text_lang": "en",
                "text_tagged_users": null,
