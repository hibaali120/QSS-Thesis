                "quoted_status_profile_username": null,
                "reply_count": 365,
                "retweet_count": 85,
                "source": "Twitter for iPhone",
                "text": "Even with workplace insurance, the cost of healthcare coverage for a family of four now exceeds $35,000/year.\n\nAmerica must stop treating affordable healthcare as privilege rather than a human right. We need to pass mine and @SenSanders\u2019 Medicare for All.",
                "text_lang": "en",
