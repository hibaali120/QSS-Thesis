                "quoted_status_profile_id": null,
                "quoted_status_profile_username": null,
                "reply_count": 11,
                "retweet_count": 1,
                "source": "Twitter for iPhone",
                "text": "Health care costs are one of the biggest issues I hear about from UT patients, providers, & employers, & addressing this pressing issue is a top priority for me in DC. That is why I reintroduced the bipartisan\u00a0HOPE Act\u00a0to create a new tax-advantaged savings account that will help families plan & save for medical expenses. This bill is a step in the right direction in making health care more affordable for Utahns & Americans across the country.",
                "text_lang": "en",
                "text_tagged_users": null,
                "text_tagged_users_ids": null,
                "text_tags": null,
                "timestamp": 1738709613,
                "view_count": 1389
            },
