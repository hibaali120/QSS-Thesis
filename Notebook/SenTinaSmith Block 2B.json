                "quoted_status_profile_username": null,
                "reply_count": 2,
                "retweet_count": 3,
                "source": "Twitter Web App",
                "text": "In Minnesota alone, nearly 200,000 people will lose their health insurance. Rural hospitals will be forced to close. Planned Parenthood will lose its funding and have to shutter clinics.",
