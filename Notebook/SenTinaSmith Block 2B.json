                "text_tags": null,
                "timestamp": 1746712310,
                "view_count": 4639
            },
            {
                "attached_links_expanded_url": null,
                "attached_links_url": null,
                "attached_medias_preview_url": null,
                "attached_medias_url": null,
                "attached_videos": null,
                "author_id": "941000686275387392",
                "author_username": "SenTinaSmith",
                "community_notes": null,
                "conversation_id": "1924854768771461208",
                "created_time": "2025-05-20T15:48:33",
                "favorite_count": 81,
                "geo_lat": null,
                "geo_lon": null,
                "id": "1924854768771461208",
                "in_reply_to_post_id": null,
                "in_reply_to_profile_id": null,
                "in_reply_to_profile_username": null,
                "place_country_code": null,
                "place_country_name": null,
                "place_full_name": null,
                "place_type": null,
                "poll": null,
                "post_type": "post",
                "quote_count": 1,
                "quoted_status_id": null,
                "quoted_status_profile_id": null,
                "quoted_status_profile_username": null,
                "reply_count": 47,
                "retweet_count": 22,
                "source": "Twitter Web App",
                "text": "I visit rural hospitals all the time. The Republican health care cuts won't just hurt them \u2013 they'll force them to close their doors.\n\nPatients will lose health insurance, skip getting care because they can't afford it, and then end up in the ER when it becomes too serious to ignore.",
                "text_lang": "en",
                "text_tagged_users": null,
                "text_tagged_users_ids": null,
                "text_tags": null,
                "timestamp": 1747756113,
                "view_count": 3199
            },
            {
                "attached_links_expanded_url": null,
                "attached_links_url": null,
                "attached_medias_preview_url": null,
                "attached_medias_url": null,
                "attached_videos": null,
                "author_id": "941000686275387392",
                "author_username": "SenTinaSmith",
                "community_notes": null,
                "conversation_id": "1924854768771461208",
                "created_time": "2025-05-20T15:48:33",
                "favorite_count": 10,
                "geo_lat": null,
                "geo_lon": null,
                "id": "1924854770050715827",
                "in_reply_to_post_id": "1924854768771461208",
                "in_reply_to_profile_id": "941000686275387392",
                "in_reply_to_profile_username": "SenTinaSmith",
                "place_country_code": null,
                "place_country_name": null,
                "place_full_name": null,
                "place_type": null,
                "poll": null,
                "post_type": "reply",
                "quote_count": 0,
                "quoted_status_id": null,
                "quoted_status_profile_id": null,
                "quoted_status_profile_username": null,
                "reply_count": 2,
                "retweet_count": 4,
                "source": "Twitter Web App",
                "text": "Rural hospitals are already squeezed \u2013 they can't afford to give out care without some form of payment from insurance companies. So, when our neighbors show up to the ER for care, and they don\u2019t have Medicaid anymore, the hospital has to foot the bill.",
                "text_lang": "en",
                "text_tagged_users": null,
                "text_tagged_users_ids": null,
                "text_tags": null,
                "timestamp": 1747756113,
                "view_count": 1391
            },
            {
