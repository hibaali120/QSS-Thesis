                "quoted_status_profile_username": null,
                "reply_count": 29,
                "retweet_count": 14,
                "source": "Twitter Web App",
                "text": "I asked Trump\u2019s nominee for Treasury Secretary about all these giant corporations/private equity buying up hospitals, especially in rural areas, and closing them down because they\u2019re not deemed profitable.\n\nIt seems he\u2019s just fine with that model.",
                "text_lang": "en",
                "text_tagged_users": null,
                "text_tagged_users_ids": null,
                "text_tags": null,
                "timestamp": 1737070202,
                "view_count": 3363
            },
            {
                "attached_links_expanded_url": null,
                "attached_links_url": null,
                "attached_medias_preview_url": null,
                "attached_medias_url": null,
                "attached_videos": null,
                "author_id": "941000686275387392",
                "author_username": "SenTinaSmith",
                "community_notes": null,
                "conversation_id": "1880034808711221472",
                "created_time": "2025-01-16T23:30:02",
                "favorite_count": 17,
                "geo_lat": null,
                "geo_lon": null,
                "id": "1880034810699415894",
                "in_reply_to_post_id": "1880034808711221472",
                "in_reply_to_profile_id": "941000686275387392",
                "in_reply_to_profile_username": "SenTinaSmith",
