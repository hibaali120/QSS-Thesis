                "quoted_status_profile_id": null,
                "quoted_status_profile_username": null,
                "reply_count": 4,
                "retweet_count": 4,
                "source": "Twitter Web App",
                "text": "Private equity firms\u2019 main focus when buying hospitals is not taking good care of patients. It\u2019s maximizing their profit.\n\nIt\u2019s throwing the people who rely on those hospitals and health care workers under the bus.",
                "text_lang": "en",
                "text_tagged_users": null,
