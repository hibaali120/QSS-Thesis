                "poll": null,
                "post_type": "post",
                "quote_count": 3,
                "quoted_status_id": null,
                "quoted_status_profile_id": null,
                "quoted_status_profile_username": null,
                "reply_count": 115,
                "retweet_count": 33,
                "source": "Twitter Web App",
                "text": "Making it harder for sick people to receive health care saves money... by keeping people sick. If they can't afford to go to the doctor, we don't have to pay for it. \n\nThat's R's logic.\n\nReality check: Cutting coverage doesn't cut sickness.",
                "text_lang": "en",
                "text_tagged_users": null,
