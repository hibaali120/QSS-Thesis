                "quoted_status_profile_username": null,
                "reply_count": 1,
                "retweet_count": 5,
                "source": "Twitter Web App",
                "text": "If you talk to a lot of rural hospitals they\u2019ll tell you the same thing: They can\u2019t afford to keep their doors open if that happens. Many of them will close, and that hurts everyone \u2013 not just the folks who rely on Medicaid.",
                "text_lang": "en",
