                "quoted_status_profile_username": null,
                "reply_count": 3,
                "retweet_count": 0,
                "source": "Twitter Web App",
                "text": "Too many families in the Big First and across the country have been affected by addiction, mental health struggles, and the fentanyl crisis. That\u2019s why I voted to pass the SUPPORT for Patients and Communities Reauthorization Act.\n\nThis bill will make sure Kansans get the help they need by investing in treatment and recovery resources, supporting mental and behavioral health training, and helping first responders save lives.",
                "text_lang": "en",
                "text_tagged_users": null,
                "text_tagged_users_ids": null,
                "text_tags": null,
                "timestamp": 1749144376,
                "view_count": 239
            },
