                "quoted_status_profile_username": null,
                "reply_count": 13,
                "retweet_count": 2,
                "source": "Twitter Web App",
                "text": "The so-called Affordable Care Act \u2014 passed without a single Republican vote \u2014 has left health care more unaffordable and less accessible for millions. That\u2019s why pragmatic lawmakers on both sides of the aisle, myself included, are working to fix what\u2019s broken by: (1) directing federal dollars straight to patients instead of insurance companies; (2) targeting support to middle-class families and those truly in need, not millionaires; and (3) finally holding insurers accountable after making billions while denying 1 in 3 claims.",
                "text_lang": "en",
                "text_tagged_users": null,
                "text_tagged_users_ids": null,
                "text_tags": null,
                "timestamp": 1764707021,
                "view_count": 446
            },
