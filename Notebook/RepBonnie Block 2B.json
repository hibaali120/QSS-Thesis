                "quoted_status_profile_username": null,
                "reply_count": 14,
                "retweet_count": 1,
                "source": "Twitter Web App",
                "text": "Americans are feeling the pain of Republican policies with massive increases in health insurance premiums, utility bills that are surging every month, and the first large-scale layoffs at manufacturing plants since before the pandemic.\n\nHardworking Americans deserve a Congress focused on them, not wealthy donors.",
                "text_lang": "en",
