                "quoted_status_profile_id": null,
                "quoted_status_profile_username": null,
                "reply_count": 3,
                "retweet_count": 17,
                "source": "Twitter for iPhone",
                "text": "House Democrats are united against ripping healthcare from 17 million Americans. \n\nIf this bill passes 363,000 people in NJ will lose coverage through the ACA and NJ FamilyCare.\nThis bill has the biggest cut to food assistance in history. \n\nIt\u2019s shameful that House Republicans  would even bring this bill up for a vote.\n\nIn New Jersey, in Van Drew\u2019s district 86,000 people can lose access to nutritional assistance and kids will go hungry.\n\nIn Chris Smith\u2019s district almost 100,000 children get their healthcare through NJ FamilyCare.\n\nIn Tom Kean\u2019s district 11,000 seniors will face the closure of their nursing home.",
                "text_lang": "en",
                "text_tagged_users": null,
                "text_tagged_users_ids": null,
                "text_tags": null,
                "timestamp": 1751466386,
                "view_count": 2149
            },
