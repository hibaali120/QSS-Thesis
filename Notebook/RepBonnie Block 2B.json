                "quoted_status_profile_id": null,
                "quoted_status_profile_username": null,
                "reply_count": 2,
                "retweet_count": 7,
                "source": "Twitter Web App",
                "text": "This year, I\u2019ve traveled the state of New Jersey, hearing from the constituents of my 3 GOP colleagues because they could not be bothered.\n\nI spoke to some of the 178,000 people in Rep. Van Drew\u2019s (@Congressman_JVD) district on NJ FamilyCare who may lose coverage.\n\nAnd the parents of the nearly 100,000 children in Rep. Chris Smith\u2019s District who are at risk of losing their NJ FamilyCare health coverage.\n\nAnd I spoke to some of the 11,000 seniors in @CongressmanKean's district who are worried about their nursing homes having to shut down.\n\nI encourage my colleagues from Jersey to listen to their constituents and vote \u201cno!\u201d\n\nAnd may God forgive those who do not do for the least among us.",
                "text_lang": "en",
                "text_tagged_users": [
                    "Congressman_JVD"
                ],
                "text_tagged_users_ids": [
                    "1468677099594698757"
