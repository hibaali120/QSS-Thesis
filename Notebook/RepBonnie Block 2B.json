                "quoted_status_profile_username": null,
                "reply_count": 6,
                "retweet_count": 4,
                "source": "Twitter Web App",
                "text": "Half of all children in this country receive Medicaid coverage.\n\nThe richest one percent of the population will get the biggest benefit from the Republican tax plan, which cuts Medicaid to try to offset the lost revenue.\n\n50% of kids should not have to pay for the 1%'s tax cuts.",
                "text_lang": "en",
