                "quoted_status_profile_username": null,
                "reply_count": 1,
                "retweet_count": 1,
                "source": "Twitter for iPhone",
                "text": "When Trump and Congressional Republicans gutted Medicaid, Medicare, and the Affordable Care Act, they pulled the rug out from under hospitals and clinics that families depend on.\n\nNow, facilities across Western New York are being forced to close their doors because of those failed policies.\n\nPatients and providers deserve a healthcare system that works \u2014 not one that makes care harder to access, more expensive, and more dangerous.\n\nIt\u2019s time to cancel the cuts.",
                "text_lang": "en",
                "text_tagged_users": null,
                "text_tagged_users_ids": null,
                "text_tags": null,
                "timestamp": 1760029407,
                "view_count": 341
            },
