                "quoted_status_profile_username": null,
                "reply_count": 6,
                "retweet_count": 3,
                "source": "Twitter Web App",
                "text": "The One Big Beautiful Bill Act represents a generational investment in Rural America:\n\n\u2705Improves standing livestock disaster programs\n\u2705Increases reference prices\n\u2705Expands crop insurance\n\u2705Invests in livestock biosecurity\n\u2705Saves two million family farms from a Death Tax increase\n\u2705Invests $100 billion in Rural Distressed Communities\n\u2705Levels the playing field on the world stage for our farmers, ranchers, and producers",
                "text_lang": "en",
