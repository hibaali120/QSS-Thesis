                "quoted_status_profile_username": null,
                "reply_count": 29,
                "retweet_count": 7,
                "source": "Twitter Web App",
                "text": "The window-shopping period for purchasing health insurance on Washington Healthplanfinder is beginning and unfortunately Washingtonians are going to see skyrocketing premiums statewide. They face an impossible choice: Pay hundreds or even thousands of dollars more next year for the exact same plan, downgrade their coverage, or forego health insurance altogether. \n\nFamilies are still reeling from sky-high inflation on everyday expenses like electricity, housing, and groceries. Congress must act immediately to extend the expiring Affordable Care Act tax credits or healthcare will be added to their list of financial burdens.",
                "text_lang": "en",
                "text_tagged_users": null,
                "text_tagged_users_ids": null,
                "text_tags": null,
