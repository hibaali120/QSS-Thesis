                "quoted_status_profile_username": "stephen_neukam",
                "reply_count": 3,
                "retweet_count": 0,
                "source": "Twitter Web App",
                "text": "Given that Speaker Johnson refuses to promise a vote on lowering healthcare costs, a deal that excludes the ACA tax credits puts the healthcare of over 25,000 people in my district at risk.\n\nI'm ready to find a solution to address the healthcare crisis and open the government\u2014but this deal doesn't do that.",
                "text_lang": "en",
                "text_tagged_users": null,
