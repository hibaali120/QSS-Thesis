            },
            {
                "attached_links_expanded_url": null,
                "attached_links_url": null,
                "attached_medias_preview_url": null,
                "attached_medias_url": null,
                "attached_videos": null,
                "author_id": "1878848847717208065",
                "author_username": "Sen_Alsobrooks",
                "community_notes": null,
                "conversation_id": "1987698944214810632",
                "created_time": "2025-11-10T01:48:52",
                "favorite_count": 4000,
                "geo_lat": null,
                "geo_lon": null,
                "id": "1987698944214810632",
                "in_reply_to_post_id": null,
                "in_reply_to_profile_id": null,
                "in_reply_to_profile_username": null,
                "place_country_code": null,
                "place_country_name": null,
                "place_full_name": null,
                "place_type": null,
                "poll": null,
                "post_type": "post",
                "quote_count": 32,
                "quoted_status_id": null,
                "quoted_status_profile_id": null,
                "quoted_status_profile_username": null,
                "reply_count": 639,
                "retweet_count": 463,
                "source": "Twitter for iPhone",
                "text": "I will be voting NO on the CR proposed today.\n\nI have voted eight separate times to reopen the government. And each of those times, I voted for a CR that addresses the health care crisis Republicans have unleashed on working families across this country. \n\nAfter weeks of refusing to negotiate, Senate Republicans have finally put forth a new CR that reaffirms their indifference to the health care crisis and growing unaffordability of our country. \n\nAs I look at this new CR, I am glad to see it includes language I fought for to reverse the draconian RIFs.\n\nBut, I have maintained from the beginning of this Republican shutdown that I could not vote for anything that does not address the rising health care costs. \n\nThe first 11 months of this Administration have been a disaster. Marylanders are struggling to pay their bills because of soaring energy costs and grocery prices. Patriotic civil servants have been fired after years of dedicated service. Our economy has been wrecked by chaotic tariffs. And after all that, Republicans have put forth a CR today that does absolutely nothing to help struggling Marylanders afford health care.\n\nI made a promise to the people of Maryland that I would always vote in their best interests. That\u2019s why I\u2019m voting NO.",
                "text_lang": "en",
                "text_tagged_users": null,
                "text_tagged_users_ids": null,
                "text_tags": null,
                "timestamp": 1762739332,
                "view_count": 148041
            },
            {
                "attached_links_expanded_url": null,
