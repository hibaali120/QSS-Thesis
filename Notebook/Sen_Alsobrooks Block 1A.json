                "quoted_status_profile_username": "nbcwashington",
                "reply_count": 306,
                "retweet_count": 58,
                "source": "Twitter Web App",
                "text": "This Republican shutdown is the longest government shutdown in our nation's history.\n\nAnd Republicans would rather keep it shut down than ensure affordable health care.\n\nIt is so shameful.",
                "text_lang": "en",
                "text_tagged_users": null,
