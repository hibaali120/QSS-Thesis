                "retweet_count": 1,
                "source": "Twitter Web App",
                "text": "3. MACA expands the small business tax credit to encourage employer-sponsored coverage.\u00a0\n\n\u2705 \u00a0Raises the eligible employee threshold from 25 to 50\u00a0\n\u2705 \u00a0Removes the $57,000 salary cap\u00a0\n\u2705 \u00a0Increases the tax credit to 50% for all qualifying employers",
                "text_lang": "en",
                "text_tagged_users": null,
                "text_tagged_users_ids": null,
                "text_tags": null,
