                "quoted_status_profile_username": null,
                "reply_count": 10,
                "retweet_count": 5,
                "source": "Twitter for iPhone",
                "text": "This Medicare Fraud Prevention Week, I'd like to highlight the critical issue of fraud in our healthcare system. Every single year, taxpayers are losing more than $100 billion to fraud and abuse.\n\nI introduced the Medicare and Medicaid Fraud Prevention Act to right this wrong. Read more about my common-sense, bipartisan bill \u2b07\ufe0f\n\nhttps://t.co/1t5Se7jch2",
                "text_lang": "en",
