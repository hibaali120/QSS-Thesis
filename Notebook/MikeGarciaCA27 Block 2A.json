                "quoted_status_profile_id": null,
                "quoted_status_profile_username": null,
                "reply_count": 16,
                "retweet_count": 7,
                "source": "Twitter for iPhone",
                "text": "Millions of Californians rely on Medicare and Medicaid, and I'll always fight to protect these critical programs. That's why I introduced a bipartisan bill to better protect your healthcare from fraud and abuse.\n\nTaxpayers are losing more than $100 billion to healthcare fraud every year, and my common-sense bill to right that wrong is now heading to the House floor. Read more about my critical, bipartisan bill here \u2b07\ufe0f\n\nhttps://t.co/KJ1rghAGu9",
                "text_lang": "en",
                "text_tagged_users": null,
                "text_tagged_users_ids": null,
