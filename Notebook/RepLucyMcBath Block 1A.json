                "retweet_count": 2,
                "source": "Twitter Web App",
                "text": "Today, President Trump signed an executive order to reschedule marijuana, enabling researchers to study its medical benefits more effectively. \n\nThis order should serve as a critical first step toward meaningful criminal justice reform for marijuana-related offenses as envisioned in the Clean Slate Act, which I lead.",
                "text_lang": "en",
                "text_tagged_users": null,
                "text_tagged_users_ids": null,
                "text_tags": null,
                "timestamp": 1766093679,
                "view_count": 381
            },
