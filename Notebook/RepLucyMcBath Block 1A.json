                "quoted_status_profile_username": null,
                "reply_count": 1,
                "retweet_count": 1,
                "source": "Twitter Web App",
                "text": "While the order will benefit the legal cannabis industry and medical research, reform cannot stop here. This order does not change the criminal penalties or considerations for marijuana-related offenses.\n\nTens of thousands of individuals remain incarcerated for these offenses, and we cannot, in good faith, advance an industry while denying impacted individuals a clear path home to their families, an opportunity to return to their lives, and a chance to contribute in their communities.",
                "text_lang": "en",
                "text_tagged_users": null,
                "text_tagged_users_ids": null,
