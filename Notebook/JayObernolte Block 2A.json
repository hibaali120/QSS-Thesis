                "quoted_status_profile_username": null,
                "reply_count": 41,
                "retweet_count": 20,
                "source": "Twitter Web App",
                "text": "The passage of H.R. 1 marks a major win for the American people. This legislation cuts taxes for working families, secures our southern border, strengthens Medicaid for those who depend on it, and reins in wasteful Washington spending\u2014all without raising taxes. I proudly supported this bill because it will meaningfully improve quality of life for the people in our district.",
                "text_lang": "en",
                "text_tagged_users": null,
                "text_tagged_users_ids": null,
                "text_tags": null,
                "timestamp": 1751570761,
                "view_count": 3475
