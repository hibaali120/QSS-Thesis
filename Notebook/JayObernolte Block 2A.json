                "place_full_name": null,
                "place_type": null,
                "poll": null,
                "post_type": "post",
                "quote_count": 0,
                "quoted_status_id": null,
                "quoted_status_profile_id": null,
                "quoted_status_profile_username": null,
                "reply_count": 15,
                "retweet_count": 4,
                "source": "Twitter Web App",
                "text": "H.R. 1 is a meaningful step in reining in out-of-control federal spending. It reduces spending by $1.6 trillion by cracking down on waste, fraud, and abuse across federal programs. It strengthens oversight in Medicaid to ensure taxpayer dollars go to those who truly need them\u2014protecting both the program and the American taxpayer. With a national debt approaching $37 trillion, we have a responsibility to act, and H.R. 1 is a great first step towards finally balancing the federal budget.",
                "text_lang": "en",
                "text_tagged_users": null,
                "text_tagged_users_ids": null,
                "text_tags": null,
                "timestamp": 1752019599,
                "view_count": 1216
