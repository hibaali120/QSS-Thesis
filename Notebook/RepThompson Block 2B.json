                "quoted_status_profile_username": null,
                "reply_count": 2,
                "retweet_count": 1,
                "source": "Buffer",
                "text": "Families across our district are feeling the devastating impact of the federal shutdown and the lapse in healthcare tax credits. For small business owners in Sonoma County, that means premiums doubling overnight \u2014 and losing access to the doctors and medicines they rely on. This isn\u2019t political. It\u2019s personal.",
                "text_lang": "en",
                "text_tagged_users": null,
                "text_tagged_users_ids": null,
                "text_tags": null,
