                "quoted_status_profile_username": null,
                "reply_count": 104,
                "retweet_count": 9,
                "source": "Twitter for iPhone",
                "text": "If you have seen your 2026 health care premiums skyrocket, please share your story.\n\u00a0\nRepublicans have refused to extend critical premium tax credits for working families, and now thousands of Coloradans are at risk of losing coverage.\n\u00a0\nYour story will allow me to shine a light on this crisis.",
                "text_lang": "en",
                "text_tagged_users": null,
                "text_tagged_users_ids": null,
                "text_tags": null,
                "timestamp": 1762707894,
                "view_count": 3954
