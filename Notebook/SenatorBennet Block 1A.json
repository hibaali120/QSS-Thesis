                "place_type": null,
                "poll": null,
                "post_type": "post",
                "quote_count": 38,
                "quoted_status_id": null,
                "quoted_status_profile_id": null,
                "quoted_status_profile_username": null,
                "reply_count": 558,
                "retweet_count": 37,
                "source": "Twitter Web App",
                "text": "Colorado families are already struggling to get by as the costs of childcare, rent, and groceries continue to skyrocket.\n\nThe least we could do is make things a little bit easier and extend the ACA tax credits that make their health insurance more affordable.\n\nI will do everything I can to extend these tax credits and bring down health care costs for working families.",
