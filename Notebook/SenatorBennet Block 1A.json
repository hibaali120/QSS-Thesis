                "quoted_status_profile_username": null,
                "reply_count": 4675,
                "retweet_count": 233,
                "source": "Twitter Web App",
                "text": "When we passed the Affordable Care Act, we made historic progress in making health care attainable for working people.\n\nAfter years of Republicans trying to take that health care away, we cannot give up our fight now, as millions are at risk of losing their premium tax credits and their coverage.",
                "text_lang": "en",
                "text_tagged_users": null,
                "text_tagged_users_ids": null,
                "text_tags": null,
                "timestamp": 1762814050,
                "view_count": 173942
