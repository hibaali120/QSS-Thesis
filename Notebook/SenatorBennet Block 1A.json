                "quoted_status_profile_username": null,
                "reply_count": 2511,
                "retweet_count": 101,
                "source": "Twitter Web App",
                "text": "Health care is a right.\n\nAnd until we have universal coverage in this country, we shouldn\u2019t make it harder for working families to afford their coverage and stay healthy by allowing critical ACA tax credits to expire.\n\nThese credits are a lifeline for countless Coloradans. We must fight to preserve them.",
                "text_lang": "en",
                "text_tagged_users": null,
                "text_tagged_users_ids": null,
                "text_tags": null,
                "timestamp": 1762971367,
                "view_count": 78551
