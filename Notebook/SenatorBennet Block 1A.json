                "quoted_status_profile_username": null,
                "reply_count": 41,
                "retweet_count": 4,
                "source": "Twitter Web App",
                "text": "This week, when Mark and his wife checked their health care premiums for next year, they had quadrupled.\n \nWith a history of serious medical issues, Mark\u2019s family cannot go without health insurance and must now figure out how they can afford to pay over $17,000 more for their coverage next year.\n \nIt is unacceptable that Coloradans are now forced to make these decisions when their health is on the line. ACA premium tax credits are a lifeline for countless families, and we must restore them.",
                "text_lang": "en",
                "text_tagged_users": null,
                "text_tagged_users_ids": null,
                "text_tags": null,
                "timestamp": 1762375031,
                "view_count": 2736
