                "quoted_status_profile_username": null,
                "reply_count": 1,
                "retweet_count": 0,
                "source": "Twitter for iPhone",
                "text": "They believe these issues affect people\u2019s lives and that Congress should not bargain with their families' healthcare, but rather work to take care of families here in eastern North Carolina and across our country.",
                "text_lang": "en",
                "text_tagged_users": null,
                "text_tagged_users_ids": null,
                "text_tags": null,
                "timestamp": 1762382878,
                "view_count": 234
            },
