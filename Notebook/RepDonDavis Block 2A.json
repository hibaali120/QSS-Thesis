                "poll": null,
                "post_type": "post",
                "quote_count": 0,
                "quoted_status_id": null,
                "quoted_status_profile_id": null,
                "quoted_status_profile_username": null,
                "reply_count": 3,
                "retweet_count": 2,
                "source": "Twitter for iPhone",
                "text": "The battle for affordable healthcare for families in eastern North Carolina is not over. As part of a committed group of lawmakers from both sides of the aisle, we stand united, reaching out to Senate members with the genuine intention of finding a real solution to help families lower costs, so that no one loses their health insurance coverage.",
                "text_lang": "en",
                "text_tagged_users": null,
                "text_tagged_users_ids": null,
                "text_tags": null,
                "timestamp": 1763164344,
                "view_count": 290
            },
            {
                "attached_links_expanded_url": null,
                "attached_links_url": null,
                "attached_medias_preview_url": null,
                "attached_medias_url": null,
                "attached_videos": null,
                "author_id": "1610323296360210433",
                "author_username": "RepDonDavis",
                "community_notes": null,
                "conversation_id": "1990495507521699893",
                "created_time": "2025-11-17T19:01:25",
                "favorite_count": 0,
                "geo_lat": null,
                "geo_lon": null,
                "id": "1990495507521699893",
                "in_reply_to_post_id": null,
                "in_reply_to_profile_id": null,
                "in_reply_to_profile_username": null,
                "place_country_code": null,
                "place_country_name": null,
                "place_full_name": null,
                "place_type": null,
                "poll": null,
                "post_type": "post",
                "quote_count": 0,
                "quoted_status_id": null,
                "quoted_status_profile_id": null,
                "quoted_status_profile_username": null,
                "reply_count": 0,
                "retweet_count": 0,
                "source": "Twitter for iPhone",
                "text": "With the government reopened, we must not forget the fight for more affordable healthcare, which is far from over. To ensure every family has access to high-quality services, we are cosponsoring the following three bipartisan healthcare bills:\n\n\u25aa\ufe0fH.R. 4681, the Specialty Physicians Advancing Rural Care (SPARC) Act, legislation to create a student loan reimbursement program for medical specialists who agree to practice in rural areas.\n\n\u00a0\u25aa\ufe0fThe Healthy Competition for Better Care Act, legislation to promote transparency in health care, crack down on anti-competitive practices, and removes restrictions preventing competition in health care market.\n\u00a0\n\u25aa\ufe0fH.R. 5461, the Special Diabetes Program Reauthorization Act of 2025, a bill to extend the Special Diabetes Program, ensuring patients have access to the latest and most cutting-edge therapies to treat Type 1 and 2 diabetes.",
                "text_lang": "en",
                "text_tagged_users": null,
                "text_tagged_users_ids": null,
                "text_tags": null,
                "timestamp": 1763406085,
                "view_count": 299
            },
