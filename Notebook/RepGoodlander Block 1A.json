                "quoted_status_profile_username": null,
                "reply_count": 1,
                "retweet_count": 0,
                "source": "Twitter Web App",
                "text": "While big healthcare corporations put profits over We the People, non-profit community health centers are working to deliver us the healthcare we need when and where we need it.\u00a0 \n\nThat\u2019s what I saw firsthand yesterday in Franklin during my visit to HealthFirst.\u00a0And that\u2019s why I\u2019m working with every tool I\u2019ve got in Congress to protect and strengthen New Hampshire\u2019s community health centers.",
                "text_lang": "en",
                "text_tagged_users": null,
                "text_tagged_users_ids": null,
                "text_tags": null,
                "timestamp": 1758727675,
                "view_count": 303
