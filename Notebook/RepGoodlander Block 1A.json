                "quoted_status_profile_id": null,
                "quoted_status_profile_username": null,
                "reply_count": 4,
                "retweet_count": 0,
                "source": "Twitter Web App",
                "text": "Started off the day today hearing from community health providers from across New Hampshire who are on the frontlines delivering the care our communities need when they need it and where they need without breaking the bank.\n\nRepublican healthcare cuts \u2013 the biggest in history \u2013 are throwing our system into a full-blown crisis and jacking up your costs. Protecting and strengthening your healthcare means reversing these cuts, so that we can lower the sky-high costs that are crushing hardworking Americans.",
                "text_lang": "en",
                "text_tagged_users": null,
