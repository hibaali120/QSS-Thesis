                "quoted_status_id": "1658894774420611074",
                "quoted_status_profile_id": "19918875",
                "quoted_status_profile_username": "MIHospitalAssoc",
                "reply_count": 11,
                "retweet_count": 12,
                "source": "Twitter Web App",
                "text": "The ongoing shortage of cancer treatment drugs hits incredibly close to home for me \u2013 just like many of the patients waiting for their treatments today, my mom was treated for ovarian cancer. This crisis is just the latest consequence of a flawed pharmaceutical supply chain.",
                "text_lang": "en",
                "text_tagged_users": null,
                "text_tagged_users_ids": null,
                "text_tags": null,
                "timestamp": 1684439720,
                "view_count": 7828
            },
            {
                "attached_links_expanded_url": null,
                "attached_links_url": null,
                "attached_medias_preview_url": null,
                "attached_medias_url": null,
                "attached_videos": null,
                "author_id": "1078401427347857408",
                "author_username": "SenatorSlotkin",
                "community_notes": null,
                "conversation_id": "1659286567989440520",
                "created_time": "2023-05-18T19:55:20",
                "favorite_count": 12,
                "geo_lat": null,
                "geo_lon": null,
                "id": "1659286569822351367",
                "in_reply_to_post_id": "1659286567989440520",
                "in_reply_to_profile_id": "1078401427347857408",
                "in_reply_to_profile_username": "SenatorSlotkin",
                "place_country_code": null,
                "place_country_name": null,
                "place_full_name": null,
                "place_type": null,
                "poll": null,
                "post_type": "reply",
                "quote_count": 0,
                "quoted_status_id": null,
                "quoted_status_profile_id": null,
                "quoted_status_profile_username": null,
                "reply_count": 1,
                "retweet_count": 2,
                "source": "Twitter Web App",
                "text": "The fundamental issue is that we are far too dependent on foreign sources for the ingredients used in our drugs. That\u2019s why the shutdown of a factory in India due to quality and safety concerns leaves cancer patients in MI struggling to get the drugs needed for their treatment.",
                "text_lang": "en",
                "text_tagged_users": null,
                "text_tagged_users_ids": null,
                "text_tags": null,
                "timestamp": 1684439720,
                "view_count": 500
            },
            {
                "attached_links_expanded_url": null,
                "attached_links_url": null,
                "attached_medias_preview_url": null,
                "attached_medias_url": null,
                "attached_videos": null,
                "author_id": "1078401427347857408",
                "author_username": "SenatorSlotkin",
                "community_notes": null,
                "conversation_id": "1660749098436251653",
