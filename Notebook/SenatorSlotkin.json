                "quoted_status_profile_username": null,
                "reply_count": 11,
                "retweet_count": 23,
                "source": "Twitter Web App",
                "text": "I can\u2019t imagine how MI families whose loved ones\u2019 treatment has been interrupted during the ongoing cancer drug shortage must feel. I introduced the Ensuring Access to Lifesaving Drugs Act, so we can keep lifesaving drugs on the shelves during shortages. https://t.co/1LexDHQsVk",
                "text_lang": "en",
