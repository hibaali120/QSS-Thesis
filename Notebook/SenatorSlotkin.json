                "favorite_count": 10,
                "geo_lat": null,
                "geo_lon": null,
                "id": "1660749100332077062",
                "in_reply_to_post_id": "1660749098436251653",
                "in_reply_to_profile_id": "1078401427347857408",
                "in_reply_to_profile_username": "SenatorSlotkin",
                "place_country_code": null,
                "place_country_name": null,
                "place_full_name": null,
                "place_type": null,
                "poll": null,
                "post_type": "reply",
                "quote_count": 0,
                "quoted_status_id": null,
                "quoted_status_profile_id": null,
                "quoted_status_profile_username": null,
                "reply_count": 1,
                "retweet_count": 3,
                "source": "Twitter Web App",
                "text": "As someone whose mom died of ovarian cancer, I can\u2019t imagine how the families whose loved ones\u2019 treatment has been postponed due to drug shortages must feel. And while we hope the impacted drug manufacturer in India will soon be back online, there are emergency steps we can take.",
                "text_lang": "en",
                "text_tagged_users": null,
                "text_tagged_users_ids": null,
                "text_tags": null,
                "timestamp": 1684788415,
                "view_count": 596
            },
