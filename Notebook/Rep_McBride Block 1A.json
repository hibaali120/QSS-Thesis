                "quoted_status_profile_username": null,
                "reply_count": 5077,
                "retweet_count": 140,
                "source": "Twitter for iPhone",
                "text": "It\u2019s official\u2014this is the longest government shutdown in American history. The only way out is for Republicans in Congress to come to the negotiating table and tackle the real problems Americans are facing\u2014the cost of living, skyrocketing health care premiums, and an administration that\u2019s focused on bathrooms and ballrooms.",
                "text_lang": "en",
