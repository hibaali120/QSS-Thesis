                "quoted_status_profile_username": null,
                "reply_count": 16,
                "retweet_count": 3,
                "source": "Twitter Web App",
                "text": "I was extremely disappointed to learn that the U.S. Department of Agriculture has canceled $1 billion in school nutrition and emergency food funding through the Local Food for Schools and the Local Food Purchase Assistance Cooperative Agreement Programs. These agreements were a win win for school districts, emergency food providers, and ag producers, supporting local farmers and putting healthier foods in our school cafeterias. Canceling these programs is bad for students, hurts local farmers, and will make our food supply chains less resilient and more dependent on large suppliers. As food and production costs continue to rise, I urge the Trump administration to reverse course.",
                "text_lang": "en",
                "text_tagged_users": null,
                "text_tagged_users_ids": null,
                "text_tags": null,
                "timestamp": 1741712788,
                "view_count": 1226
            },
