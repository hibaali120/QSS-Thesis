                    "quoted_status_profile_id": null,
                    "quoted_status_profile_username": null,
                    "reply_count": 4,
                    "retweet_count": 1,
                    "source": "Twitter Web App",
                    "text": "Thank you for your support @RepJohnCurtis: Requiring veterans in Utah to travel hundreds of miles for eyeglass fittings is nonsense. I\u2019m pleased to support legislation making healthcare just a little more accessible for our veterans, who deserve convenient and quality care after their service to our country.",
                    "text_lang": "en",
                    "text_tagged_users": null,
                    "text_tagged_users_ids": null,
                    "text_tags": null,
                    "timestamp": 1729272673,
                    "view_count": 1077
                },
                {
                    "attached_links_expanded_url": null,
                    "attached_links_url": null,
                    "attached_medias_preview_url": null,
                    "attached_medias_url": null,
                    "attached_videos": null,
                    "author_id": "1746930615654449160",
                    "author_username": "RepMaloyUtah",
                    "community_notes": null,
                    "conversation_id": "1847324750005092420",
                    "created_time": "2024-10-18T17:30:09",
                    "favorite_count": 1,
                    "geo_lat": null,
                    "geo_lon": null,
                    "id": "1847329335281098863",
                    "in_reply_to_post_id": "1847324750005092420",
                    "in_reply_to_profile_id": "1746930615654449160",
                    "in_reply_to_profile_username": "RepMaloyUtah",
                    "place_country_code": null,
                    "place_country_name": null,
                    "place_full_name": null,
                    "place_type": null,
                    "poll": null,
                    "post_type": "reply",
                    "quote_count": 0,
                    "quoted_status_id": null,
                    "quoted_status_profile_id": null,
                    "quoted_status_profile_username": null,
                    "reply_count": 0,
                    "retweet_count": 0,
                    "source": "Twitter Web App",
                    "text": "Thank you for your support @RepLCD: I\u2019ve heard from many Central Oregon veterans concerned with a lack of accessible health care. Supporting community care fixes this problem by allowing them to find care in their communities without traveling to a VA facility. I\u2019m proud to cosponsor the SEE Act, which would improve eye care options for our nation\u2019s veterans by expanding community care coverage",
                    "text_lang": "en",
                    "text_tagged_users": [
                        "RepLCD"
                    ],
                    "text_tagged_users_ids": [
                        "1583530102297600000"
                    ],
                    "text_tags": null,
                    "timestamp": 1729272609,
                    "view_count": 196
                },
                {
                    "attached_links_expanded_url": null,
                    "attached_links_url": null,
                    "attached_medias_preview_url": null,
                    "attached_medias_url": null,
                    "attached_videos": null,
                    "author_id": "1746930615654449160",
                    "author_username": "RepMaloyUtah",
                    "community_notes": null,
                    "conversation_id": "1847324750005092420",
                    "created_time": "2024-10-18T17:29:27",
                    "favorite_count": 0,
                    "geo_lat": null,
                    "geo_lon": null,
                    "id": "1847329158084399344",
                    "in_reply_to_post_id": "1847324750005092420",
                    "in_reply_to_profile_id": "1746930615654449160",
                    "in_reply_to_profile_username": "RepMaloyUtah",
                    "place_country_code": null,
                    "place_country_name": null,
                    "place_full_name": null,
                    "place_type": null,
                    "poll": null,
                    "post_type": "reply",
                    "quote_count": 0,
                    "quoted_status_id": null,
                    "quoted_status_profile_id": null,
                    "quoted_status_profile_username": null,
                    "reply_count": 0,
                    "retweet_count": 0,
                    "source": "Twitter Web App",
                    "text": "Thank you for your support @RepVanOrden: Veterans in rural Wisconsin should not have to drive hours to Tomah, Madison, or Milwaukee for a simple eyeglass fitting. I have made a commitment to our veterans to improve their healthcare and quality of life, and that is why I am proud to join Rep. Maloy in introducing the SEE Act. This legislation is a practical step toward ensuring veterans can access the care they deserve, without unnecessary barriers.",
                    "text_lang": "en",
                    "text_tagged_users": [
                        "RepVanOrden"
                    ],
                    "text_tagged_users_ids": [
                        "1598778014401269760"
                    ],
