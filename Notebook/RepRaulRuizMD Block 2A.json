                "quoted_status_profile_username": null,
                "reply_count": 19,
                "retweet_count": 1,
                "source": "Twitter for iPhone",
                "text": "Many federal workers have or are at risk of missing a paycheck. Many live check to check, month to month, and costs are still rising, job losses are going up, and the economy is unstable. There is urgency to open the government, protect healthcare and lower costs, and get federal workers paid immediately. \n\nThat\u2019s why I organized a virtual Government Shutdown Resource Fair to connect federal workers with community resources to meet their basic needs. The event brought together organizations offering support with finances, food, utilities, mental health, and more.",
                "text_lang": "en",
                "text_tagged_users": null,
                "text_tagged_users_ids": null,
                "text_tags": null,
