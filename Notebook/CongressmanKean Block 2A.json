                "quoted_status_profile_username": null,
                "reply_count": 4,
                "retweet_count": 2,
                "source": "Twitter for iPhone",
                "text": "When Arlene noticed her Medicare premiums were being deducted from both her federal pension and Social Security benefits, she reached out to my office. \n\nWe helped her get to the root of the issue that was causing the\u00a0double billing\u00a0and ensured she received a full refund.\n\nIf you need help with a federal agency, please don\u2019t hesitate to contact my office: https://t.co/C4xOu9EfAZ",
                "text_lang": "en",
                "text_tagged_users": null,
