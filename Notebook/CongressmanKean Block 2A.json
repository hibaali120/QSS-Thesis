                "quoted_status_profile_username": null,
                "reply_count": 3,
                "retweet_count": 1,
                "source": "Twitter Web App",
                "text": "Recently, I had the opportunity to visit residents at Avalon Assisted Living at Bridgewater during \u201cAssisted Living Week.\u201d\n\nIn Congress, I remain committed to protecting and strengthening Social Security, Medicare, and Medicaid so seniors like those I met can continue to count on them.\n\nThank you to @HCANJ for hosting and bringing together residents, families, staff, vendors, and legislators to celebrate the teamwork that makes assisted living communities feel like home.",
                "text_lang": "en",
                "text_tagged_users": null,
                "text_tagged_users_ids": null,
                "text_tags": null,
                "timestamp": 1757968228,
                "view_count": 405
