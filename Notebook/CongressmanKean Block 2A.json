                "quoted_status_profile_username": null,
                "reply_count": 3,
                "retweet_count": 0,
                "source": "Twitter Web App",
                "text": "Earlier today, I met with New Jersey members of the American Academy of Orthopaedic Surgeons (@AAOS1) in my DC office.\n\nWe discussed the state of Medicare and the quality of care it provides, ways to improve seniors\u2019 access to treatment, and my continued support for medical disease research that affects millions of Americans each year.\n\nThank you to AAOS for taking the time to meet with me.",
                "text_lang": "en",
                "text_tagged_users": [
                    "AAOS1"
                ],
                "text_tagged_users_ids": [
                    "31409605"
                ],
                "text_tags": null,
