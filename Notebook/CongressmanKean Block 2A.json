                "quoted_status_profile_id": null,
                "quoted_status_profile_username": null,
                "reply_count": 4,
                "retweet_count": 2,
                "source": "Twitter for iPhone",
                "text": "It was an honor to be recognized as the 2025 Congressional Champion of the Year by the New Jersey Hospital Association on Thursday night.\u00a0\n\u00a0\nIn Congress, I remain committed to ensuring that New Jerseyans have access to affordable, high-quality healthcare. By advancing legislation to safeguard Medicaid for its intended beneficiaries, we are protecting this vital program so it can continue to be a lifeline for current and future generations of Americans.\u00a0\n\u00a0\nThank you to @NJHospitals for this recognition and for your shared commitment to strengthening our hospitals and health systems across the state",
                "text_lang": "en",
                "text_tagged_users": null,
                "text_tagged_users_ids": null,
                "text_tags": null,
                "timestamp": 1758993045,
                "view_count": 745
            },
            {
                "attached_links_expanded_url": null,
                "attached_links_url": null,
                "attached_medias_preview_url": null,
                "attached_medias_url": null,
