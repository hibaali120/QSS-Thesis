                "quoted_status_profile_username": null,
                "reply_count": 13,
                "retweet_count": 6,
                "source": "Twitter Web App",
                "text": "The House just passed the Big Ugly Bill \u2013 and I voted NO.\n\nThis catastrophic legislation kicks 17 million Americans off their health insurance, rips food off families\u2019 tables, and adds trillions to the national debt, all to give billionaires another tax break.\n\nWe\u2019re not going to let Republicans forget this day.",
                "text_lang": "en",
