                "quoted_status_profile_username": null,
                "reply_count": 0,
                "retweet_count": 1,
                "source": "Twitter Web App",
                "text": "I joined Protect Our Care NY to mark 60 years of Medicare and Medicaid \u2013 programs that have kept generations of Americans healthy and secure.\n\nBut right now, those programs are under attack. Trump\u2019s Big Ugly Law threatens to gut health care for 17 million Americans, including tens of thousands right here in Western New York.\n\nThese cuts aren\u2019t abstract \u2013 they\u2019re personal, and they\u2019ll devastate our communities. I am fighting to #CancelTheCuts and protect the care New Yorkers rely on.",
                "text_lang": "en",
                "text_tagged_users": null,
                "text_tagged_users_ids": null,
                "text_tags": null,
                "timestamp": 1754487852,
                "view_count": 479
