                "quoted_status_profile_username": "TheBuffaloNews",
                "reply_count": 1,
                "retweet_count": 2,
                "source": "Twitter Web App",
                "text": "Tom Golisano\u2019s $50 million gift to Children\u2019s Hospital is truly monumental for Buffalo and all of Western New York.\n\nThis investment will ensure world-class medical services for children and families in our community for generations to come.\n\nOn behalf of every Western New Yorker, I look forward to the continuation of excellent and life-changing care at the Golisano Children\u2019s Hospital of Buffalo.",
                "text_lang": "en",
                "text_tagged_users": null,
                "text_tagged_users_ids": null,
                "text_tags": null,
                "timestamp": 1755629142,
                "view_count": 1027
