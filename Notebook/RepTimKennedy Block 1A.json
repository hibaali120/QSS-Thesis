                "id": "1952476379217269239",
                "in_reply_to_post_id": null,
                "in_reply_to_profile_id": null,
                "in_reply_to_profile_username": null,
                "place_country_code": null,
                "place_country_name": null,
                "place_full_name": null,
                "place_type": null,
                "poll": null,
                "post_type": "post",
                "quote_count": 0,
                "quoted_status_id": null,
                "quoted_status_profile_id": null,
                "quoted_status_profile_username": null,
                "reply_count": 1,
                "retweet_count": 3,
                "source": "Twitter Web App",
                "text": "This #NationalHealthCenterWeek, I stood with the incredible team at Neighborhood Health Center (@nhcwny)  to send a clear message: healthcare is a right, not a privilege.\n\nAs a former occupational therapist, and the son and grandson of a nurse, I\u2019ve seen the life-changing impact of quality, accessible care. Community health centers are on the frontlines, keeping our neighborhoods healthy against all odds.\n\nMeanwhile, Trump and Congressional Republicans passed over $1 trillion in healthcare cuts that will leave 17 million Americans uninsured. That\u2019s unacceptable. 285,000 people in WNY rely on Medicaid. One in eight New Yorkers depend on a community health center for care. These are our children, our seniors, our veterans, and our neighbors.\n\nWe can\u2019t let them down. I\u2019m calling on my Republican colleagues to #CanceltheCuts. Our families and health centers deserve better.",
                "text_lang": "en",
                "text_tagged_users": [
                    "nhcwny"
                ],
                "text_tagged_users_ids": [
                    "1425119278018277381"
