                "poll": null,
                "post_type": "quote",
                "quote_count": 0,
                "quoted_status_id": "1996971822848372863",
                "quoted_status_profile_id": "2467791",
                "quoted_status_profile_username": "washingtonpost",
                "reply_count": 2,
                "retweet_count": 1,
                "source": "Twitter Web App",
                "text": "Rolling back the recommendation that protects newborns from hepatitis is utterly reckless. For more than 30 years, this vaccine has nearly eliminated a deadly virus among America\u2019s children. Doctors and public health experts are clear: delaying this shot will put babies at risk, full stop.\n\nThis decision isn\u2019t based on science, and it will have life-or-death consequences. We will see hepatitis B infections rise again if we allow conspiracy to overrule science.\n\nAs a nation, we should be strengthening childhood immunization, not weakening it. I stand firmly with the medical community in condemning this move, and I\u2019ll keep fighting to make sure our kids and families stay safe.",
                "text_lang": "en",
                "text_tagged_users": null,
                "text_tagged_users_ids": null,
                "text_tags": null,
                "timestamp": 1764967744,
                "view_count": 549
