                "quoted_status_profile_id": "759251",
                "quoted_status_profile_username": "CNN",
                "reply_count": 3,
                "retweet_count": 2,
                "source": "Twitter for iPhone",
                "text": "On the same day the Trump Administration announced they\u2019re ending National Suicide Prevention Lifeline's LGBTQ support services, the Supreme Court ruled that states can interfere in private medical decisions between families, doctors, and their children.\n\nThese assaults on our children and families aren\u2019t just cruel \u2014 they\u2019re dangerous, and they will lead to more fear, more isolation, and more loss. Gender-affirming care is essential, and denying it puts lives at risk.",
                "text_lang": "en",
                "text_tagged_users": null,
                "text_tagged_users_ids": null,
                "text_tags": null,
                "timestamp": 1750367106,
                "view_count": 705
