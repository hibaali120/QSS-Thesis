                "quoted_status_profile_username": null,
                "reply_count": 0,
                "retweet_count": 2,
                "source": "Twitter for iPhone",
                "text": "This isn\u2019t a budget \u2014 it\u2019s a blueprint for dismantling democracy and silencing accountability.\n\u2028\u2192 Undermines the courts.\u2028\u2192 Blocks AI oversight.\u2028\u2192 Rewards gun lobbyists.\u2028\u2192 Punishes student borrowers.\u2028\u2192 Attacks reproductive health.\u2028\u2192 Empowers political retaliation.\n\n(8/8)",
                "text_lang": "en",
