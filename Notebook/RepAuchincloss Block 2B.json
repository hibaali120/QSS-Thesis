                "post_type": "quote",
                "quote_count": 12,
                "quoted_status_id": "1816530337301774449",
                "quoted_status_profile_id": "1330278736554582016",
                "quoted_status_profile_username": "RepAuchincloss",
                "reply_count": 57,
                "retweet_count": 574,
                "source": "Twitter Web App",
                "text": "Democrats & Republicans negotiated a government funding bill that included overdue reforms to pharmacy benefit managers. That bipartisan legislation would rein in these drug-pricing middlemen and lower Rx drug co-pays & premiums. Then, Trump happened.\n\nGOP leadership caved to both Trump and the health insurance lobby. They crafted a partisan funding bill that caters to Trump's political needs and hands a Christmas present to the PBMs that price-gouge patients. I'm voting No.",
                "text_lang": "en",
                "text_tagged_users": null,
                "text_tagged_users_ids": null,
                "text_tags": null,
                "timestamp": 1734645056,
                "view_count": 37544
            },
