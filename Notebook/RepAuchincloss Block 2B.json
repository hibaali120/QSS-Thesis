                "quoted_status_profile_id": null,
                "quoted_status_profile_username": null,
                "reply_count": 32,
                "retweet_count": 75,
                "source": "Twitter Web App",
                "text": "Specialty steering is a one-two punch of price-gouging and self-dealing in which pharmacy benefit managers mark-up the price of generic medicines and then steer the reimbursement towards affiliated pharmacies. It raises premiums for everybody. Today's Federal Trade Commission report must galvanize Congress to finally end the abuses of drug-pricing middlemen.",
                "text_lang": "en",
                "text_tagged_users": null,
                "text_tagged_users_ids": null,
                "text_tags": null,
                "timestamp": 1736894284,
                "view_count": 9072
