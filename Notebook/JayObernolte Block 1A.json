                "quoted_status_profile_username": null,
                "reply_count": 8,
                "retweet_count": 1,
                "source": "Twitter Web App",
                "text": "I am delighted that the Lower Health Care Premiums for All Americans Act passed the House last night with my strong support. This bill will lower health care costs by expanding access to association health plans, strengthening CHOICE arrangements to give workers more flexibility, requiring transparency from pharmacy benefit managers to lower drug costs, and fixing policies that drive premiums higher.  The CBO estimates that these changes alone will reduce ACA health insurance premiums by an average of 11%. Families and small businesses deserve high-quality affordable health care, and I will continue fighting too ensure they have it.",
                "text_lang": "en",
                "text_tagged_users": null,
                "text_tagged_users_ids": null,
                "text_tags": null,
