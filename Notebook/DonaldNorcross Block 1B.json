                "quoted_status_profile_username": null,
                "reply_count": 1,
                "retweet_count": 0,
                "source": "Buffer",
                "text": "We need to be expanding access to lifesaving treatment. That\u2019s why I introduced the bipartisan Modernizing Opioid Treatment Access Act. This bill will break down barriers to treatment by allowing doctors to prescribe methadone and pharmacies to dispense it. We've got to do all we can to make treatment more accessible, before it\u2019s too late.",
                "text_lang": "en",
                "text_tagged_users": null,
                "text_tagged_users_ids": null,
                "text_tags": null,
                "timestamp": 1746554589,
                "view_count": 155
