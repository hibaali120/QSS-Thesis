                "id": "1973036967886520525",
                "in_reply_to_post_id": null,
                "in_reply_to_profile_id": null,
                "in_reply_to_profile_username": null,
                "place_country_code": null,
                "place_country_name": null,
                "place_full_name": null,
                "place_type": null,
                "poll": null,
                "post_type": "quote",
                "quote_count": 0,
                "quoted_status_id": "1972718744121041352",
                "quoted_status_profile_id": "1674861136498286605",
                "quoted_status_profile_username": "WesternLensman",
                "reply_count": 5,
                "retweet_count": 1,
                "source": "Twitter Web App",
                "text": "The American people can decide for themselves.\n\nHere\u2019s Chuck Schumer railing against a system rife with fraud that extends taxpayer-funded healthcare to illegal aliens.\n\nNow? He\u2019s threatening to shut down the government unless those very benefits are protected.\n\nThis is not negotiation. It\u2019s reckless grandstanding.\n\nHouse Republicans have already done our job. We passed a clean CR to keep America open, safe, and secure.",
                "text_lang": "en",
                "text_tagged_users": null,
                "text_tagged_users_ids": null,
                "text_tags": null,
                "timestamp": 1759243645,
                "view_count": 675
            },
            {
                "attached_links_expanded_url": null,
                "attached_links_url": null,
                "attached_medias_preview_url": null,
                "attached_medias_url": null,
                "attached_videos": null,
                "author_id": "1872324445055987712",
                "author_username": "RepBobOnder",
                "community_notes": null,
