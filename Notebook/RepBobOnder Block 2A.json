                "quoted_status_profile_username": null,
                "reply_count": 6,
                "retweet_count": 8,
                "source": "Twitter Web App",
                "text": "All businesses deserve the ability to choose the best healthcare plan possible for them and their employees. That's why I was proud to hold a vote on my bill, the Self Insurance Protection Act, in @EdWorkforceCmte, to ensure small businesses retain equal access to stop-loss insurance plans.",
                "text_lang": "en",
