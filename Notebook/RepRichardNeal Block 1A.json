                "quoted_status_profile_username": null,
                "reply_count": 3,
                "retweet_count": 1,
                "source": "Twitter Web App",
                "text": "Tomorrow marks the start of open enrollment\u2014and for 24 million Americans, it also marks the largest spike in health insurance costs in more than a decade.\n\nWhen you can deliver tax cuts for the wealthiest Americans but fail to deliver affordable health care to everyday Americans, that's not leadership\u2014that's an abdication of responsibility.\n\nMy full statement: https://t.co/UIdjNXDGtm",
                "text_lang": "en",
                "text_tagged_users": null,
                "text_tagged_users_ids": null,
                "text_tags": null,
                "timestamp": 1761934675,
                "view_count": 535
            },
            {
