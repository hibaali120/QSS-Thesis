                "quoted_status_id": null,
                "quoted_status_profile_id": null,
                "quoted_status_profile_username": null,
                "reply_count": 5,
                "retweet_count": 3,
                "source": "Twitter Web App",
                "text": "This week, Democrats were in D.C. to do the work the American people elected us to do\u2014legislate. Where were our Republican colleagues?\n\nWe will not be party to a blatant attack on Americans that is ripping health care from 15 million and causing the highest healthcare premium hike in 15 years.\n\nIt's time to end the chaos, cancel the cuts, lower costs, and save health care.",
                "text_lang": "en",
                "text_tagged_users": null,
                "text_tagged_users_ids": null,
                "text_tags": null,
                "timestamp": 1760627277,
                "view_count": 1083
            },
            {
                "attached_links_expanded_url": null,
                "attached_links_url": null,
                "attached_medias_preview_url": null,
                "attached_medias_url": null,
                "attached_videos": null,
                "author_id": "442824717",
