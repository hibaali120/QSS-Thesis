                "quoted_status_profile_username": null,
                "reply_count": 8,
                "retweet_count": 4,
                "source": "Twitter Web App",
                "text": "Last night, House Republicans sold out the American people. By voting for the largest Medicaid cut in our nation\u2019s history, over 200,000 people on Medicaid in our district are now at risk of losing their health care. House Republicans voted to raise health care premiums by almost $3,000/year for the 38,000 people in our district who receive coverage under the Affordable Care Act. House Republicans also voted to slash food and nutrition assistance funding for 35,000 people in our district.\n\nThis reckless Republican budget is an outright betrayal of the American people,  and I will continue to fight alongside @HouseDemocrats to protect the quality of life of America\u2019s working families.",
                "text_lang": "en",
                "text_tagged_users": null,
                "text_tagged_users_ids": null,
                "text_tags": null,
                "timestamp": 1740603429,
                "view_count": 793
