                "quoted_status_profile_username": "SenWarren",
                "reply_count": 121,
                "retweet_count": 874,
                "source": "Twitter for iPhone",
                "text": "You say Republicans \"won't even come to the table\" on healthcare?\n\nWe're AT the table. We just won't agree to:\n\n\u274c$200B for illegal alien healthcare\n\u274cCutting $50B from rural American hospitals\n\u274c$500M for liberal news outlets\n\u274c$4M for \"global LGBTQI+ awareness\" campaigns\n\u274c$4M for \"LGBTQI+ democracy grants\" in the Balkans\n\u274c$2M for \"feminist democratic principles\" in Africa\n\u274cPermanent COVID subsidies without reforms\n\u274cFunding foreign programs while Americans suffer\n\nHow out of touch are you that you call THAT a healthcare plan?",
                "text_lang": "en",
                "text_tagged_users": null,
                "text_tagged_users_ids": null,
                "text_tags": null,
                "timestamp": 1761076944,
                "view_count": 40859
