                "quoted_status_profile_username": null,
                "reply_count": 25,
                "retweet_count": 1,
                "source": "Twitter for iPhone",
                "text": "Arizonans are suffering from an affordability crisis, driven by Trump\u2019s tariffs and failed economic policies. \n\nGrocery prices are up. Electricity prices are up. Now AZ families and small business owners are set to see their out-of-pocket health insurance premiums go up by thousands of dollars.\n\nThis proposal fails to reduce costs for Arizonans. Because of this, I cannot support it.",
                "text_lang": "en",
                "text_tagged_users": null,
                "text_tagged_users_ids": null,
                "text_tags": null,
                "timestamp": 1762807972,
                "view_count": 999
