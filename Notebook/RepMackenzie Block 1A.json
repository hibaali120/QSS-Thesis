                "quoted_status_profile_username": null,
                "reply_count": 3,
                "retweet_count": 2,
                "source": "Twitter for iPhone",
                "text": "Last night, I attended the Maternal Mental Health congressional reception. As a dad to a one-year-old with another on the way, this issue is personal to me. Too many mothers face preventable risks that can lead to tragedy.\n\u00a0\nThat\u2019s why I\u2019ve made maternal health a priority in Congress, co-leading the Preventing Maternal Deaths Reauthorization Act of 2025 and building on my work in the Pennsylvania State House, where I authored the law creating our state\u2019s Maternal Mortality Review Committee. I\u2019ll keep fighting to support mothers and families in the Lehigh Valley and the Poconos and across the nation.",
                "text_lang": "en",
                "text_tagged_users": null,
                "text_tagged_users_ids": null,
