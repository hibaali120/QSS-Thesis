                "quoted_status_profile_id": null,
                "quoted_status_profile_username": null,
                "reply_count": 39,
                "retweet_count": 6,
                "source": "Twitter for iPhone",
                "text": "Missouri stands to lose $2B/year under GOP\u2019s proposed $880B Medicaid cuts\u2014jeopardizing care for 1.3M residents, including 329K from our 2021 expansion. These cuts threaten rural hospitals, seniors, and working families. \n\nIn St. Louis, that means more ER visits, more suffering, and fewer options for the most vulnerable. I\u2019m fighting to stop this and will continue defending MO HealthNet. Every Missourian must retain access to essential healthcare.",
                "text_lang": "en",
                "text_tagged_users": null,
