                "retweet_count": 2,
                "source": "Twitter for iPhone",
                "text": "The Republican budget is a disaster for Missouri families. Under their plan, 59,000 people in St. Louis will see their Affordable Care Act premiums rise by 70%. A 60-year-old couple could pay $12,750 more per year.\n\nThis is unacceptable. We must protect affordable health care",
                "text_lang": "en",
                "text_tagged_users": null,
                "text_tagged_users_ids": null,
                "text_tags": null,
