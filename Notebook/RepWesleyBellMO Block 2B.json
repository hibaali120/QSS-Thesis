                "quoted_status_profile_username": null,
                "reply_count": 1,
                "retweet_count": 2,
                "source": "Twitter for iPhone",
                "text": "Today, I had the honor of meeting with the St. Louis Anchor Network \u2014 a coalition of hospitals, universities, businesses, and community groups dedicated to uplifting historically disinvested communities across our region.\n\nWe discussed how anchor institutions can drive inclusive economic growth by investing in local talent, small businesses, and neighborhoods. When we center equity, everyone benefits.\n\nProud to support their mission to create pathways to opportunity for all St. Louisans. Let\u2019s keep building together.",
                "text_lang": "en",
                "text_tagged_users": null,
                "text_tagged_users_ids": null,
