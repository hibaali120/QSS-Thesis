                "quoted_status_profile_username": null,
                "reply_count": 3,
                "retweet_count": 6,
                "source": "Twitter Web App",
                "text": "President Trump's \"One, Big, Beautiful Bill\" makes crop insurance more affordable at higher levels of coverage.\n\nThat means, when severe weather strikes, farmers are protected from devastating losses out of their control.\n\nPresident Trump is a true friend of our farmers!",
                "text_lang": "en",
                "text_tagged_users": null,
                "text_tagged_users_ids": null,
                "text_tags": null,
                "timestamp": 1751295497,
                "view_count": 1444
