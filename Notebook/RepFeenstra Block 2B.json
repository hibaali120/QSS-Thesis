                "quoted_status_profile_username": null,
                "reply_count": 3,
                "retweet_count": 5,
                "source": "Twitter for iPhone",
                "text": "As part of the package of tax cuts that Republicans passed and President Trump signed for working families, we included $50 billion for rural hospitals and healthcare.\n\nThis infusion will improve patient care and keep our rural healthcare facilities open.\nhttps://t.co/m8qmZUvNk0",
