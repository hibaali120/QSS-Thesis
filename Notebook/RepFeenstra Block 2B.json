                "quoted_status_profile_username": null,
                "reply_count": 1,
                "retweet_count": 3,
                "source": "Twitter Web App",
                "text": "Receiving a cancer diagnosis is devastating news for patients and scary for families. \n\nBut, via early detection, there's real hope for recovery.\n\nIt\u2019s why I voted to expand early detection screenings for many types of cancer so that we can catch cancer when it's most treatable. https://t.co/ApSm0Xrdyf",
                "text_lang": "en",
                "text_tagged_users": null,
                "text_tagged_users_ids": null,
                "text_tags": null,
                "timestamp": 1758125579,
                "view_count": 1057
            },
