                "quote_count": 18,
                "quoted_status_id": null,
                "quoted_status_profile_id": null,
                "quoted_status_profile_username": null,
                "reply_count": 144,
                "retweet_count": 1072,
                "source": "Twitter Web App",
                "text": "The bill we just voted on to fund the Department of Defense provided $8 billion MORE than even requested.\n\nWhat that means is Congress is offering up billions in extra money for weapons of war but nickel and diming people for basic healthcare.\n\nIt's past time to rethink our priorities. I voted no.",
                "text_lang": "en",
                "text_tagged_users": null,
                "text_tagged_users_ids": null,
                "text_tags": null,
                "timestamp": 1765406086,
                "view_count": 34006
            },
