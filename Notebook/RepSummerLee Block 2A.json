                "id": "1998514996188254602",
                "in_reply_to_post_id": null,
                "in_reply_to_profile_id": null,
                "in_reply_to_profile_username": null,
                "place_country_code": null,
                "place_country_name": null,
                "place_full_name": null,
                "place_type": null,
                "poll": null,
                "post_type": "post",
                "quote_count": 46,
                "quoted_status_id": null,
                "quoted_status_profile_id": null,
                "quoted_status_profile_username": null,
                "reply_count": 780,
                "retweet_count": 212,
                "source": "Twitter Web App",
                "text": "We have a broken healthcare system that must be fixed, but the solution in the short-term isn't to deny people of the ACA tax credits that they rely on. \n\nWe must extend these subsidies so people aren't kicked off their healthcare next month, *and* we need Medicare for All so that people aren't forced to choose between healthcare and other basic necessities.",
                "text_lang": "en",
                "text_tagged_users": null,
                "text_tagged_users_ids": null,
                "text_tags": null,
                "timestamp": 1765318080,
                "view_count": 21086
            },
            {
