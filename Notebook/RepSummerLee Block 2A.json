                "quoted_status_profile_username": null,
                "reply_count": 2,
                "retweet_count": 5,
                "source": "Twitter Web App",
                "text": "There is nothing in this bill that guarantees healthcare subsidies will be voted on and passed.\n\nThe American people want a government that serves them and a Democratic party that fights for them, especially at a time when we face rising authoritarianism and overburdening costs.",
                "text_lang": "en",
                "text_tagged_users": null,
                "text_tagged_users_ids": null,
                "text_tags": null,
                "timestamp": 1762997582,
                "view_count": 1162
            },
            {
