                "quoted_status_profile_username": null,
                "reply_count": 403,
                "retweet_count": 64,
                "source": "Twitter Web App",
                "text": "My constituent traveled to DC from Pittsburgh to share how the Republican-manufactured healthcare crisis and increased premiums will harm her as a small business owner.\n\nI'm grateful to Tori for coming to share her story, because we know thousands of others in Western PA face the same challenges.",
                "text_lang": "en",
                "text_tagged_users": null,
                "text_tagged_users_ids": null,
                "text_tags": null,
