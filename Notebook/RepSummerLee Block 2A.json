                "quoted_status_profile_id": "16635277",
                "quoted_status_profile_username": "Acyn",
                "reply_count": 164,
                "retweet_count": 102,
                "source": "Twitter Web App",
                "text": "Lower costs and bigger paychecks for who exactly? He's calling affordability a Democratic hoax while kicking millions off healthcare and SNAP.\n\nCosts are too high for everyone. We all suffer when bad actors like Trump refuse to address the burdens of working people here in PA.",
                "text_lang": "en",
                "text_tagged_users": null,
                "text_tagged_users_ids": null,
                "text_tags": null,
                "timestamp": 1765331112,
                "view_count": 31487
