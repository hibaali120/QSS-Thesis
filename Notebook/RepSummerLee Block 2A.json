                "post_type": "post",
                "quote_count": 2,
                "quoted_status_id": null,
                "quoted_status_profile_id": null,
                "quoted_status_profile_username": null,
                "reply_count": 168,
                "retweet_count": 19,
                "source": "Twitter Web App",
                "text": "The Trump admin says your healthcare premiums will only go up $13\u2013\u2013a straight up lie.\n\nIn PA, folks are already seeing their premiums will double or even triple starting in January, costing thousands more per year.\n\nIt's clear the cruelty is the point.\n\nhttps://t.co/1a7qR2CySP",
                "text_lang": "en",
                "text_tagged_users": null,
                "text_tagged_users_ids": null,
                "text_tags": null,
                "timestamp": 1765302848,
                "view_count": 4201
            },
            {
