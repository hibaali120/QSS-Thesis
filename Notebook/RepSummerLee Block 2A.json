                "quoted_status_profile_username": null,
                "reply_count": 2,
                "retweet_count": 6,
                "source": "Twitter Web App",
                "text": "I could not in good faith support capitulating to false promises that will hurt people in the long run. We live in the wealthiest country on the planet and should not have to choose between healthcare over any other essential need.",
