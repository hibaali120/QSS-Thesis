                "quoted_status_profile_username": null,
                "reply_count": 3,
                "retweet_count": 2,
                "source": "Twitter for iPhone",
                "text": "Today, we celebrate our Certified Nurses! With over three decades in health care - as a licensed nursing home administrator, Board Certified Family Nurse Practitioner, and Board Certified Psychiatric Mental Health Nurse Practitioner - I\u2019ve seen firsthand the care and love that nurses provide to their patients.\n\nYour dedication and hard work do not go unnoticed, and we are truly grateful for all that you do! \ud83e\ude7a\ud83d\udc99 \n\n#NationalCertifiedNursesDay #ThankYouNurses",
                "text_lang": "en",
