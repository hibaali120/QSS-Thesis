                "quoted_status_profile_username": null,
                "reply_count": 19,
                "retweet_count": 5,
                "source": "Twitter Web App",
                "text": "Families are the foundation of our economy, yet too many face financial hardship due to skyrocketing healthcare costs. Medical bills are cited as the leading cause of over 66% of personal bankruptcies in the U.S. It\u2019s time for change.\n\nCurrently, Americans under 55 are restricted from contributing to their spouse\u2019s Health Savings Account (HSA). This policy doesn\u2019t make sense\u2013and it\u2019s holding families back.\n\nToday, @RepFrenchHill and I introduced the Catch-Up Act, a bill that will empower all Americans to contribute to their spouse\u2019s HSA, regardless of age.\n\nThis crucial step will promote financial security and ensure that healthcare is more accessible and affordable for everyone.\n\nhttps://t.co/1ApjCowqYZ",
                "text_lang": "en",
                "text_tagged_users": null,
                "text_tagged_users_ids": null,
                "text_tags": null,
                "timestamp": 1744142440,
                "view_count": 2577
