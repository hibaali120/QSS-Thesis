                "quoted_status_profile_username": null,
                "reply_count": 0,
                "retweet_count": 0,
                "source": "Twitter for iPhone",
                "text": "Today I proposed an amendment to guarantee that veterans who depend on Medicaid don\u2019t lose coverage. \n\nEvery single Republican voted against it. \n \nUnlike my Republican colleagues, I am willing to keep our country\u2019s promises to those who served. https://t.co/GYxP0XuDaT",
                "text_lang": "en",
                "text_tagged_users": null,
                "text_tagged_users_ids": null,
                "text_tags": null,
                "timestamp": 1746561808,
                "view_count": 197
