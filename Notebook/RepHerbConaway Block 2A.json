                "quoted_status_profile_username": null,
                "reply_count": 3,
                "retweet_count": 1,
                "source": "Twitter for iPhone",
                "text": "I don\u2019t know any doctors who would say taking away someone\u2019s healthcare was a good idea. Yet Republican have proposed $880 billion in Medicaid cuts in order to fund tax breaks for the 1%. \n\nI stood alongside my fellow Dem Doctors in Congress to protest these cuts and defend Medicaid.",
                "text_lang": "en",
                "text_tagged_users": null,
                "text_tagged_users_ids": null,
                "text_tags": null,
                "timestamp": 1746637344,
                "view_count": 1608
