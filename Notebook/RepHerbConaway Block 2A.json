                "quoted_status_profile_username": null,
                "reply_count": 2,
                "retweet_count": 2,
                "source": "Twitter for iPhone",
                "text": "Today is Medicaid Matters Day of Action. I visited VNACJ Community Health Center & discussed the importance of Medicaid in providing cost-effective and affordable care to patients.\n\n106,643 people in our district rely on Medicaid. The current Republican budget proposal would rip billions of dollars away from Medicaid in order to fund tax cuts for their billionaire friends. \n\nWe can't let these cuts go through--lives depend on it.",
                "text_lang": "en",
                "text_tagged_users": null,
                "text_tagged_users_ids": null,
                "text_tags": null,
                "timestamp": 1744921992,
                "view_count": 410
            },
            {
                "attached_links_expanded_url": null,
                "attached_links_url": null,
