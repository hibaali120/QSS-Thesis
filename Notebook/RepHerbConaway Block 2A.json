                "quoted_status_profile_username": "crampell",
                "reply_count": 0,
                "retweet_count": 0,
                "source": "Twitter for iPhone",
                "text": "I don\u2019t know any doctor who would think it was a good idea to take away food and healthcare for children.\n\nPreventative care is the most cost-efficient form of healthcare. And when it comes to our young people, investing in their health now saves government dollars down the line. \n\nThis is not efficiency. Who does this benefit?",
                "text_lang": "en",
                "text_tagged_users": null,
                "text_tagged_users_ids": null,
                "text_tags": null,
                "timestamp": 1745076965,
                "view_count": 289
