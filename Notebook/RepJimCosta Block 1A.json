                "quoted_status_profile_username": null,
                "reply_count": 0,
                "retweet_count": 2,
                "source": "Twitter for iPhone",
                "text": "Today, I took to the House floor to call attention to the growing affordability and health care crisis facing our nation.\u00a0\n\u00a0\nIn just four weeks, the ACA\u2019s enhanced premium tax credits are set to expire. If that happens, 22,000 people in my district will face higher health care costs.\u00a0\n\u00a0\nAt a time when families are already stretched thin, this is unacceptable. We need a bipartisan solution to extend these credits and deliver affordable care for the American people.",
                "text_lang": "en",
                "text_tagged_users": null,
                "text_tagged_users_ids": null,
                "text_tags": null,
                "timestamp": 1764803911,
                "view_count": 221
