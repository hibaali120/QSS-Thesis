                "quoted_status_profile_username": null,
                "reply_count": 0,
                "retweet_count": 0,
                "source": "Twitter for iPhone",
                "text": "Since the discovery of the illegal lab in Reedley, I\u2019ve been working closely with local, state, and federal leaders to strengthen safeguards that protect our communities.\n\nThat\u2019s why I\u2019m proud to introduce the Preventing Illegal Laboratories and Protecting Public Health Act of 2025, alongside @RepDavidValadao and @RepKiley to close regulatory gaps and prevent bad actors from taking advantage of our public health system.\n\nThis legislation strengthens tracking, improves oversight of those handling infectious diseases, and ensures deeper cooperation between all levels of government to keep our communities safe.",
                "text_lang": "en",
                "text_tagged_users": null,
