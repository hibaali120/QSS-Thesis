                "quoted_status_profile_username": null,
                "reply_count": 0,
                "retweet_count": 0,
                "source": "Twitter Web App",
                "text": "Visiting The Arc of Washington County, Inc. reminded me of the incredible individuals they support and the life-changing impact of their programs. \n\nThe recent Big Budget Bill, now law, includes Medicaid cuts that threaten this vital care\u2014but I am fighting in Congress to lessen their impact and ultimately reverse them. This is about our values, and I strongly believe that everyone deserves the support to live with dignity and independence. \nhttps://t.co/z8kYtBsX88",
                "text_lang": "en",
                "text_tagged_users": null,
                "text_tagged_users_ids": null,
                "text_tags": null,
