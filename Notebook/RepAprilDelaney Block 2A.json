                "quoted_status_profile_username": null,
                "reply_count": 0,
                "retweet_count": 0,
                "source": "Twitter Web App",
                "text": "But because of this reckless budget bill (now law), 32,000 Marylanders in our 6th District are projected to lose Medicaid over the next decade. That\u2019s thousands of neighbors, parents and children who could be left without care.\n\nI will not stop fighting to protect Medicaid and the dignity of every Maryland family.",
                "text_lang": "en",
                "text_tagged_users": null,
                "text_tagged_users_ids": null,
                "text_tags": null,
                "timestamp": 1757345251,
                "view_count": 112
