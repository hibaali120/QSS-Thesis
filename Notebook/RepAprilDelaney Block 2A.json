                "quoted_status_profile_id": null,
                "quoted_status_profile_username": null,
                "reply_count": 0,
                "retweet_count": 0,
                "source": "Twitter for iPhone",
                "text": "Today I joined @GovWesMoore at Montgomery County Health Department\u2019s Silver Spring Center, standing up to protect healthcare and cuts to Medicaid access and other critical services. Failure to extend ACA tax credits will impact the ability of our rural health providers to remain open and result in the almost doubling of health premiums for everyone. This is about our values and who we are as Americans, and I will not let our state and your needs be held hostage to partisanship, retribution and cruel hearted cuts. In Maryland, we leave no one behind.",
                "text_lang": "en",
                "text_tagged_users": [
                    "GovWesMoore"
                ],
                "text_tagged_users_ids": [
                    "1617901640274837504"
                ],
                "text_tags": null,
                "timestamp": 1759526273,
                "view_count": 177
            },
            {
                "attached_links_expanded_url": [
