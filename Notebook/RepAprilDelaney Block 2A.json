                "quoted_status_profile_username": null,
                "reply_count": 0,
                "retweet_count": 3,
                "source": "Twitter for iPhone",
                "text": "Glad to sit down today with @GovWesMoore at the U.S. Capitol. As Team Maryland, we discussed @fema aid for Mountain Maryland, support for our farmers and rural areas, investments in infrastructure and pushing back against harmful cuts to Medicaid, SNAP and the vital services Marylanders rely on every day. \n\nMaryland, like every state, is facing some incredible challenges, but we are strong and united in purpose. Under Governor Moore\u2019s exceptional leadership, we can meet this moment together to ensure that all our communities continue to thrive and that \u201cno one is left behind.\u201d",
                "text_lang": "en",
                "text_tagged_users": [
                    "GovWesMoore",
                    "fema"
                ],
                "text_tagged_users_ids": [
                    "1617901640274837504",
                    "16669075"
