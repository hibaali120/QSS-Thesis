                "quoted_status_profile_username": "BaltimoreBanner",
                "reply_count": 2,
                "retweet_count": 1,
                "source": "Twitter for iPhone",
                "text": "In Maryland\u2019s 6th District, 1 in 3 kids rely on Medicaid. Thousands more rely on SNAP to get enough to eat.\n\nWe should never accept a country where a child goes hungry or without care. Our values demand better.\n\nI\u2019m fighting back against these cruel cuts\u2014because our kids deserve a future we can be proud of.",
                "text_lang": "en",
                "text_tagged_users": null,
                "text_tagged_users_ids": null,
                "text_tags": null,
