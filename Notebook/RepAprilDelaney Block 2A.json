                "quoted_status_profile_username": null,
                "reply_count": 0,
                "retweet_count": 2,
                "source": "Twitter Web App",
                "text": "Last week, I visited Garrett Regional Medical Center to discuss federal healthcare challenges with CEO Mark Boucot and the hospital leadership. GRMC serves over 46,000 Marylanders, many of whom rely on Medicaid, and one of my biggest priorities in Congress is to ensure that our rural hospitals have the resources they need to serve their local communities. \n\nRecent cuts to Medicaid and new adjustments to reimbursement formulas are of great concern to our health providers nationally, and I want to make sure Garrett County is continued to be blessed by GRMC and other local providers that serve their community with great heart and dedication. @mhaonline",
                "text_lang": "en",
                "text_tagged_users": null,
                "text_tagged_users_ids": null,
                "text_tags": null,
                "timestamp": 1756924477,
                "view_count": 247
            },
