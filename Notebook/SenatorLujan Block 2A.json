                "quoted_status_profile_username": null,
                "reply_count": 51,
                "retweet_count": 151,
                "source": "Twitter for iPhone",
                "text": "Once again, in the dead of night, Republicans released their tax scam bill. This version is worse than the House version. It still throws millions of Americans off their health insurance, threatens to end SNAP, and adds trillions of debt. They think Americans will \u201cget over it\u201d. We won\u2019t and I\u2019ll be raising my voice in the Senate.",
                "text_lang": "en",
                "text_tagged_users": null,
                "text_tagged_users_ids": null,
                "text_tags": null,
                "timestamp": 1751124741,
                "view_count": 5769
