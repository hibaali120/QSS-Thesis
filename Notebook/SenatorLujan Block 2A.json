                "quoted_status_profile_id": null,
                "quoted_status_profile_username": null,
                "reply_count": 9,
                "retweet_count": 4,
                "source": "Twitter Web App",
                "text": "This is Julee from Las Cruces. Julee traveled all the way from New Mexico to D.C. to tell Congress not to mess with her family's Medicaid. When her son\u2019s mental health care was cut through his Medicaid, she lost her son. Soon after that, her daughter was diagnosed with an unexpected medical condition that required immediate attention. Without Medicaid and the medical services it helped her daughter receive, she may have lost her daughter, too.\n\nMedicaid saves lives.",
                "text_lang": "en",
                "text_tagged_users": null,
                "text_tagged_users_ids": null,
                "text_tags": null,
                "timestamp": 1750970813,
                "view_count": 1349
