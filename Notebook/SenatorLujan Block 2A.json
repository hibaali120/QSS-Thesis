                "quoted_status_profile_username": null,
                "reply_count": 4,
                "retweet_count": 5,
                "source": "Twitter Web App",
                "text": "Without Medicaid, Karisa never could have afforded the surgeries that saved her daughter\u2019s life. Now, her daughter isn\u2019t just surviving \u2013 she\u2019s thriving. https://t.co/Mac9gNAviL",
