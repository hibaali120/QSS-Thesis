                "quoted_status_profile_id": null,
                "quoted_status_profile_username": null,
                "reply_count": 33,
                "retweet_count": 29,
                "source": "Twitter Web App",
                "text": "Cancer is personal to many of us. I lost my dad to lung cancer.\n\nEliminating every member of the panel that helps guarantee insurance coverage for cancer screenings and other preventive care is dangerously irresponsible.\n\nPreventive screenings save lives and reduce costs. We should be strengthening access to care \u2013 not dismantling it.",
                "text_lang": "en",
                "text_tagged_users": null,
                "text_tagged_users_ids": null,
                "text_tags": null,
                "timestamp": 1753814583,
                "view_count": 5667
