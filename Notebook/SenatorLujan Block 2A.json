                "favorite_count": 10,
                "geo_lat": null,
                "geo_lon": null,
                "id": "1951401187187761305",
                "in_reply_to_post_id": null,
                "in_reply_to_profile_id": null,
                "in_reply_to_profile_username": null,
                "place_country_code": null,
                "place_country_name": null,
                "place_full_name": null,
                "place_type": null,
                "poll": null,
                "post_type": "post",
                "quote_count": 2,
                "quoted_status_id": null,
                "quoted_status_profile_id": null,
                "quoted_status_profile_username": null,
                "reply_count": 3,
                "retweet_count": 1,
                "source": "Twitter for iPhone",
                "text": "Americans on Medicaid and Medicare deserve access to the full range of obesity treatments \u2013 one of the leading causes of preventable death in the U.S. \n\nThat\u2019s why I introduced a bipartisan bill with @SenBillCassidy to provide regular screenings and expand coverage for medications and behavioral therapy. These treatments are effective, and expanding access will save lives and reduce long-term health care costs. This is an important step.",
                "text_lang": "en",
                "text_tagged_users": [
                    "SenBillCassidy"
                ],
                "text_tagged_users_ids": [
                    "1017500185356853248"
                ],
                "text_tags": null,
                "timestamp": 1754085272,
                "view_count": 515
