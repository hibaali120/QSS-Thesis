                "poll": null,
                "post_type": "post",
                "quote_count": 0,
                "quoted_status_id": null,
                "quoted_status_profile_id": null,
                "quoted_status_profile_username": null,
                "reply_count": 4,
                "retweet_count": 0,
                "source": "Twitter for iPhone",
                "text": "I am proud to have secured $2,000,000 in federal funding for Webb County\u2019s Veterans Treatment Program (VTP), which I announced last year. Provided over a five-year period, this funding is expanding the Veterans Treatment Court Program to help veterans overcome substance abuse and mental health challenges through treatment, education, and rehabilitation services.\n\nIt also extends support to veterans in five neighboring rural counties\u2014Zapata, Jim Hogg, Starr, Duval, and Jim Wells\u2014where a lack of resources has left many without critical care. By reducing recidivism, improving mental health, and promoting public safety, this program is helping veterans build better lives.\n\nThank you to all the veterans in South Texas and across the nation for your service. I remain committed to ensuring you receive the care and support you deserve.",
                "text_lang": "en",
