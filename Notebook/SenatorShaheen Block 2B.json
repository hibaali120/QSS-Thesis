                "attached_links_url": null,
                "attached_medias_preview_url": [
                    "https://pbs.twimg.com/media/G7MnXx5WQAAL5AQ.png?name=small"
                ],
                "attached_medias_url": [
                    "https://pbs.twimg.com/media/G7MnXx5WQAAL5AQ.png"
                ],
                "attached_videos": null,
                "author_id": "109287731",
                "author_username": "SenatorShaheen",
                "community_notes": null,
                "conversation_id": "1995982638289400209",
                "created_time": "2025-12-02T22:25:19",
                "favorite_count": 3,
                "geo_lat": null,
                "geo_lon": null,
                "id": "1995982638289400209",
                "in_reply_to_post_id": null,
                "in_reply_to_profile_id": null,
