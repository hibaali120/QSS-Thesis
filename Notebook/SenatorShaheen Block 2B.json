                "quoted_status_profile_username": null,
                "reply_count": 13,
                "retweet_count": 5,
                "source": "Twitter Web App",
                "text": "With open enrollment underway, millions of Americans are facing skyrocketing health care premiums.\n\nWe can still take action to extend the ACA tax credits and deliver relief to families trying to get by. It's time for my Republican colleagues to deliver for their constituents.",
                "text_lang": "en",
                "text_tagged_users": null,
                "text_tagged_users_ids": null,
                "text_tags": null,
                "timestamp": 1764188520,
                "view_count": 1695
            },
            {
