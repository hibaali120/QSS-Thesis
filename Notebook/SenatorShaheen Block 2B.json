                "quoted_status_id": "1996631790283370998",
                "quoted_status_profile_id": "73238146",
                "quoted_status_profile_username": "SenateDems",
                "reply_count": 70,
                "retweet_count": 11,
                "source": "Twitter Web App",
                "text": "With premiums set to double in a matter of weeks, Congress must extend this lifeline for working families. That\u2019s exactly what this bill would do by providing the certainty of the ACA tax credits for another three years.",
                "text_lang": "en",
                "text_tagged_users": null,
                "text_tagged_users_ids": null,
                "text_tags": null,
                "timestamp": 1764873406,
                "view_count": 2880
            },
