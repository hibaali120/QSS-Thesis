                "place_type": null,
                "poll": null,
                "post_type": "quote",
                "quote_count": 0,
                "quoted_status_id": "1865124088441655348",
                "quoted_status_profile_id": "109287731",
                "quoted_status_profile_username": "SenatorShaheen",
                "reply_count": 7,
                "retweet_count": 4,
                "source": "Twitter for iPhone",
                "text": "I\u2019ve been sounding the alarm around the ACA tax credits for more than a year now, and the message is the same: Tens of millions of families will face surging premium prices and millions more will lose coverage completely if Republicans don't join us to extend these subsidies.",
                "text_lang": "en",
                "text_tagged_users": null,
                "text_tagged_users_ids": null,
                "text_tags": null,
                "timestamp": 1765044650,
                "view_count": 1368
            },
            {
                "attached_links_expanded_url": null,
                "attached_links_url": null,
                "attached_medias_preview_url": null,
                "attached_medias_url": null,
                "attached_videos": null,
                "author_id": "109287731",
                "author_username": "SenatorShaheen",
                "community_notes": null,
                "conversation_id": "1998075742484127745",
                "created_time": "2025-12-08T17:02:34",
                "favorite_count": 1,
                "geo_lat": null,
                "geo_lon": null,
                "id": "1998075742484127745",
                "in_reply_to_post_id": null,
                "in_reply_to_profile_id": null,
                "in_reply_to_profile_username": null,
                "place_country_code": null,
                "place_country_name": null,
                "place_full_name": null,
                "place_type": null,
                "poll": null,
                "post_type": "post",
                "quote_count": 0,
                "quoted_status_id": null,
                "quoted_status_profile_id": null,
                "quoted_status_profile_username": null,
                "reply_count": 13,
                "retweet_count": 2,
                "source": "Twitter Web App",
                "text": "Tens of millions of Americans are currently signing up for health insurance coverage through the ACA Marketplace. \n\nThey're facing staggering premium increases because Republicans in Congress and in the White House refuse to extend the vital ACA enhanced premium tax credits.",
                "text_lang": "en",
                "text_tagged_users": null,
                "text_tagged_users_ids": null,
                "text_tags": null,
                "timestamp": 1765213354,
                "view_count": 901
            },
            {
                "attached_links_expanded_url": null,
                "attached_links_url": null,
                "attached_medias_preview_url": null,
                "attached_medias_url": null,
                "attached_videos": null,
                "author_id": "109287731",
                "author_username": "SenatorShaheen",
                "community_notes": null,
                "conversation_id": "1998143131217178824",
                "created_time": "2025-12-08T21:30:20",
                "favorite_count": 14,
                "geo_lat": null,
                "geo_lon": null,
                "id": "1998143131217178824",
                "in_reply_to_post_id": null,
                "in_reply_to_profile_id": null,
                "in_reply_to_profile_username": null,
                "place_country_code": null,
                "place_country_name": null,
                "place_full_name": null,
                "place_type": null,
                "poll": null,
                "post_type": "quote",
                "quote_count": 6,
                "quoted_status_id": "1998069315493405153",
                "quoted_status_profile_id": "14932439",
                "quoted_status_profile_username": "semafor",
                "reply_count": 155,
                "retweet_count": 6,
                "source": "Twitter Web App",
                "text": "Support for the ACA tax credits has reached an all-time high of 57%, including 63% among independents.\n\nThere\u2019s still time to find a solution and prevent premiums from skyrocketing. My Republican colleagues should heed this @Gallup poll and join with us to extend the tax credits.",
                "text_lang": "en",
                "text_tagged_users": [
                    "Gallup"
                ],
                "text_tagged_users_ids": [
                    "7684882"
                ],
                "text_tags": null,
                "timestamp": 1765229420,
                "view_count": 4161
            },
            {
                "attached_links_expanded_url": null,
                "attached_links_url": null,
                "attached_medias_preview_url": null,
                "attached_medias_url": null,
                "attached_videos": null,
                "author_id": "109287731",
