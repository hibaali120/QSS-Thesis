                "quoted_status_profile_id": null,
                "quoted_status_profile_username": null,
                "reply_count": 7,
                "retweet_count": 7,
                "source": "Twitter Web App",
                "text": "Extending the ACA tax credits before the end of the year is urgent for communities like those in West Virginia, where the cost of health insurance is already unaffordable.\n\nWithout a bipartisan solution, too many Americans will be priced out of health coverage completely. https://t.co/KiKIYxRvG5",
                "text_lang": "en",
                "text_tagged_users": null,
                "text_tagged_users_ids": null,
                "text_tags": null,
                "timestamp": 1764714319,
                "view_count": 1157
