                "quoted_status_profile_username": null,
                "reply_count": 11,
                "retweet_count": 3,
                "source": "Twitter Web App",
                "text": "One of the most important parts of my job is hearing from everyone across my district.\n\nIt was so great to be in Fremont County recently to share more about my work in Congress to protect access to Medicaid, defend our public lands, and support the issues that matter most to Southern Colorado.\n\nI\u2019m thankful for the chance to hear directly from you and bring your voices with me to Washington.",
                "text_lang": "en",
                "text_tagged_users": null,
                "text_tagged_users_ids": null,
                "text_tags": null,
