                "quote_count": 0,
                "quoted_status_id": null,
                "quoted_status_profile_id": null,
                "quoted_status_profile_username": null,
                "reply_count": 5,
                "retweet_count": 2,
                "source": "Sendible",
                "text": "From rising food prices to cuts to Medicaid, SNAP, and HUD, the city of Broomfield & the Broomfield chamber of commerce are tackling these challenges daily. I'm grateful for their work supporting families & stepping up when our community needs it most. I\u2019ll always fight for their priorities in Congress, even when Trump works to dismantle the programs so many people in our community rely on.",
                "text_lang": "en",
                "text_tagged_users": null,
                "text_tagged_users_ids": null,
                "text_tags": null,
