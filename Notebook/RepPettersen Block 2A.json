                "favorite_count": 21,
                "geo_lat": null,
                "geo_lon": null,
                "id": "1944108540068520296",
                "in_reply_to_post_id": null,
                "in_reply_to_profile_id": null,
                "in_reply_to_profile_username": null,
                "place_country_code": null,
                "place_country_name": null,
                "place_full_name": null,
                "place_type": null,
                "poll": null,
                "post_type": "post",
                "quote_count": 0,
                "quoted_status_id": null,
                "quoted_status_profile_id": null,
                "quoted_status_profile_username": null,
                "reply_count": 10,
                "retweet_count": 4,
                "source": "Statusbrew",
                "text": "Thank you to everyone who joined our town halls in Ca\u00f1on City and Woodland Park - it means so much to hear directly from you. I know many Coloradans are scared \u2014 about losing access to care and about what comes next.\u00a0\n\nOne woman shared how Medicaid keeps her husband alive. Farmers told us how critical the program is to them. These stories stay with me.\u00a0\n\nI want you to know: I will always show up for you.",
                "text_lang": "en",
                "text_tagged_users": null,
                "text_tagged_users_ids": null,
                "text_tags": null,
                "timestamp": 1752346570,
                "view_count": 1135
            },
            {
                "attached_links_expanded_url": null,
                "attached_links_url": null,
                "attached_medias_preview_url": null,
                "attached_medias_url": null,
                "attached_videos": null,
                "author_id": "1610014478405406720",
                "author_username": "RepPettersen",
                "community_notes": null,
                "conversation_id": "1944889324186579344",
                "created_time": "2025-07-14T22:38:43",
                "favorite_count": 26,
                "geo_lat": null,
                "geo_lon": null,
                "id": "1944889324186579344",
                "in_reply_to_post_id": null,
                "in_reply_to_profile_id": null,
                "in_reply_to_profile_username": null,
                "place_country_code": null,
                "place_country_name": null,
                "place_full_name": null,
                "place_type": null,
                "poll": null,
                "post_type": "quote",
                "quote_count": 1,
                "quoted_status_id": "1944793347547140297",
                "quoted_status_profile_id": "366368285",
                "quoted_status_profile_username": "caitlynkim",
                "reply_count": 50,
                "retweet_count": 8,
                "source": "Twitter Web App",
                "text": "Trump's Big Bad Bill is a catastrophe for our families\n\nHospitals and nursing homes will shutter. Kids will go hungry. ERs will be completely overrun. And our healthcare costs will skyrocket.\n\nTrump said he was going to lower costs on day one. Instead he's wreaking havoc -- raising costs and pulling the rug out from families, kids, seniors and the disabled while dismantling the systems we all rely on.",
                "text_lang": "en",
                "text_tagged_users": null,
                "text_tagged_users_ids": null,
                "text_tags": null,
                "timestamp": 1752532723,
                "view_count": 3537
            },
            {
                "attached_links_expanded_url": null,
                "attached_links_url": null,
                "attached_medias_preview_url": [
                    "https://pbs.twimg.com/media/GxI2ktpXQAAJ2ND.jpg?name=small"
                ],
                "attached_medias_url": [
                    "https://pbs.twimg.com/media/GxI2ktpXQAAJ2ND.jpg"
                ],
                "attached_videos": null,
                "author_id": "1610014478405406720",
                "author_username": "RepPettersen",
                "community_notes": null,
                "conversation_id": "1950681597729984592",
                "created_time": "2025-07-30T22:15:09",
                "favorite_count": 7,
                "geo_lat": null,
                "geo_lon": null,
                "id": "1950681597729984592",
                "in_reply_to_post_id": null,
                "in_reply_to_profile_id": null,
                "in_reply_to_profile_username": null,
                "place_country_code": null,
                "place_country_name": null,
                "place_full_name": null,
                "place_type": null,
                "poll": null,
                "post_type": "post",
                "quote_count": 0,
                "quoted_status_id": null,
                "quoted_status_profile_id": null,
                "quoted_status_profile_username": null,
                "reply_count": 5,
                "retweet_count": 2,
                "source": "Statusbrew",
                "text": "60 years ago, America made a promise: we will not leave our seniors, people with disabilities and those living in poverty without the essential healthcare they need. Medicare and Medicaid have saved countless lives and lifted millions from poverty. Unfortunately today, that promise is under threat.\u00a0\n\nWe aren\u2019t going to sit back while Republicans mislead the public about the bill they just passed and the detrimental impact to all of us, especially our seniors who are on a fixed income.",
                "text_lang": "en",
                "text_tagged_users": null,
                "text_tagged_users_ids": null,
                "text_tags": null,
                "timestamp": 1753913709,
                "view_count": 869
            },
            {
                "attached_links_expanded_url": null,
                "attached_links_url": null,
                "attached_medias_preview_url": [
                    "https://pbs.twimg.com/media/GyF4uqFWEAAdkvX.jpg?name=small"
                ],
                "attached_medias_url": [
                    "https://pbs.twimg.com/media/GyF4uqFWEAAdkvX.jpg"
                ],
                "attached_videos": null,
                "author_id": "1610014478405406720",
                "author_username": "RepPettersen",
                "community_notes": null,
                "conversation_id": "1954976458893386048",
                "created_time": "2025-08-11T18:41:24",
                "favorite_count": 5,
                "geo_lat": null,
                "geo_lon": null,
                "id": "1954976458893386048",
                "in_reply_to_post_id": null,
                "in_reply_to_profile_id": null,
                "in_reply_to_profile_username": null,
                "place_country_code": null,
                "place_country_name": null,
                "place_full_name": null,
                "place_type": null,
                "poll": null,
                "post_type": "post",
                "quote_count": 0,
                "quoted_status_id": null,
                "quoted_status_profile_id": null,
                "quoted_status_profile_username": null,
                "reply_count": 3,
                "retweet_count": 3,
                "source": "Statusbrew",
                "text": "I'm joining my CO Democratic colleagues in calling on @CMSGov to renew Colorado\u2019s Medicaid waiver program to ensure our youngest kids will have continuous medical care and won\u2019t be thrown into a system that is designed to kick them and their family members off.\n\nThis continuity of care prevents our kids from slipping through the cracks and is an essential investment in the lives of those who need our support the most.",
                "text_lang": "en",
                "text_tagged_users": [
                    "CMSGov"
                ],
                "text_tagged_users_ids": [
                    "70837868"
                ],
                "text_tags": null,
                "timestamp": 1754937684,
                "view_count": 817
            },
            {
                "attached_links_expanded_url": null,
                "attached_links_url": null,
                "attached_medias_preview_url": [
                    "https://pbs.twimg.com/media/Gyo7e3aWMAAQ8jF.jpg?name=small",
                    "https://pbs.twimg.com/media/Gyo7fNSXEAAcVdE.jpg?name=small",
                    "https://pbs.twimg.com/media/Gyo7fjzW4AAiSpb.jpg?name=small"
