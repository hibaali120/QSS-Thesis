                ],
                "attached_videos": null,
                "author_id": "1610014478405406720",
                "author_username": "RepPettersen",
                "community_notes": null,
                "conversation_id": "1957442407978394001",
                "created_time": "2025-08-18T14:00:12",
                "favorite_count": 15,
                "geo_lat": null,
                "geo_lon": null,
                "id": "1957442407978394001",
                "in_reply_to_post_id": null,
                "in_reply_to_profile_id": null,
                "in_reply_to_profile_username": null,
                "place_country_code": null,
                "place_country_name": null,
                "place_full_name": null,
                "place_type": null,
                "poll": null,
                "post_type": "post",
                "quote_count": 0,
                "quoted_status_id": null,
                "quoted_status_profile_id": null,
                "quoted_status_profile_username": null,
                "reply_count": 8,
                "retweet_count": 2,
                "source": "Statusbrew",
                "text": "I had the opportunity to visit the Heart of the Rockies Regional Medical Center while I was in Chaffee County. While some hospitals are in a better position to weather the disastrous healthcare cuts, far too many will shutter.\n\nEven the Heart of the Rockies will be impacted as regional hospitals are already operating in the red and closing maternity wards - forcing women to travel hours just to deliver a baby. We know that many rural hospitals might not survive Trump\u2019s cuts to Medicaid.\u00a0\n\nIt's devastating to think about the lives that will be unnecessarily lost and what it will take to rebuild the healthcare systems that are critical to our communities.",
                "text_lang": "en",
                "text_tagged_users": null,
                "text_tagged_users_ids": null,
                "text_tags": null,
                "timestamp": 1755525612,
                "view_count": 845
            },
            {
                "attached_links_expanded_url": null,
                "attached_links_url": null,
                "attached_medias_preview_url": [
                    "https://pbs.twimg.com/media/GzhqsBXX0AADqt2.png?name=small",
                    "https://pbs.twimg.com/media/GzhqsQXXsAAHxib.jpg?name=small"
                ],
                "attached_medias_url": [
                    "https://pbs.twimg.com/media/GzhqsBXX0AADqt2.png",
                    "https://pbs.twimg.com/media/GzhqsQXXsAAHxib.jpg"
                ],
                "attached_videos": null,
                "author_id": "1610014478405406720",
                "author_username": "RepPettersen",
                "community_notes": null,
                "conversation_id": "1961434953582866674",
                "created_time": "2025-08-29T14:25:09",
                "favorite_count": 13,
                "geo_lat": null,
                "geo_lon": null,
                "id": "1961434953582866674",
                "in_reply_to_post_id": null,
                "in_reply_to_profile_id": null,
                "in_reply_to_profile_username": null,
                "place_country_code": null,
                "place_country_name": null,
                "place_full_name": null,
                "place_type": null,
                "poll": null,
                "post_type": "post",
                "quote_count": 0,
                "quoted_status_id": null,
                "quoted_status_profile_id": null,
                "quoted_status_profile_username": null,
                "reply_count": 8,
                "retweet_count": 0,
                "source": "Sendible",
                "text": "Trump\u2019s cuts to Medicaid, SNAP, and other programs under the Big Ugly Law will impact families across CO.\n\nBut it\u2019s places like Evergreen Christian Outreach that give me hope that we will be able to get through this together. They provide a lifeline for our neighbors in need \u2013 food, financial help, mental health support, shelter and transitional housing - even as demand has doubled since the pandemic. \n\nTheir work shows the true power of community. Times are tough with rising costs and it\u2019s going to get a lot harder \u2013 but we are going to weather the storm together.",
                "text_lang": "en",
                "text_tagged_users": null,
                "text_tagged_users_ids": null,
                "text_tags": null,
                "timestamp": 1756477509,
                "view_count": 774
            },
            {
                "attached_links_expanded_url": null,
                "attached_links_url": null,
                "attached_medias_preview_url": null,
                "attached_medias_url": null,
                "attached_videos": null,
                "author_id": "1610014478405406720",
                "author_username": "RepPettersen",
                "community_notes": null,
                "conversation_id": "1962987647871369449",
                "created_time": "2025-09-02T21:15:00",
                "favorite_count": 28,
                "geo_lat": null,
                "geo_lon": null,
                "id": "1962987647871369449",
                "in_reply_to_post_id": null,
                "in_reply_to_profile_id": null,
                "in_reply_to_profile_username": null,
                "place_country_code": null,
                "place_country_name": null,
                "place_full_name": null,
                "place_type": null,
                "poll": null,
                "post_type": "quote",
                "quote_count": 1,
                "quoted_status_id": "1956478679128657956",
                "quoted_status_profile_id": "14522447",
                "quoted_status_profile_username": "bfld_enterprise",
                "reply_count": 17,
                "retweet_count": 3,
                "source": "Twitter Web Client",
                "text": "Trump said he wouldn\u2019t cut Medicaid. That was a lie. And now he\u2019s coming for Medicare.\n\nThat means seniors forced to skip prescriptions, rural hospitals shutting their doors, & nursing homes struggling to keep their lights on.\n\nIt\u2019s unfathomable that our seniors who have worked their whole lives are being left behind so Trump can hand out more tax breaks to some of the wealthiest people in the world.",
                "text_lang": "en",
                "text_tagged_users": null,
                "text_tagged_users_ids": null,
                "text_tags": null,
                "timestamp": 1756847700,
                "view_count": 2040
            },
            {
                "attached_links_expanded_url": null,
                "attached_links_url": null,
                "attached_medias_preview_url": [
                    "https://pbs.twimg.com/ext_tw_video_thumb/1963317353355075584/pu/img/FNB_wXc9GfK6T9du.jpg?name=small"
