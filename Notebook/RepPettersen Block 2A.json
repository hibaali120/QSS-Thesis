                "favorite_count": 29,
                "geo_lat": null,
                "geo_lon": null,
                "id": "1963317425547481452",
                "in_reply_to_post_id": null,
                "in_reply_to_profile_id": null,
                "in_reply_to_profile_username": null,
                "place_country_code": null,
                "place_country_name": null,
                "place_full_name": null,
                "place_type": null,
                "poll": null,
                "post_type": "post",
                "quote_count": 0,
                "quoted_status_id": null,
                "quoted_status_profile_id": null,
                "quoted_status_profile_username": null,
                "reply_count": 8,
                "retweet_count": 9,
                "source": "Sendible",
                "text": "I heard directly from the staff & seniors at Western Hills nursing home where 60% of residents rely on Medicaid. Most residents said that if Medicaid was no longer able to pay for their residency, they would have nowhere else to go. \n\nTrump's Big Ugly Bill will rip billions of dollars out of Colorado\u2019s health care system - meaning deep cuts to critical services like our nursing homes. None of us will be left without feeling the impact but I am most worried for our seniors, people with disabilities and children. \n\nThese are our parents & grandparents who are all at risk now. It's just shameful.",
                "text_lang": "en",
                "text_tagged_users": null,
                "text_tagged_users_ids": null,
                "text_tags": null,
                "timestamp": 1756926325,
                "view_count": 1215
            },
            {
                "attached_links_expanded_url": null,
                "attached_links_url": null,
