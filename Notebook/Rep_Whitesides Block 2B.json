                "quoted_status_profile_username": null,
                "reply_count": 1,
                "retweet_count": 0,
                "source": "Twitter Web App",
                "text": "I testified in front of the House Rules Committee today to talk about the working families, the local hospitals, and the kids in my district that will be seriously hurt by the budget that House Republicans are jamming through Congress. We should be focusing on lowering costs and creating jobs, not putting health care for millions of Americans on the chopping block.",
                "text_lang": "en",
                "text_tagged_users": null,
                "text_tagged_users_ids": null,
                "text_tags": null,
