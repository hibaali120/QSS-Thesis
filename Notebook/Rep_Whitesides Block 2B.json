                "quoted_status_profile_username": null,
                "reply_count": 0,
                "retweet_count": 2,
                "source": "Twitter for iPhone",
                "text": "Hospitals in our district aren\u2019t immune to what has just passed in the Senate\u2019s Budget Bill. According to the AHA, the bill would strip away funds that help keep local hospitals staffed, equipped, and open. Our communities deserve better.",
                "text_lang": "en",
                "text_tagged_users": null,
                "text_tagged_users_ids": null,
                "text_tags": null,
                "timestamp": 1751401916,
                "view_count": 301
            },
