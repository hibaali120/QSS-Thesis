                "quoted_status_profile_username": null,
                "reply_count": 0,
                "retweet_count": 0,
                "source": "Twitter for iPhone",
                "text": "I submitted an amendment to the budget that would protect patients and local health care providers that rely on Medicaid to receive, and provide, health care.\u00a0\n\nMy amendment would stop this bill\u2019s Medicaid cuts from taking effect unless the nonpartisan Congressional Budget Office CONFIRMS it won\u2019t harm health centers or cut people off of their insurance.",
                "text_lang": "en",
                "text_tagged_users": null,
                "text_tagged_users_ids": null,
                "text_tags": null,
                "timestamp": 1751409978,
                "view_count": 233
