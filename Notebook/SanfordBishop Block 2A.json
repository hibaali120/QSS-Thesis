            {
                "attached_links_expanded_url": [
                    "https://bishop.house.gov/media-center/press-releases/congressman-bishop-opposes-budget-resolution-that-guts-healthcare-nutrition-and-education-hurting-families-seniors-and-veterans"
                ],
                "attached_links_url": [
                    "https://t.co/MJLbr4Qyel"
                ],
                "attached_medias_preview_url": null,
                "attached_medias_url": null,
