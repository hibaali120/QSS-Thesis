                "reply_count": 3,
                "retweet_count": 1,
                "source": "Twitter Web App",
                "text": "Yesterday, I met with AARP leaders to discuss key priorities for older Americans, including protecting Social Security, supporting family caregivers, defending Medicaid, and ensuring access to nutrition resources like SNAP. Millions of America\u2019s senior citizens depend on these programs every day but these federal programs and the workers who help deliver these services have come under attack by the Trump Administration, the GOP budget reconciliation bill, and Republican-led Fiscal Year 2026 funding bills. I am committed to working across the aisle to safeguard these vital programs.",
                "text_lang": "en",
                "text_tagged_users": null,
                "text_tagged_users_ids": null,
                "text_tags": null,
                "timestamp": 1750959131,
                "view_count": 309
