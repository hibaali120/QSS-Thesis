                "quoted_status_profile_username": null,
                "reply_count": 3,
                "retweet_count": 0,
                "source": "Twitter Web App",
                "text": "I am proud of @HouseGOP\u2019s work to strengthen our nation\u2019s safety net and protect the integrity of Americans\u2019 tax dollars. Programs like SNAP and Medicaid were intended for our most vulnerable populations, not for able-bodied adults without dependents who simply don\u2019t want to work.\n\nRequiring 20 hours a week of work or volunteering for able\u2013bodied individuals to receive these benefits should not be controversial.",
                "text_lang": "en",
