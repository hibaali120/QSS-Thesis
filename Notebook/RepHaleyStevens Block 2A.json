                "quoted_status_profile_username": "MSNOWNews",
                "reply_count": 5,
                "retweet_count": 1,
                "source": "Twitter Web App",
                "text": "Let\u2019s be clear \u2013 this plan is a disaster for Michigan. \n\nIt\u2019s nothing but a handout for the richest Americans and will slash the benefits so many Michiganders rely on, like Medicaid.",
                "text_lang": "en",
