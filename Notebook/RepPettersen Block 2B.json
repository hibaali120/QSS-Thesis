                "quoted_status_profile_username": null,
                "reply_count": 49,
                "retweet_count": 7,
                "source": "Twitter Web Client",
                "text": "This week we\u2019re discussing what's at stake during Trump's Shutdown and the skyrocketing costs that will hit families in just a few weeks if we don\u2019t act now.\n\nThe ACA tax credits lower monthly premiums for millions of hardworking families. But if they expire, costs will skyrocket overnight. In Colorado's 7th District, that means families could pay $15,647 more each year for the same coverage. No one can afford that.\n\nIt\u2019s shameful that Republicans continue to only prioritize their billionaire buddies on the backs of the rest of us. That\u2019s why we\u2019re not going to stand by while Trump hangs us out to dry.",
                "text_lang": "en",
                "text_tagged_users": null,
                "text_tagged_users_ids": null,
                "text_tags": null,
                "timestamp": 1760139000,
                "view_count": 2100
