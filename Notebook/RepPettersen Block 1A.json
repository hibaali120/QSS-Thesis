                "quoted_status_profile_username": null,
                "reply_count": 979,
                "retweet_count": 48,
                "source": "Twitter Web App",
                "text": "The Senate's so-called \u201cdeal\u201d does nothing to address the Republican health care crisis and the skyrocketing costs that families are facing now. Premiums are doubling and even tripling across my district, and up to 75,000 Coloradans are expected to be priced out of coverage.\u00a0\n\nThis means families who are already struggling to make ends meet will be left without the critical care they need. But this fight is far from over.",
                "text_lang": "en",
                "text_tagged_users": null,
                "text_tagged_users_ids": null,
                "text_tags": null,
                "timestamp": 1763157091,
                "view_count": 64977
