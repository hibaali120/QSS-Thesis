                "quoted_status_profile_username": null,
                "reply_count": 66,
                "retweet_count": 9,
                "source": "Twitter Web App",
                "text": "For too many Coloradans, health care costs are becoming impossible to manage without the ACA tax credits.\n\nLance told us that as someone with Type 1 diabetes his, \u201cpremium will rise from $754 to $1,223 a month.\u201d No one should have to downgrade their care just to stay insured. We need to protect the ACA tax credits that keep coverage within reach for families across our state.",
                "text_lang": "en",
                "text_tagged_users": null,
