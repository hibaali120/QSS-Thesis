                "quoted_status_profile_username": "HouseDemocrats",
                "reply_count": 122,
                "retweet_count": 15,
                "source": "Twitter Web App",
                "text": "Congress has 13 days to make sure people don\u2019t lose health care \u2014 13 days to protect millions of families.\n\nIf we don\u2019t act now, 75,000 Coloradans are going to lose coverage. This is life or death for far too many, and it\u2019s within our power to do something to make sure moms, kids, seniors, & families get the health care they need.\u00a0\n\nLet\u2019s stop wasting time. Cut the BS.",
                "text_lang": "en",
                "text_tagged_users": null,
                "text_tagged_users_ids": null,
                "text_tags": null,
                "timestamp": 1764626923,
                "view_count": 5262
