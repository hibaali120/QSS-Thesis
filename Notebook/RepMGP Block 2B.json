                "poll": null,
                "post_type": "post",
                "quote_count": 1,
                "quoted_status_id": null,
                "quoted_status_profile_id": null,
                "quoted_status_profile_username": null,
                "reply_count": 8,
                "retweet_count": 5,
                "source": "Twitter Web App",
                "text": "Our rural hospitals are already facing severe financial hardship and are barely breaking even.\n\nThe big bill's Apple Health cuts were engineered to occur after the midterm elections \u2013 when we'll all start feeling shuttered services and higher costs.\nhttps://t.co/WZTTvz9OWY",
                "text_lang": "en",
                "text_tagged_users": null,
                "text_tagged_users_ids": null,
                "text_tags": null,
                "timestamp": 1752169592,
                "view_count": 1836
            },
            {
                "attached_links_expanded_url": null,
                "attached_links_url": null,
                "attached_medias_preview_url": null,
                "attached_medias_url": null,
                "attached_videos": null,
                "author_id": "1603127874512453632",
                "author_username": "RepMGP",
                "community_notes": null,
                "conversation_id": "1988781065658650656",
                "created_time": "2025-11-13T01:28:50",
                "favorite_count": 2495,
                "geo_lat": null,
                "geo_lon": null,
                "id": "1988781065658650656",
                "in_reply_to_post_id": null,
                "in_reply_to_profile_id": null,
                "in_reply_to_profile_username": null,
                "place_country_code": null,
                "place_country_name": null,
                "place_full_name": null,
                "place_type": null,
                "poll": null,
                "post_type": "post",
                "quote_count": 146,
                "quoted_status_id": null,
                "quoted_status_profile_id": null,
                "quoted_status_profile_username": null,
                "reply_count": 664,
                "retweet_count": 226,
                "source": "Twitter Web App",
                "text": "Tonight, I voted to end this partisan car crash of a shutdown. Nobody likes paying even more money to insurance companies \u2013 and the fight to stop runaway health insurance premiums won\u2019t be won by holding hungry Americans hostage. Americans can\u2019t afford for their Representatives to get so caught up in landing a partisan win that they abandon their obligation to come together to solve the urgent problems that our nation faces.\n\nThe last several weeks have been a case study in why most Americans can\u2019t stand Congress. None of my friends who rely on SNAP would want to trade their dinner for an ambiguous D.C. beltway \"messaging victory\" and I\u2019m glad this ugly scene is in the rearview mirror.\n\nNow, it\u2019s time for Congress to get back to work and build an economy where people aren\u2019t yanked around by partisan interests, where we understand national health doesn\u2019t come from insurance coverage \u2013 and reestablish a truly deliberative democracy. I\u2019ll work with whoever is necessary to reach those goals \u2013 and I don\u2019t give a damn which side of the aisle they sit on.",
                "text_lang": "en",
                "text_tagged_users": null,
                "text_tagged_users_ids": null,
                "text_tags": null,
                "timestamp": 1762997330,
                "view_count": 584101
