                "geo_lat": null,
                "geo_lon": null,
                "id": "1940193963916312824",
                "in_reply_to_post_id": "1940193962033389981",
                "in_reply_to_profile_id": "1603127874512453632",
                "in_reply_to_profile_username": "RepMGP",
                "place_country_code": null,
                "place_country_name": null,
                "place_full_name": null,
                "place_type": null,
                "poll": null,
                "post_type": "reply",
                "quote_count": 1,
                "quoted_status_id": null,
                "quoted_status_profile_id": null,
                "quoted_status_profile_username": null,
                "reply_count": 1,
                "retweet_count": 2,
                "source": "Twitter Web App",
                "text": "It strips even more Americans of healthcare coverage, by gutting Medicaid and suffocating hardworking families with even more red tape.\n\n328,695 people in our state stand to lose healthcare, and rural hospitals across #WA03 would lose tens of millions of dollars \u2013 which could put these vital lifelines at risk for collapse.\n\nNot to mention, the bill still drives up costs for energy and healthcare premiums. \u2b07\ufe0f",
                "text_lang": "en",
                "text_tagged_users": null,
                "text_tagged_users_ids": null,
                "text_tags": [
                    "wa03"
                ],
                "timestamp": 1751413262,
                "view_count": 679
            },
            {
                "attached_links_expanded_url": null,
                "attached_links_url": null,
                "attached_medias_preview_url": [
                    "https://pbs.twimg.com/media/GvGkFVlWsAAMzzW.jpg?name=small"
                ],
                "attached_medias_url": [
                    "https://pbs.twimg.com/media/GvGkFVlWsAAMzzW.jpg"
                ],
                "attached_videos": null,
                "author_id": "1603127874512453632",
                "author_username": "RepMGP",
                "community_notes": null,
                "conversation_id": "1941513331015131304",
                "created_time": "2025-07-05T15:03:44",
                "favorite_count": 29,
                "geo_lat": null,
                "geo_lon": null,
                "id": "1941513331015131304",
                "in_reply_to_post_id": null,
                "in_reply_to_profile_id": null,
                "in_reply_to_profile_username": null,
                "place_country_code": null,
                "place_country_name": null,
                "place_full_name": null,
                "place_type": null,
                "poll": null,
                "post_type": "post",
                "quote_count": 0,
                "quoted_status_id": null,
                "quoted_status_profile_id": null,
                "quoted_status_profile_username": null,
                "reply_count": 3,
                "retweet_count": 7,
                "source": "Twitter for iPhone",
                "text": "I live in unincorporated Skamania County \u2013 so I know just how difficult it can be to access healthcare when you need it.\n\nRural hospitals are a lifeline, and when they suffer, the health of our rural communities suffer.\n\nThis bill is a mess of party favors for special interests, while we're left holding the bag.\n\nI voted no.",
                "text_lang": "en",
                "text_tagged_users": null,
                "text_tagged_users_ids": null,
                "text_tags": null,
                "timestamp": 1751727824,
                "view_count": 1877
            },
            {
                "attached_links_expanded_url": [
                    "https://andrestepankowsky.substack.com/p/gop-medicaid-cuts-to-wallop-washington"
                ],
                "attached_links_url": [
