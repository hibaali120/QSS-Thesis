                "attached_videos": null,
                "author_id": "1603127874512453632",
                "author_username": "RepMGP",
                "community_notes": null,
                "conversation_id": "1943340438250774977",
                "created_time": "2025-07-10T16:04:00",
                "favorite_count": 14,
                "geo_lat": null,
                "geo_lon": null,
                "id": "1943340438250774977",
                "in_reply_to_post_id": null,
                "in_reply_to_profile_id": null,
                "in_reply_to_profile_username": null,
                "place_country_code": null,
                "place_country_name": null,
                "place_full_name": null,
                "place_type": null,
                "poll": null,
                "post_type": "post",
                "quote_count": 0,
                "quoted_status_id": null,
                "quoted_status_profile_id": null,
                "quoted_status_profile_username": null,
                "reply_count": 6,
                "retweet_count": 5,
                "source": "Twitter Web App",
                "text": "Rural hospitals already face strain, and major cuts to Apple Health will impact care for ALL rural Americans.\n\nAnd when working citizens can't access timely care for worsening conditions, we'll all foot the bill for the resulting emergency services.\nhttps://t.co/J2OXyVBPLM",
                "text_lang": "en",
                "text_tagged_users": null,
                "text_tagged_users_ids": null,
