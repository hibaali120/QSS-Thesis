                "quoted_status_profile_username": null,
                "reply_count": 0,
                "retweet_count": 0,
                "source": "Twitter for iPhone",
                "text": "Thanks to House Republicans, health insurance premiums are set to spike.\n\nIf they let ACA tax credits expire, 4M Floridians could see premiums jump from $588 to $1,116/year \u2014 plus a $470 hike in FL-20 from the Republicans\u2019 Big Ugly Bill.\n\nDemand Senate Republicans to take action. The American people are waiting and cannot afford delays.",
                "text_lang": "en",
                "text_tagged_users": null,
                "text_tagged_users_ids": null,
                "text_tags": null,
