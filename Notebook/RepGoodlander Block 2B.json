                "quoted_status_profile_username": "WMUR9",
                "reply_count": 3,
                "retweet_count": 0,
                "source": "Twitter for iPhone",
                "text": "The impacts of the GOP\u2019s cuts to Medicaid are not hypothetical. They are real for real people right here in New Hampshire, including the patients who received care at the Franconia Health Center. \n\nWe should be expanding access to lifesaving healthcare, not eliminating it. I will never stop fighting to ensure our rural communities have the care they need.",
                "text_lang": "en",
                "text_tagged_users": null,
                "text_tagged_users_ids": null,
                "text_tags": null,
                "timestamp": 1752877618,
