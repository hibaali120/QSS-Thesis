                "place_type": null,
                "poll": null,
                "post_type": "quote",
                "quote_count": 1,
                "quoted_status_id": "1918008937888051419",
                "quoted_status_profile_id": "955187349427818496",
                "quoted_status_profile_username": "WillSkipworth",
                "reply_count": 14,
                "retweet_count": 0,
                "source": "Twitter Web App",
                "text": "Our rural hospitals are already operating on the slimmest of margins \u2013 and if Republicans\u2019 proposed cuts to Medicaid go into effect, many of them will face a true crisis.\n\nProtecting Medicaid is a matter of life and death for thousands of people across New Hampshire, and I am fighting with absolutely everything I\u2019ve got to defend this essential program.",
                "text_lang": "en",
                "text_tagged_users": null,
                "text_tagged_users_ids": null,
                "text_tags": null,
                "timestamp": 1746359867,
                "view_count": 1253
