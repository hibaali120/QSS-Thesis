                "quoted_status_profile_username": null,
                "reply_count": 3,
                "retweet_count": 1,
                "source": "Twitter Web App",
                "text": "Today, I spent time with an extraordinary community of @alzheimersmanh advocates from across New Hampshire. I heard about the heartbreak and challenges that tens of thousands of patients, caregivers, and families battling Alzheimer\u2019s and dementia face every single day. \n\nThere was not a dry eye in the room.\n\nI am bringing your voices to Congress in our fight to protect Medicaid and Medicare, to advance mission-critical research and clinical trials that will help us end Alzheimer's as we know it, and to ensure that the tens of thousands of caregivers across New Hampshire get the credit and support they need and deserve.",
                "text_lang": "en",
                "text_tagged_users": [
                    "alzheimersmanh"
                ],
                "text_tagged_users_ids": [
                    "21013378"
                ],
                "text_tags": null,
                "timestamp": 1743803680,
                "view_count": 467
