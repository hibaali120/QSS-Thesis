                "quoted_status_profile_username": null,
                "reply_count": 4,
                "retweet_count": 0,
                "source": "Twitter Web App",
                "text": "We are now in the longest government shutdown in American history.\n\nInstead of bringing both parties to the table, Speaker Johnson has kept the House in recess since September 19th.\n\nEnough.\n\nIt\u2019s time to call lawmakers back to Washington, protect affordable health care, and reopen the government to serve the American people.",
                "text_lang": "en",
                "text_tagged_users": null,
                "text_tagged_users_ids": null,
                "text_tags": null,
                "timestamp": 1762376105,
                "view_count": 513
            },
