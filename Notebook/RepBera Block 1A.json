                "quoted_status_profile_username": null,
                "reply_count": 7,
                "retweet_count": 0,
                "source": "Twitter for iPhone",
                "text": "The government shuts down in less than 10 hours. \n\nI\u2019m back in D.C. ready to negotiate a deal to protect your health care and keep the government open. \n\nLet\u2019s get this done.",
