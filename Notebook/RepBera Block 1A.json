                "quoted_status_profile_username": null,
                "reply_count": 5,
                "retweet_count": 1,
                "source": "Twitter Web App",
                "text": "This week, I signed a discharge petition to force a vote on extending Affordable Care Act subsidies for three years. \n\nWe must extend these subsidies to prevent dramatic increases in health care premiums for over 20 million Americans. https://t.co/WameWStHKx",
