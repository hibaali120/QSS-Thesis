                "quoted_status_profile_id": null,
                "quoted_status_profile_username": null,
                "reply_count": 3,
                "retweet_count": 15,
                "source": "Twitter Web App",
                "text": "(6/13) Congress doesn\u2019t need to sit on the sidelines while a generation of medical students fights this issue in the courts.\n\nWe\u2019re introducing the EDUCATE Act to ensure that American tax dollars aren\u2019t used to poison the next generation of doctors with DEI.",
                "text_lang": "en",
                "text_tagged_users": null,
                "text_tagged_users_ids": null,
                "text_tags": null,
                "timestamp": 1748370753,
                "view_count": 1632
            },
            {
                "attached_links_expanded_url": null,
                "attached_links_url": null,
                "attached_medias_preview_url": null,
                "attached_medias_url": null,
                "attached_videos": null,
                "author_id": "816683274076614656",
                "author_username": "SenJohnKennedy",
                "community_notes": null,
                "conversation_id": "1927432745661186380",
