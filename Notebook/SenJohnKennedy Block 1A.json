                "favorite_count": 99,
                "geo_lat": null,
                "geo_lon": null,
                "id": "1927432757078024261",
                "in_reply_to_post_id": "1927432755459039354",
                "in_reply_to_profile_id": "816683274076614656",
                "in_reply_to_profile_username": "SenJohnKennedy",
                "place_country_code": null,
                "place_country_name": null,
                "place_full_name": null,
                "place_type": null,
                "poll": null,
                "post_type": "reply",
                "quote_count": 0,
                "quoted_status_id": null,
                "quoted_status_profile_id": null,
                "quoted_status_profile_username": null,
                "reply_count": 3,
                "retweet_count": 12,
                "source": "Twitter Web App",
                "text": "(7/13) The EDUCATE Act would strip federal funding from any university that denies qualified students admission because of their race or sex.\n\nMedical degrees aren\u2019t participation prizes, and fair-minded Americans don\u2019t want to fund universities that treat them as such.",
                "text_lang": "en",
                "text_tagged_users": null,
                "text_tagged_users_ids": null,
                "text_tags": null,
                "timestamp": 1748370753,
                "view_count": 1638
            },
