                "quoted_status_profile_username": null,
                "reply_count": 4,
                "retweet_count": 14,
                "source": "Twitter Web App",
                "text": "(5/13) SCOTUS held in 1978\u2014and again in 2023\u2014that universities cannot use racial quotas in their admissions decisions, yet many universities still ignore the law.\n\nAmerican taxpayers provide more than $28B to medical schools, and they expect these universities to follow the law.",
                "text_lang": "en",
                "text_tagged_users": null,
                "text_tagged_users_ids": null,
                "text_tags": null,
                "timestamp": 1748370752,
                "view_count": 1720
            },
            {
                "attached_links_expanded_url": null,
                "attached_links_url": null,
                "attached_medias_preview_url": null,
                "attached_medias_url": null,
                "attached_videos": null,
                "author_id": "816683274076614656",
                "author_username": "SenJohnKennedy",
                "community_notes": null,
                "conversation_id": "1927432745661186380",
