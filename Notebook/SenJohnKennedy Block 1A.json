                "quoted_status_profile_id": null,
                "quoted_status_profile_username": null,
                "reply_count": 2,
                "retweet_count": 13,
                "source": "Twitter Web App",
                "text": "(10/13) Finally, we must eliminate DEI offices that are fueling the obsession with race and gender in America\u2019s medical schools.\n\nThe sole purpose of DEI departments is to find new ways to skirt our laws on racial and gender quotas, and American taxpayers are done paying for it.",
                "text_lang": "en",
                "text_tagged_users": null,
                "text_tagged_users_ids": null,
                "text_tags": null,
                "timestamp": 1748370755,
                "view_count": 1462
            },
