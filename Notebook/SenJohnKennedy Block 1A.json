                "geo_lat": null,
                "geo_lon": null,
                "id": "1927432752523055395",
                "in_reply_to_post_id": "1927432750652330220",
                "in_reply_to_profile_id": "816683274076614656",
                "in_reply_to_profile_username": "SenJohnKennedy",
