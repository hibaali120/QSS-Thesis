                "quoted_status_profile_username": null,
                "reply_count": 1,
                "retweet_count": 10,
                "source": "Twitter Web App",
                "text": "(11/13) The U.S. is home to the most gifted and innovative doctors on Earth, and it\u2019s not by happenstance.\n\nWe sought them out by making medical school one of the most impressive, merit-based institutions in our country.",
                "text_lang": "en",
                "text_tagged_users": null,
                "text_tagged_users_ids": null,
                "text_tags": null,
                "timestamp": 1748370755,
                "view_count": 1428
            },
