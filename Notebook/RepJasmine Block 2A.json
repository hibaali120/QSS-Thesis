                "quoted_status_profile_username": null,
                "reply_count": 4357,
                "retweet_count": 6034,
                "source": "Twitter for iPhone",
                "text": "Notice the pattern? Republicans work to advance their worst bills in the middle of the night\u2014hoping you\u2019re asleep while they attack your healthcare, your rights, and your future.\n\nPlease don\u2019t be fooled. They\u2019re not up late working for you. They\u2019re up late working against you.\n\nAll to prove their loyalty to Donald Trump and their billionaire buddies.",
                "text_lang": "en",
                "text_tagged_users": null,
                "text_tagged_users_ids": null,
                "text_tags": null,
                "timestamp": 1751234951,
                "view_count": 691913
