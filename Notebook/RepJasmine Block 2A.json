                "quoted_status_profile_username": null,
                "reply_count": 645,
                "retweet_count": 1729,
                "source": "Twitter for iPhone",
                "text": "House Republicans passed the biggest health care cut in U.S. history. Senate Republicans\u2019 response? Hold my beer.\n\nNow they\u2019re pushing even deeper Medicaid cuts\u2014knowing it\u2019ll shut down rural hospitals, strip care from their own voters, and leave millions hanging.\n\nThey don\u2019t care who gets hurt. Cruelty and greed is the point. That\u2019s their whole playbook.",
                "text_lang": "en",
                "text_tagged_users": null,
                "text_tagged_users_ids": null,
                "text_tags": null,
