                "quoted_status_profile_id": "1652541",
                "quoted_status_profile_username": "Reuters",
                "reply_count": 1824,
                "retweet_count": 534,
                "source": "Twitter for iPhone",
                "text": "Let\u2019s call this what it is: political retaliation.\n\nTrump and his MAGA crew are targeting Planned Parenthood\u2014not because of budgets, but because they refuse to stay quiet about abortion rights.\n\nNow, over a million Medicaid patients could lose access to basic care.\n\nYou don\u2019t get to strip care from a million people just because you\u2019re mad folks won\u2019t sit down and shut up. This is bigger than Planned Parenthood\u2014it\u2019s about silencing anyone who dares to fight back.",
                "text_lang": "en",
                "text_tagged_users": null,
                "text_tagged_users_ids": null,
                "text_tags": null,
                "timestamp": 1751993809,
                "view_count": 106367
