                "post_type": "post",
                "quote_count": 7,
                "quoted_status_id": null,
                "quoted_status_profile_id": null,
                "quoted_status_profile_username": null,
                "reply_count": 77,
                "retweet_count": 9,
                "source": "Twitter Web App",
                "text": "It took the longest government shutdown in history, but President Trump is finally paying attention.\n\nIt's time for this administration to engage in a meaningful negotiation to reopen the government and bring health care costs down.\n\nThe American people can't afford to wait.",
                "text_lang": "en",
