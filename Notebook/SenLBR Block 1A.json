                "quoted_status_profile_username": null,
                "reply_count": 19,
                "retweet_count": 8,
                "source": "Twitter Web App",
                "text": "Last night, Americans across the country made it clear: they want leaders who stand up to bullies, work to bring down costs, and fight to protect their access to health care.\n\n@SenateDems are ready.",
                "text_lang": "en",
