                "reply_count": 1,
                "retweet_count": 1,
                "source": "Twitter for iPhone",
                "text": "It's time we put veterans and their families first, not the bureaucracy! I voted for the Senator Elizabeth Dole 21st Century Veterans Healthcare and Benefits Improvement Act which would: \n\n\u2705expand access to home and community care\n\u2705cover costs for job training in high tech industries\n\u2705improve support for homeless veterans\n\u2705modernize delivery of care\n\u2705cut red tape  \n\u2705hold the VA accountable. \n\nThis is a win for Utah's veterans.",
                "text_lang": "en",
                "text_tagged_users": null,
                "text_tagged_users_ids": null,
                "text_tags": null,
                "timestamp": 1732043592,
                "view_count": 572
