                "quoted_status_profile_username": null,
                "reply_count": 4643,
                "retweet_count": 3359,
                "source": "Twitter Web App",
                "text": "The Republicans' bottom line boils down to this: \n\nThey'll keep the federal government closed unless Democrats help Trump increase your health care premiums and kick millions off Medicaid.\n\nIt doesn't have to be like this, and it shouldn't.",
                "text_lang": "en",
                "text_tagged_users": null,
                "text_tagged_users_ids": null,
                "text_tags": null,
                "timestamp": 1759427793,
                "view_count": 434976
