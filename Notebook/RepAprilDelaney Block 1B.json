                "quoted_status_profile_username": null,
                "reply_count": 0,
                "retweet_count": 1,
                "source": "Twitter Web App",
                "text": "I\u2019m honored to share that $1 million in my requested Community Project Funding has been approved in the next federal funding package to improve radiation oncology services at Garrett Regional Medical Center. These funds will help build a radiation treatment facility, bringing lifesaving care closer to home for families in Garrett County and surrounding areas.\nRural communities face higher cancer rates and far fewer treatment options. I won\u2019t stand by while access to care is limited\u2014together, we can ease the physical, financial and emotional burdens that come with this devastating disease.",
                "text_lang": "en",
                "text_tagged_users": null,
                "text_tagged_users_ids": null,
                "text_tags": null,
                "timestamp": 1755811866,
                "view_count": 168
            },
