                "quoted_status_profile_username": null,
                "reply_count": 1,
                "retweet_count": 2,
                "source": "Twitter for iPhone",
                "text": "Under the Government Employment Fair Treatment Act, federal employees are guaranteed back pay at the end of any shutdown. That is the law and cannot be undone at the whim of this Executive Branch. I appreciate our civil servants who lift up in public service every day, and will fight to ensure that more than 35,000 government workers and active service members in Maryland\u2019s 6th District receive the retroactive pay they deserve.",
                "text_lang": "en",
                "text_tagged_users": null,
                "text_tagged_users_ids": null,
                "text_tags": null,
