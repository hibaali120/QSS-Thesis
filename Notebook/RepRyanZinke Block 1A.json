                "quoted_status_profile_username": null,
                "reply_count": 5,
                "retweet_count": 5,
                "source": "Twitter for iPhone",
                "text": "I met with Veterans Affairs Secretary Collins today to discuss the state of the VA in Montana and his vision for improving rural health delivery. I pressed the need for maintaining affordable access to air ambulance service, reducing wait times, expanding community care, and modernizing records. Our veterans deserve the best and fastest care available, and I believe in Secretary Collins to get the job done.",
                "text_lang": "en",
                "text_tagged_users": null,
                "text_tagged_users_ids": null,
                "text_tags": null,
                "timestamp": 1740525494,
                "view_count": 903
