                "quoted_status_profile_username": null,
                "reply_count": 7,
                "retweet_count": 8,
                "source": "Twitter for iPhone",
                "text": "The USPS decision to eliminate all expedited mail using air cargo in Montana will severely harm our community. Many Montanans have relied on expedited mail delivery for medication and commerce for decades. I am requesting a full delegation briefing from the USPS on this matter. Our rural way of life depends on a reliable and quick postal service and I urge the USPS to reconsider this decision.",
                "text_lang": "en",
                "text_tagged_users": null,
                "text_tagged_users_ids": null,
                "text_tags": null,
                "timestamp": 1721328672,
                "view_count": 1876
