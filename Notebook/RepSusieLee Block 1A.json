                "quoted_status_profile_username": null,
                "reply_count": 8,
                "retweet_count": 3,
                "source": "Twitter Web App",
                "text": "The President is saying affordability \u201cdoesn\u2019t mean anything to anybody.\u201d Well, Mr. President, it means something to me and my constituents:\n\n\ud83d\uded2Affordability means not needing to choose between buying groceries or health care.\n\u26a1Affordability means being able to heat your home without breaking the bank.\n\ud83e\uddd2Affordability means being able to get child care while you go to work.\n\nThis is what I\u2019m fighting for. But Republicans in Washington think it's a \u201ccon-job\u201d while they give billionaires tax breaks.",
                "text_lang": "en",
                "text_tagged_users": null,
                "text_tagged_users_ids": null,
                "text_tags": null,
                "timestamp": 1764802149,
                "view_count": 683
