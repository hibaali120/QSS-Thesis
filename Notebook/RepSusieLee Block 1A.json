                "quoted_status_profile_id": null,
                "quoted_status_profile_username": null,
                "reply_count": 19,
                "retweet_count": 2,
                "source": "Twitter for iPhone",
                "text": "BREAKING: With an average premium of $792, Nevada is facing the 6th-LARGEST increase in health care premiums in the country.\n\nNevadans will simply not be able to afford their health care if costs shoot up this high. I\u2019ve been fighting for MONTHS to extend the ACA Tax Credit and save health care for thousands of Nevadans. Congress must pass a deal to extend these credits before it\u2019s too late.",
                "text_lang": "en",
                "text_tagged_users": null,
                "text_tagged_users_ids": null,
                "text_tags": null,
                "timestamp": 1765304263,
                "view_count": 760
