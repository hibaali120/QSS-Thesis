                "quoted_status_profile_username": null,
                "reply_count": 17,
                "retweet_count": 1,
                "source": "Twitter for iPhone",
                "text": "I\u2019m ready to work with Republicans to save the ACA Tax Credit and prevent Nevadans\u2019 health care costs from doubling, tripling, and even quadrupling.\u00a0\n\nI won\u2019t allow my colleagues on the other side of the aisle to roll back protections for those with preexisting conditions and children up to the age of 26 who are on their parents\u2019 insurance. Nevadans need health care they can afford, not more cuts from Republicans in Washington.\u00a0\n\nhttps://t.co/IWkkZKGMN7",
                "text_lang": "en",
                "text_tagged_users": null,
                "text_tagged_users_ids": null,
                "text_tags": null,
