                "quoted_status_profile_username": null,
                "reply_count": 10,
                "retweet_count": 19,
                "source": "Twitter for iPhone",
                "text": "The Schumer Shutdown is putting families at risk and threatening access to affordable healthcare.\n\nFL-27 would be among the most affected districts in the nation because of the Democrats\u2019 political games. That\u2019s why I voted to keep the government open and co-sponsored H.R. 5145, a one-year extension to protect patients, taxpayers, and affordable care.\n\nIt\u2019s time for leadership, not politics, when Americans\u2019 health is on the line.",
                "text_lang": "en",
                "text_tagged_users": null,
                "text_tagged_users_ids": null,
                "text_tags": null,
                "timestamp": 1761148728,
                "view_count": 3522
