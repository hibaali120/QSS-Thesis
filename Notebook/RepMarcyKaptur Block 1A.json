                "attached_videos": null,
                "author_id": "581141508",
                "author_username": "RepMarcyKaptur",
                "community_notes": null,
                "conversation_id": "1986877831914127461",
                "created_time": "2025-11-07T19:26:04",
                "favorite_count": 19,
                "geo_lat": null,
                "geo_lon": null,
                "id": "1986877831914127461",
                "in_reply_to_post_id": null,
                "in_reply_to_profile_id": null,
                "in_reply_to_profile_username": null,
                "place_country_code": null,
                "place_country_name": null,
                "place_full_name": null,
                "place_type": null,
                "poll": null,
                "post_type": "post",
                "quote_count": 0,
                "quoted_status_id": null,
                "quoted_status_profile_id": null,
                "quoted_status_profile_username": null,
                "reply_count": 3,
                "retweet_count": 8,
                "source": "Twitter for iPhone",
                "text": "No parents should fear not being able to retire because DC Republicans refuse to extend health care assistance to those with disabilities and complex health needs. \n\nIf Congress doesn\u2019t act, families like this will face rising costs they simply cannot afford. \n\nThis is what we are fighting for.",
                "text_lang": "en",
                "text_tagged_users": null,
                "text_tagged_users_ids": null,
                "text_tags": null,
                "timestamp": 1762543564,
                "view_count": 740
            },
            {
                "attached_links_expanded_url": null,
                "attached_links_url": null,
                "attached_medias_preview_url": [
                    "https://pbs.twimg.com/media/G5SGQSOWwAAnHvX.jpg?name=small"
                ],
                "attached_medias_url": [
                    "https://pbs.twimg.com/media/G5SGQSOWwAAnHvX.jpg"
