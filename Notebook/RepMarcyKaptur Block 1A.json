                "quote_count": 15,
                "quoted_status_id": null,
                "quoted_status_profile_id": null,
                "quoted_status_profile_username": null,
                "reply_count": 203,
                "retweet_count": 80,
                "source": "Twitter for iPhone",
                "text": "We must protect health care because the GOP hasn\u2019t advanced a health care plan in more than a decade. Yet, come January 1st they would wipe out ACA support for over 185,000 across NW Ohio. https://t.co/pZLAm8VRY7",
                "text_lang": "en",
                "text_tagged_users": null,
                "text_tagged_users_ids": null,
                "text_tags": null,
                "timestamp": 1762658749,
                "view_count": 24967
            },
            {
                "attached_links_expanded_url": null,
                "attached_links_url": null,
                "attached_medias_preview_url": [
                    "https://pbs.twimg.com/media/G5WVo1VW0AAdyds.jpg?name=small"
                ],
                "attached_medias_url": [
                    "https://pbs.twimg.com/media/G5WVo1VW0AAdyds.jpg"
