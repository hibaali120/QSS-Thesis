                "quoted_status_profile_username": null,
                "reply_count": 1,
                "retweet_count": 3,
                "source": "Twitter for iPhone",
                "text": "Senate Republicans just moved one step closer to cutting health care for millions while ballooning the national debt.\n\nTheir bill \u2014 which will come back to the House if it passes \u2014 will gut Medicaid and SNAP, kill millions of jobs, shutter our local hospitals, reduce American energy independence, and harm working families across CA and the country. \n\nPlease join me in speaking out against this \u2014 it\u2019s not too late!",
                "text_lang": "en",
                "text_tagged_users": null,
                "text_tagged_users_ids": null,
                "text_tags": null,
                "timestamp": 1751215523,
                "view_count": 325
            },
