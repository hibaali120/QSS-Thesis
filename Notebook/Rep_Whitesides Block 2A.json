                "quoted_status_profile_username": null,
                "reply_count": 1,
                "retweet_count": 1,
                "source": "Twitter for iPhone",
                "text": "More than \u2153 of Californians are at risk of losing access to free or low-cost health coverage under the Budget Bill the Senate just passed \u2013 including kids, pregnant women, seniors, and people with disabilities.\u00a0\n\nThe proposed Medicaid cuts would mean higher out-of-pocket costs for millions, leaving families stuck choosing between getting the care they need and paying for rent, groceries, or other essentials.",
                "text_lang": "en",
                "text_tagged_users": null,
                "text_tagged_users_ids": null,
                "text_tags": null,
                "timestamp": 1751405211,
                "view_count": 269
            },
