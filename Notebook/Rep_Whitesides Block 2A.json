                "quoted_status_profile_username": null,
                "reply_count": 4,
                "retweet_count": 1,
                "source": "Twitter Web App",
                "text": "After the Rules Committee rejected my amendment to protect Medicaid, I proposed blocking cuts to Medicaid and SNAP on the House floor.\n\nExtreme Republicans in the House blocked it yet again, but I\u2019m keep fighting for my constituents who rely on these programs to receive health care and put food on the table.\n\nKeep making your voice heard! This bill will harm millions of Americans across the country!",
                "text_lang": "en",
                "text_tagged_users": null,
                "text_tagged_users_ids": null,
                "text_tags": null,
                "timestamp": 1751480823,
                "view_count": 731
