                "quoted_status_profile_username": null,
                "reply_count": 1,
                "retweet_count": 0,
                "source": "Twitter for iPhone",
                "text": "This week, nearly 10,000 of our neighbors will receive notices that their health care costs are going up. Families could be forced to choose between health insurance, paying their utility bills, or buying groceries. I'm dedicated to fixing this broken system and lowering health care costs for our community. https://t.co/7K000f7Jge",
                "text_lang": "en",
