                "quoted_status_profile_id": null,
                "quoted_status_profile_username": null,
                "reply_count": 1,
                "retweet_count": 1,
                "source": "Buffer",
                "text": "In uncertain times like these, investing in healthcare for Valley families and communities is essential. \n\nThat\u2019s why I was honored to celebrate the grand opening of the CRMC Burnett Extended Care Center. This vital investment brings quality care closer to home, expands access to new technologies and treatments, and creates opportunities to train the next generation of providers.",
                "text_lang": "en",
                "text_tagged_users": null,
                "text_tagged_users_ids": null,
                "text_tags": null,
                "timestamp": 1759608032,
                "view_count": 320
            },
            {
                "attached_links_expanded_url": null,
                "attached_links_url": null,
                "attached_medias_preview_url": [
                    "https://pbs.twimg.com/amplify_video_thumb/1975990841748619269/img/9VaOppm2vyK9QEeq.jpg?name=small"
