                "quoted_status_profile_id": null,
                "quoted_status_profile_username": null,
                "reply_count": 0,
                "retweet_count": 0,
                "source": "Twitter for iPhone",
                "text": "Republicans continue to refuse to work across the aisle, defending a bill that would raise health care costs for millions of Americans.\u00a0\n\u00a0\nIn my district alone, more than 65,000 people could lose their affordable healthcare coverage. This is just wrong, and it\u2019s why I\u2019m standing up for the people of our Valley.",
                "text_lang": "en",
                "text_tagged_users": null,
                "text_tagged_users_ids": null,
                "text_tags": null,
                "timestamp": 1759269439,
                "view_count": 243
            },
            {
                "attached_links_expanded_url": null,
                "attached_links_url": null,
                "attached_medias_preview_url": null,
                "attached_medias_url": null,
                "attached_videos": null,
                "author_id": "245451804",
                "author_username": "RepJimCosta",
                "community_notes": null,
                "conversation_id": "1973473800219140278",
                "created_time": "2025-10-01T19:43:13",
                "favorite_count": 1,
                "geo_lat": null,
                "geo_lon": null,
                "id": "1973473800219140278",
                "in_reply_to_post_id": null,
                "in_reply_to_profile_id": null,
                "in_reply_to_profile_username": null,
                "place_country_code": null,
                "place_country_name": null,
                "place_full_name": null,
                "place_type": null,
                "poll": null,
                "post_type": "post",
                "quote_count": 0,
                "quoted_status_id": null,
                "quoted_status_profile_id": null,
                "quoted_status_profile_username": null,
                "reply_count": 1,
                "retweet_count": 0,
                "source": "Twitter for iPhone",
                "text": "For weeks, Republicans have refused to work in a bipartisan way to responsibly fund our government and protect Americans\u2019 healthcare. \n\nInstead, they chose to shut our government down and reject the comprehensive plan put forward by Democrats. The people of the Valley, and communities across our nation deserve better.\n\nOur plan would prevent Republican healthcare tax hikes and require the Trump Administration to carry out the bipartisan budget that Congress passes, putting the people of the Valley and across our nation first.",
                "text_lang": "en",
                "text_tagged_users": null,
                "text_tagged_users_ids": null,
                "text_tags": null,
                "timestamp": 1759347793,
                "view_count": 257
            },
            {
                "attached_links_expanded_url": null,
                "attached_links_url": null,
                "attached_medias_preview_url": [
                    "https://pbs.twimg.com/media/G2cQrzJWcAAyvFa.jpg?name=small",
                    "https://pbs.twimg.com/media/G2cQsDAXgAEl8SC.jpg?name=small",
