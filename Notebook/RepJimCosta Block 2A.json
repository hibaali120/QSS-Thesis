                "quoted_status_profile_username": "HouseDemocrats",
                "reply_count": 1,
                "retweet_count": 0,
                "source": "Twitter for iPhone",
                "text": "This morning, I joined my Democratic colleagues on the Capitol steps to address the Republican healthcare crisis.\n\nWe are fighting to protect healthcare access, lower costs, and ensure every American receives the care they deserve. We must work together on a bipartisan path forward.",
                "text_lang": "en",
                "text_tagged_users": null,
                "text_tagged_users_ids": null,
                "text_tags": null,
                "timestamp": 1759251244,
                "view_count": 329
            },
            {
                "attached_links_expanded_url": null,
                "attached_links_url": null,
                "attached_medias_preview_url": [
                    "https://pbs.twimg.com/amplify_video_thumb/1973144937123422209/img/qs4EsZ1HoC85rNS5.jpg?name=small"
