                "quoted_status_profile_id": null,
                "quoted_status_profile_username": null,
                "reply_count": 1,
                "retweet_count": 0,
                "source": "Twitter for iPhone",
                "text": "All constituents indicated that their premiums had at least doubled. One constituent shared that his payment for a 2005 model car is $250, and his monthly healthcare premium increase is about three times his car payment. The new increase is the difference between him being able to replace his car or not.\u00a0He also shared that he is not saving money for his kids' college or for retirement. Another constituent said that her health insurance would go up to $27,000 a year, which, at her age, is a significant burden because she has a lot of expensive medications.",
                "text_lang": "en",
                "text_tagged_users": null,
                "text_tagged_users_ids": null,
                "text_tags": null,
                "timestamp": 1762382875,
                "view_count": 23
