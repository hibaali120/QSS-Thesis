                "quoted_status_profile_username": "latimes",
                "reply_count": 0,
                "retweet_count": 1,
                "source": "Twitter Web App",
                "text": "From Army Veteran to lawyer, the California Assembly, and to Congress, John Burton spent his life advocating for others. He fought to expand Medi-Cal coverage, led some of California\u2019s earliest efforts to regulate greenhouse gas emissions, and was a fierce defender of civil rights.\n\nHe was also a true California free spirit, and a prolific dropper of F-bombs.\n\nWe can all learn from John\u2019s unwavering commitment to progressive values. May his memory be a blessing, and may his family find comfort in knowing that so many of us considered him an inspiration.",
                "text_lang": "en",
                "text_tagged_users": null,
                "text_tagged_users_ids": null,
                "text_tags": null,
                "timestamp": 1757340758,
                "view_count": 374
