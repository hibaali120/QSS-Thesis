                "quoted_status_profile_username": null,
                "reply_count": 2,
                "retweet_count": 1,
                "source": "Twitter for iPhone",
                "text": "But instead of negotiating, @SpeakerJohnson has refused to bring Congress back in session for more than 30 days. While he extends vacations, I\u2019ll be back in D.C. pushing for action before families get priced out of coverage. (3/4)",
                "text_lang": "en",
