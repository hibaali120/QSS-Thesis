                "quoted_status_profile_username": "HouseGOP",
                "reply_count": 8,
                "retweet_count": 4,
                "source": "Twitter Web App",
                "text": "Today, the House passed the Lowering Health Care Premiums for All Americans Act. It\u2019s a step toward putting patients first, not big insurance companies.\n\nAmericans want lower premiums, more choice, and real transparency. This bill increases competition and brings sunlight to healthcare - the same commonsense approach behind my Patients Deserve Price Tags Act. \n\nWhen patients see prices upfront, costs come down.",
                "text_lang": "en",
                "text_tagged_users": null,
                "text_tagged_users_ids": null,
                "text_tags": null,
                "timestamp": 1766015001,
                "view_count": 1066
