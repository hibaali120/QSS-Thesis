                "quoted_status_profile_username": null,
                "reply_count": 3,
                "retweet_count": 8,
                "source": "Twitter Web App",
                "text": "Over the past 25 years, healthcare costs have surged 121% - far outpacing the 86% increase for all other consumer goods.\n\nMy Patients Deserve Price Tags Act brings competition back to healthcare by requiring hospitals & insurance companies to publish prices upfront. No more hidden costs or predatory pricing, just transparency.\n\nThis is commonsense reform that will deliver affordability & real choice for American families.",
                "text_lang": "en",
                "text_tagged_users": null,
                "text_tagged_users_ids": null,
                "text_tags": null,
