                "quoted_status_profile_username": null,
                "reply_count": 1,
                "retweet_count": 0,
                "source": "Twitter for iPhone",
                "text": "Health Connector navigators like AHEC West show up for our rural communities, fighting for health care access in Maryland\u2019s 6th and across Appalachia. With ACA premiums at risk of skyrocketing under a partisan CR, I spoke with AHEC West to hear their concerns about the future of health care and better understand the real, community impact behind the numbers. From Silver Loading to over-the-phone Medicaid Services, I will continue to fight for rural health care and this incredible community support, uplifting your stories and working to keep costs down.",
                "text_lang": "en",
                "text_tagged_users": null,
                "text_tagged_users_ids": null,
                "text_tags": null,
                "timestamp": 1761772425,
                "view_count": 173
