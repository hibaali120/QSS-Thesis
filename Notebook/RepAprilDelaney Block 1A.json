                "quoted_status_profile_username": null,
                "reply_count": 0,
                "retweet_count": 0,
                "source": "Twitter for iPhone",
                "text": "Health care is not a talking point \u2014 it\u2019s a lifeline. When federal funding for Medicaid and critical services are cut, or when ACA tax credits are not extended, the impact is staggeringly real. For example, a family of four in Garrett County, MD making $65,000 per year could see their premiums increase by 184% \u2014 a figure shocking in size, and even more heartbreaking in impact.",
                "text_lang": "en",
                "text_tagged_users": null,
                "text_tagged_users_ids": null,
                "text_tags": null,
