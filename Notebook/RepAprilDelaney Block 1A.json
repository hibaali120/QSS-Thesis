                "reply_count": 1,
                "retweet_count": 0,
                "source": "Twitter for iPhone",
                "text": "From food banks to health care centers, it has been my priority to hear directly from our communities to reopen our government the right way. What I heard? Americans can\u2019t afford this CR. The stakes are too high to cave.",
                "text_lang": "en",
                "text_tagged_users": null,
                "text_tagged_users_ids": null,
                "text_tags": null,
                "timestamp": 1762983881,
                "view_count": 191
            },
            {
                "attached_links_expanded_url": null,
