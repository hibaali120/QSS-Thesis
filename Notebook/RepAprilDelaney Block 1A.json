                "quoted_status_profile_username": null,
                "reply_count": 1,
                "retweet_count": 0,
                "source": "Twitter for iPhone",
                "text": "The Open Enrollment period has officially begun in every state, shining a light on the enormous hike in health care costs families will face without ACA tax credits.\u00a0\n\nMyself and my colleagues have worked tirelessly to change these numbers \u2014 the fight isn\u2019t over yet. For our country\u2019s health and wellbeing, I urge lawmakers across the aisle to take a step back and address this community cost. Now is the time to act.\n\nhttps://t.co/p16GEXSDsp",
                "text_lang": "en",
                "text_tagged_users": null,
                "text_tagged_users_ids": null,
                "text_tags": null,
                "timestamp": 1762036632,
