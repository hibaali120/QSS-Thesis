                "quoted_status_profile_username": null,
                "reply_count": 0,
                "retweet_count": 3,
                "source": "Twitter for iPhone",
                "text": "With ACA tax credits at risk and historic cuts to Medicaid impending, we must meet the needs of our healthcare workers to strengthen our hospitals and uplift their service. Today I toured classrooms, labs, and other facilities at @montgomerycoll Health Sciences Center and met with nursing students to discuss the needs of our healthcare workforce, present and future. I\u2019m bringing their priorities back to Washington to continue the fight \u2014 for our hospitals, the staff who keep them running, and the Maryland families whose care is on the line.",
                "text_lang": "en",
                "text_tagged_users": [
                    "montgomerycoll"
                ],
                "text_tagged_users_ids": [
                    "29475822"
                ],
                "text_tags": null,
