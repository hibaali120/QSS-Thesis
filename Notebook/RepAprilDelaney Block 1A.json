                "quoted_status_profile_username": null,
                "reply_count": 1,
                "retweet_count": 0,
                "source": "Twitter for iPhone",
                "text": "Keeping health care affordable isn\u2019t about partisanship \u2014 it\u2019s basic human dignity. If my GOP colleagues bothered to show up over the past 6 weeks, they\u2019d see that their vote on this CR will go far beyond a tally or press release \u2014 it will be seen in the wallets of hardworking families, in hospital rooms, and in the hardship that millions of Americans should not have to face.",
                "text_lang": "en",
                "text_tagged_users": null,
                "text_tagged_users_ids": null,
                "text_tags": null,
                "timestamp": 1762973818,
                "view_count": 167
            },
