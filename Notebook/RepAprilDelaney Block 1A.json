                "quoted_status_profile_username": null,
                "reply_count": 2,
                "retweet_count": 1,
                "source": "Twitter for iPhone",
                "text": "It\u2019s day 30 of the government shutdown \u2014 30 days of political gridlock halting crucial federal services and leaving government employees without pay. I\u2019m fighting in Washington to protect health care and reopen our government \u2014 it is high time for my colleagues across the aisle to do the same, negotiate in good faith, and end this shutdown.",
                "text_lang": "en",
                "text_tagged_users": null,
                "text_tagged_users_ids": null,
                "text_tags": null,
                "timestamp": 1761848271,
                "view_count": 231
