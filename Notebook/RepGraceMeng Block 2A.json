                "quoted_status_profile_username": null,
                "reply_count": 2,
                "retweet_count": 2,
                "source": "Twitter Web App",
                "text": "If ACA tax credits expire, families in Queens could pay thousands more for their health insurance.\n\nFor a family of four earning $64,000 a year, their annual premiums could increase by nearly $2,000.\n\nFor a 60-year-old couple earning $82,800 a year, their annual premiums could increase by more than $13,000.\n\nDemocrats are working to keep health care affordable and protect families from these cost increases.",
                "text_lang": "en",
                "text_tagged_users": null,
                "text_tagged_users_ids": null,
